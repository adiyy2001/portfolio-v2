---
import { link, portfolio } from '../../shared/link';
import FileTable from '../shared/FileTable.astro';
import LoopVideo from '../shared/LoopVideo.astro';
import SampleLine from '../shared/SampleLine.astro';
import Shell from '../shared/Shell.astro';
import Storyboard from '../shared/Storyboard.astro';
import { assetUrl, nb, presetValue, readManifest } from '../shared/manifest';
import DrawLab from './DrawLab.tsx';
import { app } from './app';
import { content, day } from './content';
import { bellPath, production } from './lab';
import { styles } from './styles';

const manifest = readManifest('poludnie');
const asset = (path: string) => assetUrl('poludnie', path);
const fontCss = manifest.fonts
  .map(
    font =>
      `@font-face{font-family:'Archivo';src:url(${asset(font.file)}) format('woff2');font-weight:100 900;font-stretch:62% 125%;font-style:normal;font-display:swap}`,
  )
  .join('');
const sections = [
  ['zadanie', 'Zadanie'],
  ['kierunek', 'Kierunek'],
  ['storyboard', 'Storyboard'],
  ['ruch', 'Ruch'],
  ['ekrany', 'Ekrany'],
  ['formaty', 'Formaty'],
  ['pliki', 'Pliki'],
] as const;
const pl = (text: string) =>
  nb(text)
    .replace(/(?<=^|[\s („])([aiouwzAIOUWZ]) /g, '$1 ')
    .replace(/(\d) (kWh|kWp|kW|W|dni|klatek|klatki|paneli|ujęć|lat)(?=$|[\s,.;:)])/g, '$1 $2');
const dec = (value: number, digits = 1) => value.toFixed(digits).replace('.', ',');
const ratio = (value: number) => value.toFixed(1).replace('.', ',');
const on = (id: string, where: 'onSurface' | 'onGrouped') =>
  manifest.palette.find(item => item.id === id)?.[where] ?? 0;
const hues: Record<string, string> = {
  sun: 'var(--sun)',
  battery: 'var(--bat)',
  home: 'var(--home)',
  grid: 'var(--grid)',
};
const weights = [
  [800, 75, '47,8 kWh · 92%', 'ExtraBold 800, szerokość 75: duże liczby'],
  [700, 100, 'Kiedy włączyć pralkę', 'Bold 700: tytuły ekranów'],
  [600, 87.5, 'Magazyn, pełny o 13:40', 'SemiBold 600, szerokość 87,5: etykiety i przyciski'],
  [
    400,
    100,
    'Zażółć gęślą jaźń, nadwyżka z dachu 4,1 kW',
    'Regular 400 i Medium 500: tekst i opisy',
  ],
] as const;
const chartW = 340;
const chartH = 120;
const bell = bellPath(chartW, chartH);
const peakX = ((13 + 10 / 60) / 24) * chartW;
const peakY = chartH - (production(13 + 10 / 60) / 7) * chartH;
---

<Shell
  app={app}
  title="App preview aplikacji do fotowoltaiki z magazynem energii"
  description="Izometryczny dashboard danych w ruchu: podgląd zmyślonej aplikacji Południe do domowej fotowoltaiki z magazynem energii. Wersja do App Store, trzy formaty social, pętle na stronę, storyboard i zasady ruchu z laboratorium rysowania."
  css={fontCss + styles}
  preload={manifest.fonts.map(font => asset(font.file))}
  bodyClass="pd">
  <header class="top">
    <a href={link('/app-preview/')}>Wzornik, app preview</a>
    <a href={portfolio('/dla-klienta/#wzornik')}>Wróć do portfolio</a>
  </header>

  <main id="main" tabindex="-1">
    <section class="hero" aria-labelledby="t-hero">
      <div class="hero__grid">
        <div>
          <p class="kicker">{content.kicker}</p>
          <div class="brand">
            <img src={asset(manifest.icons.rounded)} alt="" width="512" height="512" />
            <h1 id="t-hero">Południe</h1>
          </div>
          <p class="lead">{pl(content.lead)}</p>
          <dl class="rows">
            {content.facts.map(([term, value]) => (
              <div>
                <dt>{term}</dt>
                <dd>{pl(value)}</dd>
              </div>
            ))}
          </dl>
          <nav class="toc" aria-label="Sekcje">
            {sections.map(([id, label]) => (
              <a href={`#${id}`}>{label}</a>
            ))}
          </nav>
        </div>
        <figure class="hero__media">
          <div class="stage stage--hero">
            <LoopVideo
              manifest={manifest}
              variant="hero"
              class="hero__wide"
              label="Wersja marketingowa 16:9: izometryczny dom z panelami i magazynem, przewód z prądem prowadzący do telefonu z aplikacją Południe i nagłówki pięciu ujęć"
            />
            <LoopVideo
              manifest={manifest}
              variant="hero-9x16"
              class="hero__tall"
              label="Wersja marketingowa 9:16: nagłówek, izometryczny dom i telefon z aplikacją Południe"
            />
          </div>
          <figcaption>{content.heroCaption}</figcaption>
        </figure>
      </div>
    </section>

    <section class="sec" id="zadanie" aria-labelledby="t-zadanie">
      <div class="sec__head">
        <p class="sec__num">01 Klient i zadanie</p>
        <h2 id="t-zadanie">{content.client.title}</h2>
      </div>
      <div class="cols">
        <div>
          <div class="prose">
            {content.client.paragraphs.map(text => (
              <p>{pl(text)}</p>
            ))}
          </div>
          <dl class="rows rows--stack" style="margin-top:24px">
            {content.client.facts.map(([term, value]) => (
              <div>
                <dt>{term}</dt>
                <dd>{pl(value)}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div class="card ledger" data-draw aria-label="Bilans przykładowego dnia">
          <p class="ledger__label">{day.date}</p>
          <p class="ledger__title">Energia z dachu: {dec(day.prod)}&nbsp;kWh</p>
          <svg
            class="ledger__chart"
            viewBox={`-30 -14 ${chartW + 44} ${chartH + 36}`}
            role="img"
            aria-label="Krzywa produkcji w ciągu dnia ze szczytem 6,4 kW o 13:10">
            {[0, 2, 4, 6].map(v => (
              <g>
                <line
                  class="axis"
                  x1="0"
                  x2={chartW}
                  y1={chartH - (v / 7) * chartH}
                  y2={chartH - (v / 7) * chartH}
                />
                <text x="-8" y={chartH - (v / 7) * chartH + 4} text-anchor="end">
                  {v}
                </text>
              </g>
            ))}
            {[0, 6, 12, 18, 24].map(h => (
              <text x={(h / 24) * chartW} y={chartH + 18} text-anchor="middle">
                {`${h}:00`}
              </text>
            ))}
            <path class="fill" d={`${bell} L${chartW} ${chartH} L0 ${chartH} Z`} />
            <path class="line" d={bell} pathLength="1" />
            <circle class="peak" cx={peakX} cy={peakY} r="5" />
            <text class="peak-label" x={peakX + 10} y={peakY - 2}>
              6,4 kW o 13:10
            </text>
          </svg>
          {[
            ['Dokąd poszła energia z dachu', day.prod, day.prodSplit],
            ['Skąd przyszła energia w domu', day.use, day.useSplit],
          ].map(([title, total, parts]) => (
            <div class="split">
              <div class="split__head">
                <span>{title as string}</span>
                <span class="num">{dec(total as number)} kWh</span>
              </div>
              <div class="bar" aria-hidden="true">
                {(parts as [string, number, string][]).map(([, value, hue]) => (
                  <span style={`flex:${value};--c:${hues[hue]}`} />
                ))}
              </div>
              <p class="split__legend">
                {(parts as [string, number, string][]).map(([name, value, hue]) => (
                  <span style={`--c:${hues[hue]}`}>
                    <i />
                    <b>{dec(value)}</b> {name}
                  </span>
                ))}
              </p>
            </div>
          ))}
          <p class="sum">
            <b>{day.selfSufficiency}% samowystarczalności</b>, wartość dnia{' '}
            <b>{dec(day.valueZl, 2)}&nbsp;zł</b>: {dec(day.notBought)}&nbsp;kWh nie kupione po{' '}
            {dec(day.buy, 2)}&nbsp;zł i {dec(day.exported)}&nbsp;kWh sprzedane po {dec(day.sell, 2)}
            &nbsp;zł. Ceny przykładowe.
          </p>
        </div>
      </div>
    </section>

    <section class="sec" id="kierunek" aria-labelledby="t-kierunek">
      <div class="sec__head">
        <p class="sec__num" style="--dot:var(--bat)">
          02 Kierunek
        </p>
        <h2 id="t-kierunek">{content.direction.title}</h2>
      </div>
      <div class="cols">
        <div>
          <div class="prose">
            {content.direction.paragraphs.map(text => (
              <p>{pl(text)}</p>
            ))}
          </div>
          <ul class="chips">
            {content.direction.keywords.map(word => (
              <li>{word}</li>
            ))}
          </ul>
        </div>
        <div class="card type" aria-label="Krój Archivo w kilku odmianach">
          <h3>Archivo, jeden plik zmienny, OFL</h3>
          {weights.map(([weight, width, sample, use]) => (
            <div class="type__row">
              <p
                style={`font-weight:${weight};font-stretch:${width}%;font-size:${weight === 800 ? 40 : 21}px`}>
                {pl(sample)}
              </p>
              <small>{use}</small>
            </div>
          ))}
        </div>
      </div>
      <div class="card" style="margin-top:24px">
        <h3>Siedemnaście kolorów, cztery dla danych</h3>
        <ul class="swatches">
          {manifest.palette.map(item => (
            <li class="swatch">
              <span class="swatch__chip" style={`background:${item.hex}`} />
              <b>{item.name}</b>
              <span>{item.hex.toUpperCase()}</span>
              <span>{item.role}</span>
            </li>
          ))}
        </ul>
        <p class="contrast">
          Kontrast na bieli: grafit {ratio(on('ink', 'onSurface'))}:1, łupek{' '}
          {ratio(on('secondary', 'onSurface'))}:1, słońce w wersji tekstowej{' '}
          {ratio(on('sunText', 'onSurface'))}:1, magazyn {ratio(on('batteryText', 'onSurface'))}:1,
          dom {ratio(on('home', 'onSurface'))}:1, sieć {ratio(on('gridText', 'onSurface'))}:1. Jasne
          słońce i jasna zieleń nigdy nie niosą tekstu, tylko linie, kreski i wypełnienia obok
          podpisanej liczby.
        </p>
      </div>
    </section>

    <section class="sec" id="storyboard" aria-labelledby="t-storyboard">
      <div class="sec__head">
        <p class="sec__num">03 Storyboard</p>
        <h2 id="t-storyboard">{content.storyboard.title}</h2>
        <p class="intro">{pl(content.storyboard.intro)}</p>
      </div>
      <ul class="list">
        {content.storyboard.rules.map(rule => (
          <li>{pl(rule)}</li>
        ))}
      </ul>
      <Storyboard manifest={manifest} alt={content.storyboard.alt} />
    </section>

    <section class="sec" id="ruch" aria-labelledby="t-ruch">
      <div class="sec__head">
        <p class="sec__num" style="--dot:var(--home)">
          04 Zasady ruchu
        </p>
        <h2 id="t-ruch">{content.motion.title}</h2>
        <p class="intro">{pl(content.motion.intro)}</p>
      </div>
      <DrawLab client:visible total={day.prod} caption={pl(content.motion.caption)} />
      <div class="cols" style="margin-top:28px">
        <dl class="presets">
          {manifest.motion.map(preset => (
            <div>
              <dt>
                {preset.id} <span>· {preset.use}</span>
              </dt>
              <dd>
                <code>{presetValue(preset)}</code>
              </dd>
              <dd>{pl(preset.note)}</dd>
            </div>
          ))}
        </dl>
        <dl class="rows rows--stack">
          {content.motion.rules.map(([term, value]) => (
            <div>
              <dt>{term}</dt>
              <dd>{pl(value)}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="sec" id="ekrany" aria-labelledby="t-ekrany">
      <div class="sec__head">
        <p class="sec__num" style="--dot:var(--bat)">
          05 Ekrany
        </p>
        <h2 id="t-ekrany">{content.screens.title}</h2>
        <p class="intro">{pl(content.screens.intro)}</p>
      </div>
      <div class="gallery">
        {manifest.gallery.map(item => (
          <figure>
            <img
              src={asset(item.file)}
              alt={`Ekran ${item.title}`}
              width="443"
              height="960"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <b>
                {item.n}. {item.title}
              </b>
              <span>{pl(item.caption)}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="sec" id="formaty" aria-labelledby="t-formaty">
      <div class="sec__head">
        <p class="sec__num" style="--dot:var(--home)">
          06 Wersja sklepowa i formaty
        </p>
        <h2 id="t-formaty">{content.formats.title}</h2>
        <p class="intro">{pl(content.formats.intro)}</p>
      </div>
      <div class="formats">
        <figure>
          <div class="stage">
            <LoopVideo
              manifest={manifest}
              variant="store"
              label="Wersja sklepowa: sam interfejs Południa na pełnym ekranie"
            />
          </div>
          <figcaption>
            <b>{content.formats.store}</b>886×1920, 25 s, H.264
          </figcaption>
        </figure>
        <figure>
          <div class="stage">
            <LoopVideo
              manifest={manifest}
              variant="hero-9x16"
              label="Wersja 9:16 z nagłówkiem, izometrycznym domem i telefonem"
            />
          </div>
          <figcaption>
            <b>{content.formats.portrait}</b>1080×1920, 26,5 s
          </figcaption>
        </figure>
        <div class="fmt--wide">
          <figure>
            <div class="stage">
              <LoopVideo
                manifest={manifest}
                variant="social-1x1"
                label="Wersja kwadratowa z domem pośrodku i telefonem w prawym dolnym rogu"
              />
            </div>
            <figcaption>
              <b>{content.formats.square}</b>1080×1080, 26,5 s
            </figcaption>
          </figure>
          <figure>
            <div class="stage">
              <LoopVideo
                manifest={manifest}
                variant="hero"
                label="Wersja 16:9 z nagłówkiem po lewej, domem pośrodku i telefonem po prawej"
              />
            </div>
            <figcaption>
              <b>{content.formats.wide}</b>1920×1080, 26,5 s
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="sec" id="pliki" aria-labelledby="t-pliki">
      <div class="sec__head">
        <p class="sec__num" style="--dot:var(--grid)">
          07 Co dostaje klient
        </p>
        <h2 id="t-pliki">{content.deliverables.title}</h2>
        <p class="intro">{pl(content.deliverables.intro)}</p>
      </div>
      <FileTable manifest={manifest} />
      <dl class="rows rows--stack" style="margin-top:20px">
        {content.deliverables.extras.map(([term, value]) => (
          <div>
            <dt>{term}</dt>
            <dd>{pl(value)}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="cta" aria-labelledby="t-cta">
      <h2 id="t-cta">{content.cta.title}</h2>
      <p>{pl(content.cta.text)}</p>
      <a href={portfolio('/dla-klienta/#wzornik')}>{content.cta.link}</a>
    </section>
  </main>

  <footer class="foot">
    <SampleLine name="Południe" />
  </footer>
</Shell>

<script>
  document.documentElement.classList.add('pd-js');
  const targets = [...document.querySelectorAll<HTMLElement>('[data-draw]')];
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduced || !('IntersectionObserver' in window)) {
    for (const el of targets) el.classList.add('is-in');
  } else {
    const observer = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.35 },
    );
    for (const el of targets) observer.observe(el);
  }
</script>
