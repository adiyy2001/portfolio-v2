---
import { link, portfolio } from '../../shared/link';
import FileTable from '../shared/FileTable.astro';
import LoopVideo from '../shared/LoopVideo.astro';
import SampleLine from '../shared/SampleLine.astro';
import Shell from '../shared/Shell.astro';
import Storyboard from '../shared/Storyboard.astro';
import { assetUrl, nb, presetValue, readManifest } from '../shared/manifest';
import type { SpringPreset } from '../shared/types';
import DropLab from './DropLab.tsx';
import { app } from './app';
import { content } from './content';
import { styles } from './styles';

const manifest = readManifest('kielek');
const asset = (path: string) => assetUrl('kielek', path);
const fontCss = manifest.fonts
  .map(
    font =>
      `@font-face{font-family:'M PLUS Rounded 1c';src:url(${asset(font.file)}) format('woff2');font-weight:${font.weight};font-style:normal;font-display:swap}`,
  )
  .join('');
const bounce = manifest.motion.find(item => item.id === 'bounce') as SpringPreset;
const sections = [
  ['zadanie', 'Zadanie'],
  ['kierunek', 'Kierunek'],
  ['storyboard', 'Storyboard'],
  ['ruch', 'Ruch'],
  ['ekrany', 'Ekrany'],
  ['formaty', 'Formaty'],
  ['pliki', 'Pliki'],
] as const;
const pl = (text: string) =>
  nb(text)
    .replace(/(?<=^|[\s („])([aiouwzAIOUWZ]) /g, '$1 ')
    .replace(/(\d) (dni|klatek|klatki|roślin|rośliny|pikseli)/g, '$1\u00a0$2');
const ratio = (value: number) => value.toFixed(1).replace('.', ',');
const onGround = (id: string) => manifest.palette.find(item => item.id === id)?.onGrouped ?? 0;
const onCard = (id: string) => manifest.palette.find(item => item.id === id)?.onSurface ?? 0;
const weights = [
  [900, 'Dziś podlej 3 rośliny', 'Black 900: tytuły, liczby i nazwa'],
  [800, 'Żółte dolne liście', 'ExtraBold 800: chipy, przyciski i etykiety'],
  [500, 'Zażółć gęślą jaźń, 400 ml co 7 dni', 'Medium 500: tekst i objaśnienia'],
] as const;
---

<Shell
  app={app}
  title="App preview aplikacji do pielęgnacji roślin"
  description="Pastelowy claymorphism w ruchu: podgląd zmyślonej aplikacji Kiełek do pielęgnacji roślin domowych. Wersja do App Store, trzy formaty social, pętle na stronę, storyboard i zasady ruchu z laboratorium kropli."
  css={fontCss + styles}
  preload={manifest.fonts.filter(font => font.weight !== '500').map(font => asset(font.file))}
  bodyClass="kie">
  <header class="top">
    <a href={link('/app-preview/')}>Wzornik, app preview</a>
    <a href={portfolio('/dla-klienta/#wzornik')}>Wróć do portfolio</a>
  </header>

  <main id="main" tabindex="-1">
    <section class="hero" aria-labelledby="t-hero">
      <div class="hero__grid">
        <div>
          <p class="kicker">{content.kicker}</p>
          <div class="brand">
            <img src={asset(manifest.icons.rounded)} alt="" width="512" height="512" />
            <h1 id="t-hero">Kiełek</h1>
          </div>
          <p class="lead">{pl(content.lead)}</p>
          <dl class="rows">
            {content.facts.map(([term, value]) => (
              <div>
                <dt>{term}</dt>
                <dd>{pl(value)}</dd>
              </div>
            ))}
          </dl>
          <nav class="toc" aria-label="Sekcje">
            {sections.map(([id, label]) => (
              <a href={`#${id}`}>{label}</a>
            ))}
          </nav>
        </div>
        <figure class="hero__media">
          <div class="stage stage--hero">
            <LoopVideo
              manifest={manifest}
              variant="hero"
              class="hero__wide"
              label="Wersja marketingowa 16:9: różowy telefon z aplikacją Kiełek, unoszące się doniczki i krople oraz nagłówki czterech funkcji"
            />
            <LoopVideo
              manifest={manifest}
              variant="hero-9x16"
              class="hero__tall"
              label="Wersja marketingowa 9:16: nagłówek nad różowym telefonem z aplikacją Kiełek"
            />
          </div>
          <figcaption>{content.heroCaption}</figcaption>
        </figure>
      </div>
    </section>

    <section class="sec" id="zadanie" aria-labelledby="t-zadanie">
      <div class="sec__head">
        <p class="sec__num">01 Klient i zadanie</p>
        <h2 id="t-zadanie">{content.client.title}</h2>
      </div>
      <div class="cols">
        <div>
          <div class="prose">
            {content.client.paragraphs.map(text => (
              <p>{pl(text)}</p>
            ))}
          </div>
          <dl class="rows rows--stack" style="margin-top:24px">
            {content.client.facts.map(([term, value]) => (
              <div>
                <dt>{term}</dt>
                <dd>{pl(value)}</dd>
              </div>
            ))}
          </dl>
        </div>
        <div class="card card--butter plan" aria-label="Przykładowy plan podlewania na dziś">
          <p class="plan__label">{content.client.plan.label}</p>
          <p class="plan__title">{content.client.plan.title}</p>
          <ul>
            {content.client.plan.rows.map(([name, kind, ml]) => (
              <li>
                <span>
                  <b>{name}</b>
                  <small>{kind}</small>
                </span>
                <span class="pill">{nb(ml)}</span>
              </li>
            ))}
          </ul>
          <p class="plan__total">{nb(content.client.plan.total)}</p>
        </div>
      </div>
    </section>

    <section class="sec" id="kierunek" aria-labelledby="t-kierunek">
      <div class="sec__head">
        <p class="sec__num">02 Kierunek</p>
        <h2 id="t-kierunek">{content.direction.title}</h2>
      </div>
      <div class="cols">
        <div>
          <div class="prose">
            {content.direction.paragraphs.map(text => (
              <p>{pl(text)}</p>
            ))}
          </div>
          <ul class="chips">
            {content.direction.keywords.map(word => (
              <li>{word}</li>
            ))}
          </ul>
        </div>
        <div class="card type" aria-label="Krój M PLUS Rounded 1c w trzech wagach">
          <h3>{'M\u00a0PLUS Rounded\u00a01c, trzy wagi, OFL'}</h3>
          {weights.map(([weight, sample, use]) => (
            <div class="type__row">
              <p style={`font-weight:${weight};font-size:${weight === 900 ? 30 : 20}px`}>
                {pl(sample)}
              </p>
              <small>{use}</small>
            </div>
          ))}
        </div>
      </div>
      <div class="card" style="margin-top:24px">
        <h3>Dziesięć kolorów, wszystkie ciepłe</h3>
        <ul class="swatches">
          {manifest.palette.map(item => (
            <li class="swatch">
              <span class="swatch__chip" style={`background:${item.hex}`} />
              <b>{item.name}</b>
              <span>{item.hex.toUpperCase()}</span>
              <span>{item.role}</span>
            </li>
          ))}
        </ul>
        <p class="contrast">
          Kontrast: śliwkowy brąz na brzoskwini {ratio(onGround('ink'))}:1, na śmietance{' '}
          {ratio(onCard('ink'))}:1. Brąz łagodny na brzoskwini {ratio(onGround('inkSoft'))}:1, na
          śmietance {ratio(onCard('inkSoft'))}:1. Na pistacji i różu tekst jest zawsze śliwkowy, a
          liść i terakota służą tylko do rysunku.
        </p>
      </div>
    </section>

    <section class="sec" id="storyboard" aria-labelledby="t-storyboard">
      <div class="sec__head">
        <p class="sec__num">03 Storyboard</p>
        <h2 id="t-storyboard">{content.storyboard.title}</h2>
        <p class="intro">{pl(content.storyboard.intro)}</p>
      </div>
      <ul class="list">
        {content.storyboard.rules.map(rule => (
          <li>{pl(rule)}</li>
        ))}
      </ul>
      <Storyboard manifest={manifest} alt={content.storyboard.alt} />
    </section>

    <section class="sec" id="ruch" aria-labelledby="t-ruch">
      <div class="sec__head">
        <p class="sec__num">04 Zasady ruchu</p>
        <h2 id="t-ruch">{content.motion.title}</h2>
        <p class="intro">{pl(content.motion.intro)}</p>
      </div>
      <DropLab
        client:visible
        bounce={{ mass: bounce.mass, stiffness: bounce.stiffness, damping: bounce.damping }}
        stiff={{ mass: 1, stiffness: 260, damping: 34 }}
        caption={pl(content.motion.caption)}
      />
      <div class="cols" style="margin-top:28px">
        <dl class="presets">
          {manifest.motion.map(preset => (
            <div>
              <dt>
                {preset.id} <span>· {preset.use}</span>
              </dt>
              <dd>
                <code>{presetValue(preset)}</code>
              </dd>
              <dd>{pl(preset.note)}</dd>
            </div>
          ))}
        </dl>
        <dl class="rows rows--stack">
          {content.motion.rules.map(([term, value]) => (
            <div>
              <dt>{term}</dt>
              <dd>{pl(value)}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="sec" id="ekrany" aria-labelledby="t-ekrany">
      <div class="sec__head">
        <p class="sec__num">05 Ekrany</p>
        <h2 id="t-ekrany">{content.screens.title}</h2>
        <p class="intro">{pl(content.screens.intro)}</p>
      </div>
      <div class="gallery">
        {manifest.gallery.map(item => (
          <figure>
            <img
              src={asset(item.file)}
              alt={`Ekran ${item.title}`}
              width="443"
              height="960"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <b>
                {item.n}. {item.title}
              </b>
              <span>{pl(item.caption)}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="sec" id="formaty" aria-labelledby="t-formaty">
      <div class="sec__head">
        <p class="sec__num">06 Wersja sklepowa i formaty</p>
        <h2 id="t-formaty">{content.formats.title}</h2>
        <p class="intro">{pl(content.formats.intro)}</p>
      </div>
      <div class="formats">
        <figure>
          <div class="stage">
            <LoopVideo
              manifest={manifest}
              variant="store"
              label="Wersja sklepowa: sam interfejs Kiełka na pełnym ekranie"
            />
          </div>
          <figcaption>
            <b>{content.formats.store}</b>886×1920, 21 s, H.264
          </figcaption>
        </figure>
        <figure>
          <div class="stage">
            <LoopVideo
              manifest={manifest}
              variant="hero-9x16"
              label="Wersja 9:16 z nagłówkiem nad różowym telefonem"
            />
          </div>
          <figcaption>
            <b>{content.formats.portrait}</b>1080×1920, 21 s
          </figcaption>
        </figure>
        <div class="fmt--wide">
          <figure>
            <div class="stage">
              <LoopVideo
                manifest={manifest}
                variant="social-1x1"
                label="Wersja kwadratowa z nagłówkiem nad telefonem i Kiełkiem na jego krawędzi"
              />
            </div>
            <figcaption>
              <b>{content.formats.square}</b>1080×1080, 21 s
            </figcaption>
          </figure>
          <figure>
            <div class="stage">
              <LoopVideo
                manifest={manifest}
                variant="hero"
                label="Wersja 16:9 z telefonem po lewej i nagłówkiem po prawej"
              />
            </div>
            <figcaption>
              <b>{content.formats.wide}</b>1920×1080, 21 s
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="sec" id="pliki" aria-labelledby="t-pliki">
      <div class="sec__head">
        <p class="sec__num">07 Co dostaje klient</p>
        <h2 id="t-pliki">{content.deliverables.title}</h2>
        <p class="intro">{pl(content.deliverables.intro)}</p>
      </div>
      <FileTable manifest={manifest} />
      <dl class="rows rows--stack" style="margin-top:20px">
        {content.deliverables.extras.map(([term, value]) => (
          <div>
            <dt>{term}</dt>
            <dd>{pl(value)}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="cta" aria-labelledby="t-cta">
      <h2 id="t-cta">{content.cta.title}</h2>
      <p>{pl(content.cta.text)}</p>
      <a href={portfolio('/dla-klienta/#wzornik')}>{content.cta.link}</a>
    </section>
  </main>

  <footer class="foot">
    <SampleLine name="Kiełek" />
  </footer>
</Shell>
