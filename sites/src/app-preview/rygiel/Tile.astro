---
import LoopVideo from '../shared/LoopVideo.astro';
import { previewApp } from '../shared/apps';
import { readManifest } from '../shared/manifest';

interface Props {
  href: string;
}

const { href } = Astro.props;
const meta = previewApp('rygiel');
const manifest = readManifest('rygiel');
---

<a class="ryg-tile" href={href}>
  <span class="ryg-tile__media">
    <LoopVideo
      manifest={manifest}
      variant="tile"
      mode="hover"
      label="Pętla: linia skanu przechodzi przez alert o wycieku, potem nowe hasło odszyfrowuje się znak po znaku"
    />
  </span>
  <span class="ryg-tile__body">
    <span class="ryg-tile__style">
      {meta.styleId}, {meta.style}
    </span>
    <span class="ryg-tile__name">{meta.name}</span>
    <span class="ryg-tile__trade">
      {meta.trade}, {meta.city}
    </span>
    <span class="ryg-tile__go">Zobacz realizację</span>
  </span>
</a>

<style is:global>
  .ryg-tile {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    height: 100%;
    color: #d9fbff;
    background: #05070b;
    overflow: hidden;
    text-decoration: none;
    font-family: 'Schibsted Grotesk', system-ui, Arial, sans-serif;
    box-shadow: inset 0 0 0 1px #1d4a57;
  }

  .ryg-tile__media video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 30%;
    background: #05070b;
  }

  .ryg-tile__body {
    display: grid;
    gap: 4px;
    padding: 18px 22px 22px;
    border-top: 1px solid #1d4a57;
  }

  .ryg-tile__style {
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #7fa6b0;
    font-weight: 600;
  }

  .ryg-tile__name {
    font-size: 34px;
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ryg-tile__trade {
    font-size: 15px;
    color: #7fa6b0;
  }

  .ryg-tile__go {
    margin-top: 8px;
    font-weight: 600;
    color: #2cf6ff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .ryg-tile:hover .ryg-tile__go,
  .ryg-tile:focus-visible .ryg-tile__go {
    color: #d9fbff;
  }
</style>
