---
interface Props {
  id: string;
  text: string;
  level?: 'h2' | 'h3';
  class?: string;
}

const { id, text, level = 'h2', class: className } = Astro.props;
const Tag = level;
---

<Tag id={id} class:list={['scr', className]}>
  <span class="sr-only">{text}</span>
  <span aria-hidden="true" data-scramble>
    {text}
  </span>
</Tag>
