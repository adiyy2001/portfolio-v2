---
import LoopVideo from '../shared/LoopVideo.astro';
import { previewApp } from '../shared/apps';
import { readManifest } from '../shared/manifest';

interface Props {
  href: string;
}

const { href } = Astro.props;
const meta = previewApp('sztanga');
const manifest = readManifest('sztanga');
---

<a class="szt-tile" href={href}>
  <span class="szt-tile__media">
    <LoopVideo
      manifest={manifest}
      variant="tile"
      mode="hover"
      label="Pętla: liczba 140 zmienia szerokość na każde uderzenie"
    />
  </span>
  <span class="szt-tile__body">
    <span class="szt-tile__style">
      {meta.styleId}, {meta.style}
    </span>
    <span class="szt-tile__name">{meta.name}</span>
    <span class="szt-tile__trade">
      {meta.trade}, {meta.city}
    </span>
    <span class="szt-tile__go">Zobacz realizację</span>
  </span>
</a>

<style is:global>
  .szt-tile {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    height: 100%;
    color: #ffffff;
    background: #000000;
    overflow: hidden;
    text-decoration: none;
    font-family: 'Schibsted Grotesk', system-ui, Arial, sans-serif;
  }

  .szt-tile__media video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 52%;
    background: #000000;
  }

  .szt-tile__body {
    display: grid;
    gap: 4px;
    padding: 18px 22px 22px;
    border-top: 2px solid #2a2a2a;
  }

  .szt-tile__style {
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #8c8c8c;
    font-weight: 600;
  }

  .szt-tile__name {
    font-size: 34px;
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .szt-tile__trade {
    font-size: 15px;
    color: #8c8c8c;
  }

  .szt-tile__go {
    margin-top: 8px;
    font-weight: 600;
    color: #ff5a00;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .szt-tile:hover .szt-tile__go,
  .szt-tile:focus-visible .szt-tile__go {
    color: #ffffff;
  }
</style>
