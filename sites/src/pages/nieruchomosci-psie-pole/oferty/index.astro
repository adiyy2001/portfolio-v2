---
import Layout from '../../../sites/nieruchomosci-psie-pole/Layout.astro';
import PageHead from '../../../sites/nieruchomosci-psie-pole/components/PageHead.astro';
import { figures } from '../../../sites/nieruchomosci-psie-pole/data/business';
import OffersBrowser from '../../../sites/nieruchomosci-psie-pole/islands/OffersBrowser';
---

<Layout
  title="Oferty mieszkań we Wrocławiu"
  description="Sześć mieszkań z numeru 11 magazynu ofert: Psie Pole, Leśnica, Karłowice i Dąbie. Filtruj po pokojach, osiedlu i cenie, sortuj po cenie i metrażu."
  path="/nieruchomosci-psie-pole/oferty/"
  current="oferty"
  bundles={['catalog']}>
  <PageHead
    kicker="Numer 11, listopad 2026"
    title="Oferty z tego numeru"
    lead="Sześć mieszkań z czterech osiedli. Każde ma własną stronę ze zdjęciem, opisem i telefonem do agenta, który je prowadzi."
  />
  <section class="sec sec-match sec-match--page" aria-labelledby="list-h">
    <h2 class="vh" id="list-h">
      Lista ofert
    </h2>
    <OffersBrowser client:load sortable />
    <p class="fine-print">
      Kupujący nie płaci nam prowizji. Sprzedający płaci {figures.commissionPercent}% ceny sprzedaży
      plus VAT, dopiero przy akcie notarialnym.
    </p>
  </section>
</Layout>
