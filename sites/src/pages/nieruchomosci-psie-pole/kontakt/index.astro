---
import Layout from '../../../sites/nieruchomosci-psie-pole/Layout.astro';
import PageHead from '../../../sites/nieruchomosci-psie-pole/components/PageHead.astro';
import { agentList } from '../../../sites/nieruchomosci-psie-pole/data/agents';
import { business, openingDays } from '../../../sites/nieruchomosci-psie-pole/data/business';
import ContactForm from '../../../sites/nieruchomosci-psie-pole/islands/ContactForm';
---

<Layout
  title="Kontakt z biurem"
  description="Biuro nieruchomości przy ul. Bolesława Krzywoustego 313 na Psim Polu we Wrocławiu. Godziny otwarcia, telefony agentów i formularz kontaktowy."
  path="/nieruchomosci-psie-pole/kontakt/"
  current="kontakt"
  bundles={['info']}>
  <PageHead
    kicker="Biuro na Psim Polu"
    title="Kontakt z biurem"
    lead="Biuro jest otwarte od poniedziałku do soboty. Zadzwoń przed wizytą, żeby agent miał dla Ciebie czas."
  />
  <section class="sec info-grid" aria-labelledby="office-h">
    <div class="info-narrow info-main">
      <h2 id="office-h">Nasze biuro</h2>
      <address class="office">
        <span>{business.street}</span>
        <br />
        <span>
          {business.postcode} {business.city}, {business.district}
        </span>
      </address>
      <p class="open-now" data-open-status hidden></p>
      <table class="hours-table">
        <caption class="vh">Godziny otwarcia</caption>
        <tbody>
          {openingDays.map(day => (
            <tr>
              <th scope="row">{day.label}</th>
              <td>{day.opens !== null ? `${day.opens}:00 do ${day.closes}:00` : 'zamknięte'}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {agentList.map(agent => (
        <div class="contact-block">
          <span class="no">{agent.area}</span>
          <h3>{agent.name}</h3>
          <p>
            <a href={agent.phoneHref}>{agent.phone}</a>
          </p>
          <p>
            <a href={`mailto:${agent.email}`}>{agent.email}</a>
          </p>
        </div>
      ))}
    </div>
    <div class="info-form">
      <div class="valuation">
        <h2 class="contact-h">Napisz do nas</h2>
        <p class="val-note">Agent oddzwoni w godzinach pracy biura.</p>
        <div class="js-form">
          <ContactForm client:load />
        </div>
        <noscript>
          <p class="noscript-note">
            Formularz wymaga JavaScriptu. Zadzwoń pod{' '}
            <a href={business.phoneHref}>{business.phone}</a> albo napisz na{' '}
            <a href={`mailto:${business.email}`}>{business.email}</a>.
          </p>
        </noscript>
      </div>
    </div>
  </section>
</Layout>
