---
import { link } from '../../../shared/link';
import Layout from '../../../sites/ziarnik/Layout.astro';
import Confirmation from '../../../sites/ziarnik/islands/Confirmation';
import { sampleNotice } from '../../../sites/ziarnik/data/site';
---

<Layout
  title="Potwierdzenie zamówienia"
  description="Podsumowanie zamówienia w Ziarniku: worki, termin odbioru w palarni i kwota do zapłaty przy odbiorze. To strona przykładowa."
  path="/ziarnik/kasa/potwierdzenie/"
  current="kasa"
  bundles={['cart']}>
  <div class="page-head">
    <h1 class="hand" data-hand="Zamówione" data-read="Zamówienie przyjęte">
      Zamówione
    </h1>
  </div>
  <Confirmation client:load />
  <noscript>
    <div class="cart-empty">
      <p>
        Podsumowanie zamówienia pokazuje się w przeglądarce z włączonym JavaScriptem, zaraz po
        wysłaniu formularza z kasy. {sampleNotice}
      </p>
      <a class="btn" href={link('/ziarnik/sklep/')}>
        Do sklepu
      </a>
    </div>
  </noscript>
</Layout>
