---
import { link } from '../../shared/link';
import Nav from '../../sites/emalia/components/Nav.astro';
import VisitBar from '../../sites/emalia/components/VisitBar.astro';
import {
  bookingPath,
  clinic,
  facts,
  openingHours,
  priceLead,
  shades,
} from '../../sites/emalia/data/site';
import { formatPrice, findPrice } from '../../sites/emalia/data/prices';
import { homeCards } from '../../sites/emalia/data/treatments';
import { findMember } from '../../sites/emalia/data/team';
import VisitForm from '../../sites/emalia/islands/VisitForm';
import Layout from '../../sites/emalia/Layout.astro';
import { nbsp } from '../../sites/emalia/lib/typography';

const heroShades = ['a1', 'a2', 'b1', 'b2', 'c1'];
const toothSrc = (shade: string) => link(`/emalia/img/tooth-${shade}.webp`);
const arrow = 'M2 9h13M10 4l5 5-5 5';
const marta = findMember('marta-kowal');
const jan = findMember('jan-wrona');
const alicja = findMember('alicja-nowicka');
---

<Layout
  title="Emalia. Gabinet stomatologiczny, Wrocław, Krzyki"
  description="Emalia to gabinet stomatologiczny na Krzykach. Przegląd, higienizacja, wybielanie i leczenie kanałowe z ceną podaną przed zabiegiem."
  path="/emalia/"
  bundles={['home', 'visit', 'contact']}>
  <header class="hero" id="start" slot="hero">
    <Nav />
    <div class="stage">
      <div class="hero-field" aria-hidden="true"></div>
      <div class="hero-word brand" data-depth="10" aria-hidden="true">
        EMALIA
      </div>

      <div class="hero-head">
        <span class="label">Gabinet stomatologiczny, Krzyki</span>
        <h1>
          Zęby, o których możesz{' '}
          <span class="hl">
            <span class="hl-bar" aria-hidden="true">
              <svg viewBox="0 0 400 60" preserveAspectRatio="none">
                <path
                  d="M6 36C70 22 150 44 230 30S350 24 394 34"
                  vector-effect="non-scaling-stroke"></path>
              </svg>
            </span>
            <span class="hl-text">zapomnieć.</span>
          </span>
        </h1>
      </div>

      <div class="hero-tooth tooth-stack" id="tooth" data-depth="16" aria-hidden="true">
        {heroShades.map((shade, index) => (
          <img
            class={index === 0 ? 'is-on' : undefined}
            src={toothSrc(shade)}
            alt=""
            width="720"
            height="1120"
            fetchpriority={index === 0 ? 'high' : undefined}
            loading={index === 0 ? undefined : 'lazy'}
          />
        ))}
      </div>
      <div class="shade-pick" role="radiogroup" aria-labelledby="shade-label">
        <span class="shade-label" id="shade-label">
          Odcień zęba:{' '}
          <span class="shade-value" id="shade-sum" aria-live="polite">
            A1
          </span>
        </span>
        <span class="shade-hint">
          Skala, według której lekarz dobiera wybielanie. Wybierz odcień, a ząb zmieni kolor.
        </span>
        <div class="swatches">
          {shades.map((shade, index) => (
            <label class="swatch">
              <input
                type="radio"
                name="shade"
                value={String(index)}
                checked={index === 0}
                aria-label={`Odcień ${shade.id}`}
              />
              <span class="swatch-dot" style={`--c:${shade.color}`}>
                <span aria-hidden="true">{shade.id}</span>
              </span>
            </label>
          ))}
        </div>
      </div>
      <svg
        class="hero-ring"
        data-depth="24"
        data-scroll="1"
        viewBox="0 0 100 100"
        aria-hidden="true">
        <circle cx="50" cy="50" r="49" vector-effect="non-scaling-stroke"></circle>
      </svg>
      <img
        class="hero-pearls"
        data-depth="34"
        src={link('/emalia/img/pearls.webp')}
        alt=""
        width="900"
        height="450"
        aria-hidden="true"
      />

      <div class="hero-side hero-side-l">
        <p class="hero-sub">
          Leczymy bez pośpiechu. Przed każdym zabiegiem mówimy, co dokładnie zrobimy i ile to
          kosztuje.
        </p>
        <svg class="stroke stroke-arrow" viewBox="0 0 120 60" aria-hidden="true">
          <path
            d="M4 8C40 2 84 12 108 46M96 38l12 10 4-15"
            vector-effect="non-scaling-stroke"></path>
        </svg>
      </div>
      <div class="hero-side hero-side-r">
        <a class="pill pill-fill hero-cta" href={link(bookingPath)}>
          Umów wizytę
          <svg viewBox="0 0 18 18" aria-hidden="true">
            <path
              d={arrow}
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="text-link" href="#cennik">
          Zobacz cennik
        </a>
        <a class="text-link" href={link('/emalia/zabiegi/wybielanie/')}>
          Jak wybielamy
        </a>
      </div>
    </div>
  </header>

  <section class="sec prices" id="cennik" aria-labelledby="cennik-title">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <span class="label">Cennik</span>
        <h2 id="cennik-title">
          Cenę poznasz <span class="mark">przed zabiegiem</span>
        </h2>
        <p class="lead">{nbsp(priceLead)}</p>
      </div>
      <ul class="price-grid">
        {homeCards.map(treatment => {
          const price = findPrice(treatment.priceId);
          const featured = treatment.slug === 'wybielanie';
          return (
            <li class:list={['price-card', { 'is-cobalt': featured }]} data-reveal>
              <div class="price-top">
                <span class="label">{treatment.card?.number}</span>
                <span class="label">{treatment.card?.meta}</span>
              </div>
              <h3>
                <a href={link(`/emalia/zabiegi/${treatment.slug}/`)}>{treatment.name}</a>
              </h3>
              <p class="price">
                {formatPrice(price)}
                {featured && (
                  <svg
                    class="stroke stroke-circle"
                    viewBox="0 0 100 50"
                    preserveAspectRatio="none"
                    aria-hidden="true">
                    <path
                      d="M12 12C34 -2 92 2 97 26 100 46 46 54 12 42-4 32 6 14 40 6"
                      vector-effect="non-scaling-stroke"></path>
                  </svg>
                )}
              </p>
              <ul class="price-list">
                {treatment.card?.items.map(item => (
                  <li>{item}</li>
                ))}
              </ul>
            </li>
          );
        })}
      </ul>
      <p class="more-row">
        <a class="text-link" href={link('/emalia/cennik/')}>
          Pełny cennik
        </a>
        <a class="text-link" href={link('/emalia/zabiegi/')}>
          Wszystkie zabiegi
        </a>
      </p>
    </div>
  </section>

  <section class="sec visit" id="wizyta" aria-labelledby="wizyta-title">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <span class="label">Pierwsza wizyta</span>
        <h2 id="wizyta-title">
          Pierwsza wizyta trwa <span class="mark">godzinę</span>
        </h2>
        <p class="lead">
          Nic się nie dzieje bez twojej zgody. Plan i ceny dostajesz na kartce, a decyzję
          podejmujesz w domu.
        </p>
      </div>
      <VisitBar />
      <figure class="room" data-reveal>
        <img
          src={link('/emalia/img/gabinet.webp')}
          srcset={`${link('/emalia/img/gabinet-720.webp')} 720w, ${link('/emalia/img/gabinet.webp')} 1200w`}
          sizes="(max-width: 820px) 100vw, 760px"
          alt="Gabinet stomatologiczny: fotel zabiegowy z lampą, szafki i monitor na ścianie"
          width="1200"
          height="900"
          loading="lazy"
        />
        <figcaption>Zdjęcie poglądowe gabinetu zabiegowego.</figcaption>
      </figure>
      <p class="more-row">
        <a class="text-link" href={link('/emalia/pierwsza-wizyta/')}>
          Co zabrać i czego się spodziewać
        </a>
      </p>
    </div>
  </section>

  <section class="sec contact" id="kontakt" aria-labelledby="kontakt-title">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <span class="label">Kontakt</span>
        <h2 id="kontakt-title">
          Umów wizytę w gabinecie na <span class="mark">Krzykach</span>
        </h2>
        <p class="lead">
          {nbsp(
            `Od ${facts.yearsOfPractice} lat przyjmujemy na Krzykach w ${facts.surgeries} gabinetach, a w kartotece mamy ${facts.patientsOnFile} pacjentów. Z bólem zęba przyjmujemy ${facts.painPromise}.`,
          )}
        </p>
        <p class="lead lead-team">
          {nbsp(
            `Zespół tworzą ${marta.name} (${marta.focus}), ${jan.name} (${jan.focus}) i higienistka ${alicja.name}.`,
          )}
        </p>
      </div>
      <div class="contact-grid">
        <div data-reveal>
          <VisitForm client:load idPrefix="home" />
        </div>
        <div class="hours" data-reveal>
          <span class="label">Godziny przyjęć</span>
          <dl class="hours-list">
            {openingHours.map(row => (
              <div>
                <dt>{row.days}</dt>
                <dd>{row.hours}</dd>
              </div>
            ))}
          </dl>
          <address>
            <span class="addr-line">{clinic.street}</span>
            <span class="addr-line">
              {clinic.postalCode} {clinic.city}
            </span>
            <a class="addr-line" href={clinic.phoneHref}>
              {clinic.phoneDisplay}
            </a>
            <a class="addr-line" href={clinic.emailHref}>
              {clinic.email}
            </a>
          </address>
          <a class="pill pill-fill" href={clinic.phoneHref}>
            Zadzwoń do gabinetu
            <svg viewBox="0 0 18 18" aria-hidden="true">
              <path
                d={arrow}
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <svg
            class="stroke stroke-under-cta"
            viewBox="0 0 100 14"
            preserveAspectRatio="none"
            aria-hidden="true">
            <path d="M2 8C20 3 38 11 56 6S88 4 98 7" vector-effect="non-scaling-stroke"></path>
          </svg>
        </div>
      </div>
    </div>
  </section>
</Layout>
