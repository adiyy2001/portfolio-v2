---
import Crumbs from '../../../sites/emalia/components/Crumbs.astro';
import PageHead from '../../../sites/emalia/components/PageHead.astro';
import { clinic, openingHours } from '../../../sites/emalia/data/site';
import VisitForm from '../../../sites/emalia/islands/VisitForm';
import Layout from '../../../sites/emalia/Layout.astro';
import { nbsp } from '../../../sites/emalia/lib/typography';

const steps = [
  {
    name: 'Zostawiasz numer',
    text: 'Wpisujesz imię, numer telefonu i temat wizyty. Więcej danych nie potrzebujemy.',
  },
  {
    name: 'Oddzwaniamy',
    text: 'Dzwonimy w godzinach przyjęć, najpóźniej następnego dnia roboczego, i razem wybieramy termin.',
  },
  {
    name: 'Przychodzisz',
    text: 'Na miejscu wypełniasz krótką kartę zdrowia, a my mamy już zapisane, czego dotyczy wizyta.',
  },
];
const arrow = 'M2 9h13M10 4l5 5-5 5';
---

<Layout
  title="Kontakt i rejestracja"
  description={`Kontakt z gabinetem Emalia: ${clinic.street}, ${clinic.postalCode} ${clinic.city}. Telefon ${clinic.phoneDisplay}, godziny przyjęć i formularz rejestracji.`}
  path="/emalia/kontakt/"
  current="kontakt"
  bundles={['contact', 'inner']}>
  <Crumbs trail={[{ label: 'Kontakt' }]} />
  <PageHead
    label="Kontakt"
    title="Umów wizytę w gabinecie na Krzykach"
    lead="Zostaw imię i numer, a oddzwonimy w godzinach przyjęć. Wolisz zadzwonić od razu, numer jest obok godzin."
  />
  <section class="wrap sec-in" id="umow-wizyte" aria-labelledby="rejestracja">
    <h2 id="rejestracja" class="sr-only">
      Rejestracja
    </h2>
    <div class="contact-grid">
      <div>
        <VisitForm client:load idPrefix="contact" />
      </div>
      <div class="hours">
        <span class="label">Godziny przyjęć</span>
        <dl class="hours-list">
          {openingHours.map(row => (
            <div>
              <dt>{row.days}</dt>
              <dd>{row.hours}</dd>
            </div>
          ))}
        </dl>
        <address>
          <span class="addr-line">{clinic.street}</span>
          <span class="addr-line">
            {clinic.postalCode} {clinic.city}
          </span>
          <a class="addr-line" href={clinic.phoneHref}>
            {clinic.phoneDisplay}
          </a>
          <a class="addr-line" href={clinic.emailHref}>
            {clinic.email}
          </a>
        </address>
        <a class="pill pill-fill" href={clinic.phoneHref}>
          Zadzwoń do gabinetu
          <svg viewBox="0 0 18 18" aria-hidden="true">
            <path
              d={arrow}
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <svg
          class="stroke stroke-under-cta"
          viewBox="0 0 100 14"
          preserveAspectRatio="none"
          aria-hidden="true">
          <path d="M2 8C20 3 38 11 56 6S88 4 98 7" vector-effect="non-scaling-stroke"></path>
        </svg>
      </div>
    </div>
  </section>
  <div class="sec-tint">
    <section class="wrap sec-in two-col" aria-label="Rejestracja i dojście">
      <div>
        <h2>Jak działa rejestracja</h2>
        <ol class="steps">
          {steps.map(step => (
            <li>
              <h3>{step.name}</h3>
              <p>{nbsp(step.text)}</p>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <h2>Dojście do gabinetu</h2>
        <div class="prose">
          <p>
            {nbsp(
              `Gabinet mieści się przy ${clinic.street} na Krzykach, na parterze. Wejście od ulicy jest bez schodów, więc wjedzie tu także wózek.`,
            )}
          </p>
          <p>
            {nbsp(
              'W sobotę przyjmujemy krócej niż w tygodniu, a w niedzielę gabinet jest zamknięty. Z ostrym bólem zadzwoń w godzinach przyjęć.',
            )}
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>
