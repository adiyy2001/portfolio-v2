---
import { link } from '../../shared/link';
import CalendarSection from '../../sites/biuro-rachunkowe-gajowice/components/CalendarSection.astro';
import Section from '../../sites/biuro-rachunkowe-gajowice/components/Section.astro';
import {
  annualDate,
  annualDeadlines,
  annualYear,
  type Audience,
  statutoryRules,
} from '../../sites/biuro-rachunkowe-gajowice/data/calendar';
import { quotePath } from '../../sites/biuro-rachunkowe-gajowice/data/site';
import { dayMonthYear } from '../../sites/biuro-rachunkowe-gajowice/lib/dates';
import Layout from '../../sites/biuro-rachunkowe-gajowice/Layout.astro';

const audienceLabels: Record<Audience, string> = {
  osoba: 'osoba fizyczna',
  spolka: 'spółka z o.o. i akcyjna',
};
---

<Layout
  title="Terminy ZUS i podatków, kalendarz | Biuro Rachunkowe Gajowice"
  description={`Kalendarz miesięczny z terminami ZUS, zaliczek na PIT i CIT oraz VAT z JPK_V7, a do tego terminy roczne na ${annualYear} rok. Terminy w weekend przesuwamy na dzień roboczy.`}
  path="/biuro-rachunkowe-gajowice/terminy/"
  current="terminy">
  <CalendarSection
    id="kalendarz"
    path="gajowice / terminy"
    title="Kalendarz terminów ZUS i podatków"
    lede="Przeglądaj miesiące strzałkami. Czarne pola to terminy ustawowe, a termin wypadający w weekend przesuwa się na dzień roboczy."
    level={1}
    nav
  />
  <Section
    id="ustawowe"
    path="gajowice / terminy / miesięczne"
    title="Terminy ustawowe co miesiąc"
    lede="Stałe dni miesiąca, w których płacisz lub wysyłasz dokumenty do urzędu.">
    <table class="tbl">
      <caption>Miesięczne terminy ustawowe</caption>
      <thead>
        <tr>
          <th scope="col" class="c-day">
            dzień
          </th>
          <th scope="col">co</th>
          <th scope="col">kogo dotyczy</th>
        </tr>
      </thead>
      <tbody>
        {statutoryRules.map(rule => (
          <tr>
            <td class="c-day">{rule.day}.</td>
            <td>
              <b>{rule.title}</b>
              <span class="c-sub">{rule.note}</span>
            </td>
            <td>{rule.audience.map(entry => audienceLabels[entry]).join(', ')}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </Section>
  <Section
    id="roczne"
    path={`gajowice / terminy / ${annualYear}`}
    title={`Terminy roczne na ${annualYear} rok`}
    lede="Daty po przesunięciu na dzień roboczy, jeśli ostatni dzień wypada w weekend.">
    <table class="tbl">
      <caption>{`Terminy roczne w ${annualYear} roku`}</caption>
      <thead>
        <tr>
          <th scope="col" class="c-when">
            termin
          </th>
          <th scope="col">dokument</th>
          <th scope="col">kogo dotyczy</th>
        </tr>
      </thead>
      <tbody>
        {annualDeadlines.map(item => (
          <tr>
            <td class="c-when">{dayMonthYear(annualDate(item))}</td>
            <td>
              <b>{item.title}</b>
              <span class="c-sub">{item.note}</span>
            </td>
            <td>{item.who}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <div class="cta">
      <a class="quote-btn" href={link(quotePath)}>
        Poproś o wycenę
      </a>
      <a class="quote-btn alt" href={link('/biuro-rachunkowe-gajowice/uslugi/')}>
        Co wchodzi w abonament
      </a>
    </div>
  </Section>
</Layout>

<script>
  import { setupBase } from '../../sites/biuro-rachunkowe-gajowice/scripts/base';
  import { setupCalendar } from '../../sites/biuro-rachunkowe-gajowice/scripts/calendar';
  setupBase();
  setupCalendar();
</script>
