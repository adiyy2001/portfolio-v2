---
import { link } from '../../shared/link';
import Calculator from '../../sites/kajet/components/Calculator.astro';
import CalendarSection from '../../sites/kajet/components/CalendarSection.astro';
import CmdForm from '../../sites/kajet/components/CmdForm.astro';
import ContactDetails from '../../sites/kajet/components/ContactDetails.astro';
import Faq from '../../sites/kajet/components/Faq.astro';
import Hero from '../../sites/kajet/components/Hero.astro';
import Section from '../../sites/kajet/components/Section.astro';
import { homeFaq } from '../../sites/kajet/data/faq';
import { openHours } from '../../sites/kajet/data/site';
import Layout from '../../sites/kajet/Layout.astro';
---

<Layout
  title="Kajet. Biuro rachunkowe, Wrocław, Gajowice"
  description="Kajet prowadzi księgowość i kadry małych firm z Gajowic. Co miesiąc klient dostaje panel: kwota do zapłaty, termin i podstawa wyliczenia."
  path="/kajet/">
  <Hero />
  <CalendarSection
    id="kalendarz"
    path="kajet / kalendarz"
    title="Kalendarz terminów biura"
    lede="Czynności w stałych dniach miesiąca. Czarne pola to terminy ustawowe."
  />
  <Section
    id="cennik"
    path="kajet / cennik"
    title="Cennik, abonament miesięczny netto"
    lede="Wpisz liczbę faktur w miesiącu. Plan dobiera się sam.">
    <Calculator initialInvoices={85} />
    <div class="cta">
      <a class="quote-btn alt" href={link('/kajet/pakiety/')}>
        Pełny cennik i dobór planu
      </a>
      <a class="quote-btn alt" href={link('/kajet/uslugi/')}>
        Co wchodzi w abonament
      </a>
    </div>
  </Section>
  <Section
    id="pytania"
    path="kajet / pytania"
    title="Pomoc: najczęstsze pytania"
    lede="Odpowiedzi na to, o co klienci pytają najczęściej.">
    <Faq items={homeFaq} />
  </Section>
  <Section
    id="kontakt"
    path="kajet / kontakt, Wrocław, Gajowice"
    title="Zgłoszenie wyceny i dane biura">
    <p slot="lede" id="contact-open" class="open-line">
      Biuro czynne {openHours.label}.
    </p>
    <ContactDetails />
    <CmdForm slot="after" />
  </Section>
</Layout>

<script>
  import { setupHome } from '../../sites/kajet/scripts/home';
  setupHome();
</script>
