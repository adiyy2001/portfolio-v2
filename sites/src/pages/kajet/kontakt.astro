---
import ContactDetails from '../../sites/kajet/components/ContactDetails.astro';
import QuoteForm from '../../sites/kajet/components/QuoteForm.astro';
import Section from '../../sites/kajet/components/Section.astro';
import { processSteps } from '../../sites/kajet/data/services';
import { facts, openHours } from '../../sites/kajet/data/site';
import Layout from '../../sites/kajet/Layout.astro';
---

<Layout
  title="Kontakt i wycena | Kajet, biuro rachunkowe we Wrocławiu"
  description="Adres, telefon, e-mail i godziny biura Kajet w Gajowicach oraz formularz wyceny. Odpowiadamy w ciągu czterech godzin w dni robocze."
  path="/kajet/kontakt/"
  current="kontakt">
  <Section
    id="kontakt"
    path="kajet / kontakt, Wrocław, Gajowice"
    title="Kontakt z biurem"
    lede={`Biuro czynne ${openHours.label}. Na e-mail odpowiadamy w ciągu ${facts.replyHours} godzin w dni robocze.`}
    level={1}>
    <ContactDetails />
  </Section>
  <Section
    id="wycena"
    path="kajet / wycena"
    title="Zgłoszenie wyceny"
    lede="Do wyceny wystarczy e-mail, forma firmy i liczba faktur w miesiącu. Resztę ustalamy w rozmowie.">
    <QuoteForm />
  </Section>
  <Section
    id="po-wysylce"
    path="kajet / wycena / co dalej"
    title="Co dzieje się po wycenie"
    lede="Cztery kroki od pierwszego e-maila do pierwszego raportu.">
    <ol class="tl">
      {processSteps.map(step => (
        <li>
          <span class="tl-d">{step.no}</span>
          <div class="tl-b">
            <strong>{step.title}</strong>
            <span>{step.text}</span>
          </div>
        </li>
      ))}
    </ol>
  </Section>
</Layout>

<script>
  import { setupBase } from '../../sites/kajet/scripts/base';
  import { setupQuoteForm } from '../../sites/kajet/scripts/quote-form';
  setupBase();
  setupQuoteForm();
</script>
