---
import { link, portfolio } from '../shared/link';
import { sites } from '../shared/sites';

const faces = [
  ['Bespoke Serif', 'bespoke-serif-700', '700'],
  ['Schibsted Grotesk', 'schibsted-grotesk', '400 600'],
]
  .map(
    ([family, file, weight]) =>
      `@font-face{font-family:'${family}';src:url(${portfolio(`/fonts/${file}.woff2`)}) format('woff2');font-weight:${weight};font-display:swap}`,
  )
  .join('');

const title = 'Wzornik: strony przykładowe, Adrian Turbiński';
const description =
  'Dziesięć stron przykładowych dla zmyślonych firm. Projekt i wykonanie: Adrian Turbiński.';
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(link('/'));
// No cover of its own yet: the share card is the portfolio's "for clients" card.
const ogImage = absolute(portfolio('/og/cli-pl.jpg'));
const home = absolute(portfolio('/'));
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#page`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'pl',
      isPartOf: { '@id': `${home}#site` },
      about: { '@id': `${home}#adrian` },
      creator: { '@id': `${home}#adrian` },
      primaryImageOfPage: ogImage,
      breadcrumb: { '@id': `${canonical}#breadcrumb` },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: sites.map((site, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: `${site.name}, ${site.trade}`,
          url: absolute(link(`/${site.slug}/`)),
        })),
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: home },
        { '@type': 'ListItem', position: 2, name: 'Wzornik', item: canonical },
      ],
    },
  ],
}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5a1424" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={portfolio('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Adrian Turbiński" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
    <style is:inline set:html={faces} />
  </head>
  <body>
    <main>
      <h1>Wzornik.</h1>
      <p class="lead">
        Dziesięć stron dla zmyślonych firm. Każda ma własny krój, paletę i jeden znak rozpoznawczy,
        tak jakby zrobiło je dziesięć różnych pracowni.
      </p>
      <ol>
        {sites.map(site => (
          <li>
            <a href={link(`/${site.slug}/`)}>{site.name}</a>
            <span>{site.trade}</span>
          </li>
        ))}
      </ol>
      <p class="order">
        Podoba Ci się któraś? Uszyję podobną dla Twojej firmy.
        <a href={portfolio('/uslugi/strony-internetowe/#wycena')}>Chcę taką stronę</a>
      </p>
      <p class="back">
        <a href={link('/identyfikacja/')}>Identyfikacja wizualna: sześć realizacji</a>
      </p>
      <p class="back">
        <a href={link('/aso/')}>Screenshoty do sklepów: sześć realizacji</a>
      </p>
      <p class="back">
        <a href={link('/app-preview/')}>App preview: sześć realizacji</a>
      </p>
      <p class="back">
        <a href={portfolio('/dla-klienta/')}>Wróć do portfolio</a>
      </p>
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --wool: #5a1424;
    --chalk: #e9eff6;
    --ink: #14181f;
  }

  body {
    margin: 0;
    background: var(--chalk);
    color: var(--ink);
    font:
      18px/1.5 'Schibsted Grotesk',
      system-ui,
      'Segoe UI',
      Arial,
      sans-serif;
  }

  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 64px 16px 80px;
  }

  h1 {
    margin: 0 0 16px;
    color: var(--wool);
    font:
      700 clamp(48px, 10vw, 96px) / 1 'Bespoke Serif',
      Georgia,
      serif;
  }

  .lead {
    margin: 0 0 40px;
    max-width: 34em;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid currentColor;
  }

  li {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    align-items: baseline;
    justify-content: space-between;
    padding: 14px 0;
    border-bottom: 1px solid currentColor;
  }

  li a {
    color: var(--wool);
    font:
      700 28px/1.2 'Bespoke Serif',
      Georgia,
      serif;
  }

  a:focus-visible {
    outline: 3px solid var(--wool);
    outline-offset: 3px;
  }

  .order {
    margin: 40px 0 0;
    padding: 24px;
    background: var(--wool);
    color: var(--chalk);
  }

  .order a {
    display: inline-block;
    margin-top: 8px;
    color: var(--chalk);
    font-weight: 600;
  }

  .order a:focus-visible {
    outline-color: var(--chalk);
  }

  .back {
    margin: 40px 0 0;
  }

  .back a {
    color: var(--ink);
  }
</style>
