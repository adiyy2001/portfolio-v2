---
import Cta from '../../../sites/szkliwo/components/Cta.astro';
import Layout from '../../../sites/szkliwo/components/Layout.astro';
import ToothDiagram from '../../../sites/szkliwo/illustrations/ToothDiagram.astro';
import { priceCategories } from '../../../sites/szkliwo/data/prices';
import { treatments } from '../../../sites/szkliwo/data/treatments';
import { page } from '../../../sites/szkliwo/lib/url';

const otherCategories = priceCategories.filter(category => !category.treatment);
---

<Layout
  title="Zabiegi stomatologiczne: ból, czas i cena | Szkliwo"
  description="Sześć zabiegów w jednej tabeli: czy boli, ile trwa i ile kosztuje. Przegląd, wypełnienia, leczenie kanałowe, wybielanie, implanty i nakładki."
  path="/zabiegi/">
  <div class="container page-head">
    <nav aria-label="Okruszki">
      <ol class="crumbs">
        <li>
          <a href={page('/')}>Strona główna</a>
        </li>
        <li aria-current="page">Zabiegi</li>
      </ol>
    </nav>
    <h1>Zabiegi, które robimy najczęściej</h1>
    <p class="lead">
      Przy każdym zabiegu odpowiadamy najpierw na trzy pytania pacjentów. Tu masz je w jednym
      miejscu, żeby porównać.
    </p>
  </div>

  <section class="container compare-section" aria-labelledby="compare-title">
    <h2 id="compare-title" class="visually-hidden">
      Porównanie zabiegów
    </h2>
    <table class="compare-table">
      <thead>
        <tr>
          <th scope="col">Zabieg</th>
          <th scope="col">Czy to boli?</th>
          <th scope="col">Ile to trwa?</th>
          <th scope="col">Ile to kosztuje?</th>
        </tr>
      </thead>
      <tbody>
        {treatments.map(treatment => (
          <tr>
            <th scope="row">
              <div class="treatment">
                <div class="treatment__figure">
                  <ToothDiagram
                    kind={treatment.diagram}
                    label={`Rysunek przekroju zęba: ${treatment.name}`}
                    labelled={false}
                  />
                </div>
                <div class="treatment__text">
                  <a class="treatment__name" href={page(`/zabiegi/${treatment.slug}/`)}>
                    {treatment.name}
                  </a>
                  <p>{treatment.summary}</p>
                  <p class="small muted">Wizyty: {treatment.visits}</p>
                </div>
              </div>
            </th>
            <td data-label="Czy to boli?">{treatment.pain.answer}</td>
            <td data-label="Ile to trwa?">{treatment.duration.answer}</td>
            <td data-label="Ile to kosztuje?" class="compare-table__price">
              {treatment.cost.answer}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="section section--mist" aria-labelledby="other-title">
    <div class="container split">
      <div class="stack">
        <h2 id="other-title">Robimy też to, co nie ma osobnej strony</h2>
        <p class="lead">
          Usuwanie zębów, korony, licówki, protezy i leczenie dzieci wycenione są w cenniku, razem z
          opisem, co jest w cenie.
        </p>
      </div>
      <ul class="tick-list">
        {otherCategories.map(category => (
          <li>
            <a class="link" href={page(`/cennik/#${category.id}`)}>
              {category.name}
            </a>
            <span class="muted">: {category.lead}</span>
          </li>
        ))}
        <li>
          <a class="link" href={page('/cennik/#dzieci')}>
            Dzieci
          </a>
          <span class="muted">
            : przegląd, fluoryzacja, wypełnienia i usuwanie zębów mlecznych.
          </span>
        </li>
      </ul>
    </div>
  </section>

  <Cta
    title="Nie wiesz, od czego zacząć? Zacznij od przeglądu."
    text="Po badaniu dostaniesz plan leczenia na piśmie, z kolejnością i ceną każdej pozycji."
  />
</Layout>

<style>
  .compare-section {
    padding-bottom: clamp(48px, 7vw, 96px);
  }

  .compare-table {
    width: 100%;
    border-top: 2px solid var(--ink);
    table-layout: fixed;
  }

  .compare-table th,
  .compare-table td {
    padding: 28px 24px 28px 0;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--edge);
    font-weight: 500;
    line-height: 1.3;
  }

  .compare-table thead th {
    padding-block: 18px;
    font-size: 1rem;
    font-weight: 600;
  }

  .compare-table thead th:first-child {
    width: 46%;
  }

  .compare-table tbody tr {
    position: relative;
  }

  .compare-table tbody tr:hover {
    background: var(--mist);
  }

  .compare-table tbody th {
    font-weight: 400;
  }

  .treatment {
    display: grid;
    grid-template-columns: clamp(80px, 8vw, 104px) minmax(0, 1fr);
    gap: 20px clamp(20px, 2.5vw, 36px);
    align-items: start;
  }

  .treatment__figure {
    overflow: hidden;
    border-radius: 6px 6px 32px 32px;
  }

  .treatment__text {
    display: grid;
    gap: 8px;
  }

  .treatment__text p {
    max-width: 32em;
    line-height: 1.5;
  }

  .treatment__name {
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    text-decoration: none;
    background: linear-gradient(var(--coral), var(--coral)) 0 100% / 0 3px no-repeat;
    justify-self: start;
    padding-bottom: 2px;
  }

  .treatment__name::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .compare-table tbody tr:hover .treatment__name,
  .treatment__name:focus-visible {
    background-size: 100% 3px;
  }

  .compare-table td {
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
  }

  .compare-table__price {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 860px) {
    .compare-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .compare-table,
    .compare-table tbody,
    .compare-table tr,
    .compare-table th,
    .compare-table td {
      display: block;
    }

    .compare-table tr {
      padding: 24px 0;
      border-bottom: 1px solid var(--edge);
    }

    .compare-table th,
    .compare-table td {
      padding: 0;
      border: 0;
    }

    .compare-table tbody th {
      margin-bottom: 14px;
    }

    .compare-table td {
      display: grid;
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: 12px;
      padding-block: 4px;
    }

    .compare-table td::before {
      content: attr(data-label);
      color: var(--muted);
      font-size: var(--text-small);
      font-weight: 600;
      line-height: 1.6;
    }
  }

  @media (max-width: 560px) {
    .treatment {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 16px;
    }

    .treatment__figure {
      border-radius: 4px 4px 22px 22px;
    }
  }
</style>
