---
import { link } from '../../../shared/link';
import Layout from '../../../sites/nakretka/Layout.astro';
import PageHead from '../../../sites/nakretka/components/PageHead.astro';
import { otherRepair, services } from '../../../sites/nakretka/data/services';
import { business } from '../../../sites/nakretka/data/site';
import { imageUrl } from '../../../sites/nakretka/lib/assets';
import { formatNm, formatZl } from '../../../sites/nakretka/lib/format';
---

<Layout
  title="Usługi warsztatu"
  description="Sześć usług warsztatu Nakrętka na Fabrycznej we Wrocławiu: przegląd, olej, hamulce, opony, zawieszenie i zapłon. Przy każdej podajemy cenę, czas i moment dokręcenia."
  path="/nakretka/uslugi/"
  current="uslugi"
  bundles={['pages']}>
  <PageHead
    title="Usługi"
    kicker="Co robimy w hali"
    lead="Sześć rodzajów pracy, przy każdej cena od, czas i moment dokręcenia kluczem. Gdy awaria nie pasuje do żadnej z nich, wyceniamy ją po diagnozie."
  />
  <section class="paper" aria-labelledby="lista-uslug">
    <div class="wrap">
      <h2 id="lista-uslug" class="sr-only">
        Lista usług
      </h2>
      <ul class="svc-grid">
        {services.map(service => (
          <li class="svc">
            <div class="svc-ph">
              <img
                src={imageUrl(service.image)}
                alt={service.alt}
                width={service.width}
                height={service.height}
                loading="lazy"
                decoding="async"
              />
            </div>
            <h3>
              <a href={link(`/nakretka/uslugi/${service.slug}/`)}>{service.name}</a>
            </h3>
            <p>{service.scope}</p>
            <p class="svc-price">
              <span class="k">{formatZl(service.price)}</span>
              <span class="svc-meta">{service.priceNote}</span>
            </p>
            <p class="svc-meta">Czas pracy: {service.duration}.</p>
            <p class="tag">
              {service.torque.label} {formatNm(service.torque.nm)}
            </p>
          </li>
        ))}
      </ul>
      <div class="note-box">
        <h2 class="h2">{otherRepair.name}</h2>
        <p>
          Nie ma tu Twojej usterki? Opisz objawy przy zapisie albo zadzwoń. Zaczynamy od diagnozy, a
          cenę podajemy przed rozpoczęciem pracy.
        </p>
        <div class="cta-row">
          <a class="cta" href={link('/nakretka/umow-wizyte/?usluga=inna-naprawa')}>
            Umów diagnozę
          </a>
          <a href={business.phoneHref}>Wolisz zadzwonić? {business.phone}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
