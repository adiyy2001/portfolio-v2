---
import { link } from '../../../shared/link';
import Layout from '../../../sites/nakretka/Layout.astro';
import PageHead from '../../../sites/nakretka/components/PageHead.astro';
import ProcessSteps from '../../../sites/nakretka/components/ProcessSteps.astro';
import { business, torqueRange } from '../../../sites/nakretka/data/site';
import { imageUrl } from '../../../sites/nakretka/lib/assets';

const numbers = [
  { value: business.stations, label: 'stanowisk w hali na Fabrycznej' },
  { value: business.torqueModels, label: 'modeli aut w tabeli momentów' },
  { value: business.inspectionPoints, label: 'punktów kontroli w przeglądzie' },
  { value: business.maxRepairHours, label: 'godzin to najdłuższa typowa naprawa' },
];

const promises = [
  {
    title: 'Karta każdego auta',
    text: 'Przy przyjęciu zakładamy kartę: usterki, przebieg, zakres prac i momenty, do których dokręciliśmy śruby. Przy następnej wizycie zaczynamy od niej.',
  },
  {
    title: 'Klucz zamiast wyczucia',
    text: `Koła, zaciski, korki i świece dokręcamy kluczem dynamometrycznym. Skala klucza sięga od ${torqueRange.min} do ${torqueRange.max} Nm, a wartości bierzemy z tabeli dla ${business.torqueModels} modeli.`,
  },
  {
    title: 'Stare części do wglądu',
    text: 'Wymienione części zostają w skrzynce do odbioru auta. Możesz je obejrzeć i sprawdzić, czy wymiana była potrzebna.',
  },
  {
    title: 'Cena przed pracą',
    text: 'Gdy diagnoza pokaże więcej, niż zapisaliśmy przy przyjęciu, dzwonimy z nową ceną. Bez Twojej zgody nie ruszamy dodatkowej pracy.',
  },
];
---

<Layout
  title="O warsztacie"
  description={`Nakrętka to warsztat z Fabrycznej we Wrocławiu: ${business.stations} stanowisk, tabela momentów dla ${business.torqueModels} modeli aut i karta każdego samochodu. Zobacz, jak pracujemy.`}
  path="/nakretka/o-warsztacie/"
  current="o-warsztacie"
  bundles={['pages']}>
  <PageHead
    title="Warsztat"
    kicker="Fabryczna, Wrocław"
    lead="Mała hala, w której każda śruba ma zapisaną wartość. Nie obiecujemy cudów, tylko robotę, którą da się sprawdzić."
  />
  <section class="paper" aria-labelledby="historia">
    <div class="wrap cols-2">
      <div class="prose">
        <h2 id="historia" class="h2-big">
          Po co klucz
        </h2>
        <p>
          Śruba dokręcona za słabo odpada, a za mocno zrywa gwint. Dlatego w Nakrętce nie dokręcamy
          na oko. Każde koło, zacisk, korek i świeca dostaje taki moment, jaki podaje producent, a
          my zapisujemy go w karcie auta.
        </p>
        <p>
          Hala przy {business.street} ma {business.stations} stanowisk. Przed pracą oglądamy auto
          razem z Tobą, po pracy oddajemy je z protokołem i starymi częściami. Najdłuższa typowa
          naprawa trwa do {business.maxRepairHours} godzin.
        </p>
        <div class="cta-row">
          <a class="cta" href={link('/nakretka/umow-wizyte/')}>
            Umów wizytę
          </a>
          <a href={link('/nakretka/uslugi/')}>Zobacz usługi</a>
        </div>
      </div>
      <figure class="story-ph">
        <img
          src={imageUrl('shop')}
          alt="Mechanik klęczy przy aucie w hali, w głębi regał z płynami"
          width="1700"
          height="1020"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Hala na Fabrycznej, stanowisko przy regale z płynami.</figcaption>
      </figure>
    </div>
  </section>
  <section class="band" aria-labelledby="liczby">
    <div class="wrap">
      <h2 id="liczby" class="h2-big">
        W liczbach
      </h2>
      <ul class="numbers">
        {numbers.map(item => (
          <li>
            <span class="num">{item.value}</span>
            <span class="num-label">{item.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="paper" aria-labelledby="zasady">
    <div class="wrap">
      <h2 id="zasady" class="h2-big">
        Cztery zasady
      </h2>
      <ul class="promises">
        {promises.map(item => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="proces" aria-labelledby="droga">
    <h2 id="droga" class="pr-title">
      <span class="g">Droga auta</span> <span class="g serif face-field">przez halę</span>
    </h2>
    <ProcessSteps />
  </section>
</Layout>
