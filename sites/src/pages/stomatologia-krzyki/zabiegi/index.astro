---
import { link } from '../../../shared/link';
import Crumbs from '../../../sites/stomatologia-krzyki/components/Crumbs.astro';
import Cta from '../../../sites/stomatologia-krzyki/components/Cta.astro';
import PageHead from '../../../sites/stomatologia-krzyki/components/PageHead.astro';
import { findPrice, formatPrice } from '../../../sites/stomatologia-krzyki/data/prices';
import { treatments } from '../../../sites/stomatologia-krzyki/data/treatments';
import Layout from '../../../sites/stomatologia-krzyki/Layout.astro';
import { nbsp } from '../../../sites/stomatologia-krzyki/lib/typography';
---

<Layout
  title="Zabiegi"
  description="Sześć zabiegów w gabinecie na Krzykach: przegląd, higienizacja, wybielanie, wypełnienia, leczenie kanałowe i pomoc przy bólu zęba. Przy każdym czas, liczba wizyt i cena od."
  path="/stomatologia-krzyki/zabiegi/"
  current="zabiegi"
  bundles={['inner']}>
  <Crumbs trail={[{ label: 'Zabiegi' }]} />
  <PageHead
    label="Zabiegi"
    title="Co robimy w gabinecie"
    lead="Sześć zabiegów, przy każdym czas, liczba wizyt i cena od. Wybierz zabieg, żeby zobaczyć przebieg wizyty, pytania pacjentów i lekarza, który go prowadzi."
  />
  <section class="wrap sec-in" aria-label="Lista zabiegów">
    <ul class="t-grid">
      {treatments.map(treatment => {
        const price = findPrice(treatment.priceId);
        return (
          <li class="t-card">
            <h2>
              <a href={link(`/stomatologia-krzyki/zabiegi/${treatment.slug}/`)}>{treatment.name}</a>
            </h2>
            <p>{nbsp(treatment.short)}</p>
            <p class="t-meta">
              <span>{treatment.time}</span>
              <span>{treatment.visits}</span>
              <span>
                <b>{formatPrice(price)}</b> {price.unit}
              </span>
            </p>
          </li>
        );
      })}
    </ul>
  </section>
  <Cta
    title="Nie wiesz, od czego zacząć?"
    text="Zacznij od przeglądu. Po nim dostaniesz plan leczenia i ceny na kartce."
    topic="Przegląd"
  />
</Layout>
