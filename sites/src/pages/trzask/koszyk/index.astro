---
import Layout from '../../../sites/trzask/Layout.astro';
import CartPage from '../../../sites/trzask/islands/CartPage';
---

<Layout
  title="Koszyk"
  description="Twój koszyk w sklepie Trzask: kawy i akcesoria, ilości, kod rabatowy, dostawa gratis od 150 zł. Sprawdź zamówienie przed kasą."
  path="/trzask/koszyk/"
  current="koszyk"
  bundles={['shop', 'cart']}
  noindex>
  <div class="wrap page-head">
    <h1>Koszyk</h1>
  </div>
  <div class="wrap page-body">
    <CartPage client:load />
  </div>
</Layout>
