---
import { roomTypes } from '../../../../sites/brelok/data/hotel';
import RoomPage from '../../../../sites/brelok/views/RoomPage.astro';

export const getStaticPaths = () =>
  roomTypes.map(type => ({ params: { room: type.slug.en }, props: { roomId: type.id } }));

const { roomId } = Astro.props;
---

<RoomPage lang="en" roomId={roomId} />
