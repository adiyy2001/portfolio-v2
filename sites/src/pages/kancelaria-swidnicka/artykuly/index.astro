---
import ArticleItem from '../../../sites/kancelaria-swidnicka/components/ArticleItem.astro';
import Cta from '../../../sites/kancelaria-swidnicka/components/Cta.astro';
import PageHead from '../../../sites/kancelaria-swidnicka/components/PageHead.astro';
import { articles } from '../../../sites/kancelaria-swidnicka/data/articles';
import { firm } from '../../../sites/kancelaria-swidnicka/data/site';
import Layout from '../../../sites/kancelaria-swidnicka/Layout.astro';
---

<Layout
  title="Artykuły"
  description="Krótkie, ogólne opracowania naszych prawników o zachowku, alimentach, spółce z o.o. i kaucji za mieszkanie. Informacja, nie porada w konkretnej sprawie."
  path="/kancelaria-swidnicka/artykuly/"
  current="artykuly"
  bundles={['inner']}>
  <PageHead
    title="Artykuły o sprawach, z którymi przychodzą klienci"
    lead={`Cztery opracowania z aktualnym stanem prawnym na ${firm.stateOfLaw}. To ogólna informacja, nie porada w konkretnej sprawie.`}
    crumbs={[{ label: 'Strona główna', href: '/kancelaria-swidnicka/' }, { label: 'Artykuły' }]}
  />
  <div class="block">
    <ul class="article-list block-body">
      {articles.map(article => (
        <ArticleItem article={article} />
      ))}
    </ul>
  </div>
  <Cta />
</Layout>
