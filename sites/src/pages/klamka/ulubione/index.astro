---
import Layout from '../../../sites/klamka/Layout.astro';
import PageHead from '../../../sites/klamka/components/PageHead.astro';
import FavouritesList from '../../../sites/klamka/islands/FavouritesList';
---

<Layout
  title="Ulubione oferty"
  description="Oferty zapisane przyciskiem Ulubione w magazynie Klamka. Lista zostaje w Twojej przeglądarce, nic nie jest wysyłane do biura."
  path="/klamka/ulubione/"
  current="ulubione"
  bundles={['catalog']}>
  <PageHead
    kicker="Zapisane na tym urządzeniu"
    title="Ulubione oferty"
    lead="Oferty, przy których kliknięto „Ulubione”. Lista zostaje w tej przeglądarce i nic z niej nie trafia do biura."
  />
  <section class="sec sec-match sec-match--page" aria-labelledby="fav-h">
    <h2 class="vh" id="fav-h">
      Zapisane oferty
    </h2>
    <FavouritesList client:load />
    <noscript>
      <p class="fav-state">Lista ulubionych działa tylko z włączonym JavaScriptem.</p>
    </noscript>
  </section>
</Layout>
