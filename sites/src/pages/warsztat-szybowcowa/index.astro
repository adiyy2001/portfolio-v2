---
import { link } from '../../shared/link';
import Layout from '../../sites/warsztat-szybowcowa/Layout.astro';
import PriceTable from '../../sites/warsztat-szybowcowa/components/PriceTable.astro';
import ProcessSteps from '../../sites/warsztat-szybowcowa/components/ProcessSteps.astro';
import { findService } from '../../sites/warsztat-szybowcowa/data/services';
import { addressLines, business, hoursShort } from '../../sites/warsztat-szybowcowa/data/site';
import QuickOrder from '../../sites/warsztat-szybowcowa/islands/QuickOrder';
import TorqueWidget from '../../sites/warsztat-szybowcowa/islands/TorqueWidget';
import { formatZl } from '../../sites/warsztat-szybowcowa/lib/format';
import { imageUrl } from '../../sites/warsztat-szybowcowa/lib/assets';

const inspection = findService('przeglad');
const inspectionPrice = inspection ? formatZl(inspection.price) : '';
---

<Layout
  home
  title="Warsztat Szybowcowa na Fabrycznej we Wrocławiu"
  description="Warsztat Szybowcowa z Fabrycznej we Wrocławiu: przeglądy, olej, hamulce i opony. Każdą śrubę dokręcamy kluczem dynamometrycznym."
  path="/warsztat-szybowcowa/"
  bundles={['home', 'sheet', 'process']}>
  <header class="hero" id="start" slot="hero">
    <img
      class="hero-ph"
      src={imageUrl('hero')}
      alt="Mechanik dokręca kluczem śrubę przy silniku starego auta"
      width="1900"
      height="1212"
      fetchpriority="high"
    />
    <i class="dust dust-light" aria-hidden="true"></i>
    <a
      class="brand mast"
      href={link('/warsztat-szybowcowa/')}
      aria-label="Warsztat Szybowcowa, strona główna">
      <span class="brand-trade">Warsztat</span>
      <span class="brand-place">Szybowcowa</span>
    </a>
    <nav class="menu s" aria-label="Główna nawigacja">
      <a href={link('/warsztat-szybowcowa/uslugi/')}>Usługi</a>
      <a href={link('/warsztat-szybowcowa/cennik/')}>Cennik</a>
      <a href={link('/warsztat-szybowcowa/o-warsztacie/')}>Warsztat</a>
      <a href={link('/warsztat-szybowcowa/kontakt/')}>Kontakt</a>
    </nav>
    <p class="q-a s">koło, moment dokręcenia</p>
    <h1 class="quote">
      <span class="q-b g">
        <span class="ghost" aria-hidden="true" data-t="110"></span>
        <span class="face">110</span>
      </span>
      <span class="q-d g serif">
        <span class="ghost" aria-hidden="true" data-t="Nm"></span>
        <span class="face">Nm</span>
      </span>
    </h1>
    <p class="sub">
      Każdą śrubę dokręcamy kluczem dynamometrycznym, a wartość zapisujemy w karcie każdego auta.
    </p>
    <div class="deal" id="deal" tabindex="-1">
      <p class="deal-price">
        <span class="deal-lab">Przegląd od</span> <strong class="k">{inspectionPrice}</strong>
      </p>
      <a class="deal-tel k" href={business.phoneHref} aria-label={`Zadzwoń: ${business.phone}`}>
        {business.phone}
      </a>
      <ul class="deal-meta">
        {hoursShort.map(line => (
          <li>{line}</li>
        ))}
        <li>{addressLines[0]}</li>
        <li>{addressLines[1]}</li>
      </ul>
      <a class="book-main" href={link('/warsztat-szybowcowa/umow-wizyte/?usluga=przeglad')}>
        Umów przegląd
      </a>
    </div>
  </header>

  <section class="zlecenie" id="zlecenie" aria-labelledby="zlecenie-t">
    <i class="dust dust-light" aria-hidden="true"></i>
    <h2 id="zlecenie-t" class="zl-title">
      <span class="g face-field">Zlecenie</span> <span class="s">warsztatowe</span>
    </h2>
    <div class="sheet">
      <div class="sheet-part" id="cennik">
        <p class="sheet-head s">
          <strong>Pozycje zlecenia</strong>
          <span>Ceny brutto za jedną usługę, robocizna z częściami eksploatacyjnymi.</span>
        </p>
        <PriceTable />
      </div>
      <div class="sheet-part klucz" id="klucz">
        <h3 class="part-h s">Klucz dynamometryczny</h3>
        <TorqueWidget client:load />
        <p class="nojs-torque s">
          Znane momenty z naszej hali: świeca 25 Nm, odpływ oleju 35 Nm, głowica 90 Nm, koło 110 Nm.
        </p>
      </div>
      <div class="sheet-part zapis" id="zapis">
        <h3 class="part-h s">Dane auta i telefon</h3>
        <QuickOrder client:load />
        <noscript>
          <p class="form-note s">
            Formularz działa z włączonym JavaScriptem. Bez niego zadzwoń:
            <a href={business.phoneHref}>{business.phone}</a>.
          </p>
        </noscript>
      </div>
    </div>
  </section>

  <section class="proces" id="proces" aria-labelledby="proces-t">
    <h2 id="proces-t" class="pr-title">
      <span class="g">Droga auta</span> <span class="g serif face-field">przez halę</span>
    </h2>
    <ProcessSteps />
  </section>
</Layout>
