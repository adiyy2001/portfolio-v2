---
import PageHead from '../../sites/lofty-cegielniane/components/PageHead.astro';
import { credits, meta } from '../../sites/lofty-cegielniane/copy';
import { photos } from '../../sites/lofty-cegielniane/images';
import Layout from '../../sites/lofty-cegielniane/Layout.astro';
import { path, url } from '../../sites/lofty-cegielniane/site';
---

<Layout
  title={meta.credits.title}
  description={meta.credits.description}
  path={path('zrodla-zdjec/')}>
  <PageHead
    crumbs={[{ label: credits.headline }]}
    mark={credits.mark}
    title={credits.headline}
    lead={credits.intro}
    photo={photos.hala}
  />
  <div class="wrap credits-wrap">
    <h2>{credits.photoHeading}</h2>
    <p class="body">{credits.photoNote}</p>
    <table>
      <tbody>
        {credits.photoRows.map(([label, value]) => (
          <tr>
            <th scope="row">{label}</th>
            <td>{value}</td>
          </tr>
        ))}
        <tr>
          <th scope="row">Źródło</th>
          <td>
            <a href={credits.sourceHref}>{credits.sourceLabel}</a>
          </td>
        </tr>
        <tr>
          <th scope="row">Licencja</th>
          <td>
            <a href={credits.licenceHref}>{credits.licenceLabel}</a>
          </td>
        </tr>
      </tbody>
    </table>
    <p class="body">{credits.changes}</p>
    <h2>{credits.framesHeading}</h2>
    <table>
      <tbody>
        {credits.frames.map(([label, value]) => (
          <tr>
            <th scope="row">{label}</th>
            <td>{value}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <h2>{credits.typeHeading}</h2>
    <p class="body">
      {credits.typeText} <a href={credits.typeHref}>{credits.typeLabel}</a>.
    </p>
    <p class="body">
      <a href={url()}>{credits.back}</a>
    </p>
  </div>
</Layout>
