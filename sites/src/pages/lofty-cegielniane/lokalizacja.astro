---
import LocationDiagram from '../../sites/lofty-cegielniane/components/LocationDiagram.astro';
import PageHead from '../../sites/lofty-cegielniane/components/PageHead.astro';
import { location, meta, where } from '../../sites/lofty-cegielniane/copy';
import { photos } from '../../sites/lofty-cegielniane/images';
import Layout from '../../sites/lofty-cegielniane/Layout.astro';
import { path, site, url } from '../../sites/lofty-cegielniane/site';
---

<Layout
  title={meta.location.title}
  description={meta.location.description}
  path={path('lokalizacja/')}
  current="lokalizacja">
  <PageHead
    crumbs={[{ label: 'Lokalizacja' }]}
    mark={location.mark}
    title={location.headline}
    lead={location.lead}
    photo={photos.adres}
  />
  <section class="wrap split" aria-labelledby="zasieg-h">
    <div>
      <h2 class="mark" id="zasieg-h">
        {location.diagramHeading}
      </h2>
      <LocationDiagram />
      <p class="note">{location.diagramNote}</p>
    </div>
    <div>
      <h2 class="mark">{where.nearLabel}</h2>
      <ul class="near">
        {where.near.map(item => (
          <li>
            <span>{item.minutes} min pieszo</span>
            <span>{item.place}</span>
          </li>
        ))}
      </ul>
      <h2 class="mark office-h">{location.officeHeading}</h2>
      <p class="body">{location.officeText}</p>
      <p class="body">
        <a class="tel" href={site.phoneHref}>
          {site.phone}
        </a>
      </p>
      <a class="link" href={url('biuro-sprzedazy/')}>
        <span>Umów pokaz</span>
        <i aria-hidden="true"></i>
      </a>
    </div>
  </section>
</Layout>
