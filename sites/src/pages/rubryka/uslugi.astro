---
import { link } from '../../shared/link';
import Accounts from '../../sites/rubryka/components/documents/Accounts.astro';
import KpirSheet from '../../sites/rubryka/components/documents/KpirSheet.astro';
import KsefInvoice from '../../sites/rubryka/components/documents/KsefInvoice.astro';
import PayrollBars from '../../sites/rubryka/components/documents/PayrollBars.astro';
import VatForm from '../../sites/rubryka/components/documents/VatForm.astro';
import Layout from '../../sites/rubryka/Layout.astro';
import { type ServiceId, services } from '../../sites/rubryka/services';
import { quotePath, site } from '../../sites/rubryka/site';
import '../../sites/rubryka/styles/documents.css';

const documents = {
  'kpir-i-ryczalt': {
    Document: KpirSheet,
    caption:
      'Księga przychodów i rozchodów: jeden dokument to jeden wiersz. Faktury z KSeF wpadają do niej same.',
  },
  'pelna-ksiegowosc': {
    Document: Accounts,
    caption:
      'Dwa konta z salda: każda operacja trafia na dwie strony, a suma po lewej musi równać się sumie po prawej.',
  },
  'kadry-i-place': {
    Document: PayrollBars,
    caption:
      'Przykładowa lista płac: z 6 000 zł brutto pracownik dostaje 4 420,43 zł. Resztę rozdzielają składki i zaliczka na PIT.',
  },
  'vat-i-jpk': {
    Document: VatForm,
    caption:
      'Po wysłaniu pliku JPK_V7 system zwraca UPO. Status 200 oznacza, że plik został przyjęty bez błędów.',
  },
  'start-z-ksef': {
    Document: KsefInvoice,
    caption:
      'Faktura w KSeF to plik XML z numerem nadanym przez system. Kod QR na wizualizacji prowadzi do faktury w KSeF.',
  },
} satisfies Record<ServiceId, { Document: typeof KpirSheet; caption: string }>;
---

<Layout
  title="Usługi księgowe dla małych firm | Rubryka"
  description="KPiR i ryczałt, pełna księgowość, kadry i płace, VAT z JPK oraz start z KSeF. Co robimy, co zostaje po Twojej stronie, jakich terminów pilnujemy i ile to kosztuje."
  path="/rubryka/uslugi/">
  <div class="pagehead">
    <div class="wrap">
      <h1>Co robimy, a co zostaje Tobie</h1>
      <span class="total-rule" aria-hidden="true"></span>
      <p class="lead">
        Każda usługa działa tak samo: wiesz, kto co robi, do kiedy i ile to kosztuje. Poniżej
        wszystko po kolei, z terminami, których pilnujemy.
      </p>
    </div>
  </div>

  <nav class="index" aria-label="Usługi na tej stronie">
    <div class="wrap">
      <ul>
        {services.map(service => (
          <li>
            <a href={`#${service.id}`}>
              <span class="index__name">{service.title}</span>
              <span class="index__price">{service.priceShort}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  {services.map((service, position) => {
    const { Document, caption } = documents[service.id];
    return (
      <section
        class="service"
        id={service.id}
        aria-labelledby={`${service.id}-title`}
        data-side={position % 2 === 0 ? 'left' : 'right'}>
        <div class="wrap service__grid">
          <div class="service__lead">
            <h2 id={`${service.id}-title`}>{service.title}</h2>
            <p class="lead">{service.intro}</p>
            <p class="service__price">{service.priceLine}</p>
            <figure class="service__figure sheet">
              <Document />
              <figcaption>{caption}</figcaption>
            </figure>
          </div>
          <div class="service__detail">
            <div>
              <h3>Co robimy</h3>
              <ul class="ticks">
                {service.weDo.map(item => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <div>
              <h3>Co robisz Ty</h3>
              <ul class="plain">
                {service.youDo.map(item => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
            <div class="service__dates">
              <h3>Terminy, których pilnujemy</h3>
              <ul class="plain">
                {service.deadlines.map(item => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    );
  })}

  <section class="band on-orange closing">
    <div class="wrap closing__grid">
      <div>
        <h2>Nie wiesz, której usługi potrzebujesz?</h2>
        <p class="lead">
          Powiedz nam, jaką masz firmę i ile dokumentów miesięcznie. Zestawimy usługi i podamy cenę.
        </p>
      </div>
      <div class="button-row">
        <a class="button" href={link(quotePath)}>
          Wyceń księgowość
        </a>
        <a class="button button--plain" href={site.phoneHref}>
          Zadzwoń: {site.phone}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .index {
    border-block: 2px solid var(--navy);
    background: var(--white);
  }

  .index ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .index li {
    border-bottom: 1px dashed var(--dash);
  }

  .index li:nth-child(odd) {
    border-right: 1px dashed var(--dash);
  }

  .index li:last-child {
    grid-column: 1 / -1;
    border-right: 0;
    border-bottom: 0;
  }

  .index a {
    display: grid;
    gap: 2px;
    align-content: center;
    min-height: 76px;
    padding: 12px 14px;
    text-decoration: none;
  }

  .index a:hover {
    background: var(--orange);
  }

  .index__name {
    font-weight: 700;
    line-height: 1.2;
  }

  .index__price {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .index a:hover .index__price {
    color: var(--navy);
  }

  @container page (min-width: 900px) {
    .index ul {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .index li,
    .index li:nth-child(odd),
    .index li:last-child {
      grid-column: auto;
      border-right: 0;
      border-bottom: 0;
      border-left: 1px dashed var(--dash);
    }

    .index li:first-child {
      border-left: 0;
    }

    .index a {
      padding-inline: 20px;
    }
  }

  .service {
    padding-block: clamp(48px, 8cqi, 88px);
    border-bottom: 2px solid var(--navy);
  }

  .service__grid {
    display: grid;
    gap: 40px;
    align-items: start;
  }

  .service__lead h2 {
    margin-bottom: 20px;
  }

  .service__lead .lead {
    margin: 0 0 24px;
  }

  .service__price {
    display: inline-block;
    max-width: 34em;
    margin: 0 0 32px;
    padding: 12px 16px;
    border-left: 8px solid var(--orange);
    background: var(--white);
    font-weight: 700;
    line-height: 1.4;
  }

  .service__figure {
    margin: 0;
    max-width: 440px;
  }

  .service__figure :global(svg) {
    padding: 8px 8px 0;
  }

  .service__figure figcaption {
    margin: 0;
    padding: 12px 16px 16px;
    border-top: 1px dashed var(--dash);
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .service__detail {
    display: grid;
    gap: 32px;
  }

  .service__detail h3 {
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--navy);
    font-size: 1.375rem;
  }

  .service__dates {
    padding: 20px;
    border: 2px dashed var(--navy);
    background: var(--white);
  }

  .service__dates h3 {
    margin-top: 0;
  }

  @container page (min-width: 900px) {
    .service__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 64px;
    }

    .service[data-side='right'] .service__lead {
      order: 2;
    }

    .service[data-side='right'] .service__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    }
  }
</style>
