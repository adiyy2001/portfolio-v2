---
import { link } from '../../../shared/link';
import Layout from '../../../sites/palarnia-kawy-nadodrze/Layout.astro';
import { business, numbers, roaster } from '../../../sites/palarnia-kawy-nadodrze/data/site';

const stats: Array<[string, string]> = [
  [String(numbers.batchesThisYear), 'partii w tym roku'],
  [`${numbers.batchKg} kg`, 'zielonego ziarna na partię'],
  [String(numbers.plantations), 'plantacji'],
  [`${numbers.restDays} dni`, 'odpoczynku po paleniu'],
];
---

<Layout
  title="O palarni"
  description="Mała palarnia na Nadodrzu we Wrocławiu. Poznaj Huberta Wojciechowskiego, jego krzywe palenia i dziewięć plantacji, z których kupuje ziarno."
  path="/palarnia-kawy-nadodrze/o-palarni/"
  current="o-palarni"
  bundles={['info']}>
  <div class="page-head">
    <h1 class="hand" data-hand="Palarnia">
      Palarnia
    </h1>
    <p class="typed page-head__lead">Mała palarnia nad Odrą, na Nadodrzu.</p>
  </div>
  <div class="info">
    <div class="info__main">
      <div class="prose">
        <h2>Kto pali</h2>
        <p>
          Nazywam się {roaster.name}. Od {roaster.years} lat stoję przy piecu i mam certyfikat{' '}
          {roaster.certificate}. To jedna palarnia, jeden piec i jedna osoba, która pilnuje każdej
          partii.
        </p>
        <p>
          Palę małe partie po {numbers.batchKg} kilogramów zielonego ziarna. W tym roku wyszło ich{' '}
          {numbers.batchesThisYear}. Każdy worek dostaje numer partii i datę palenia, więc wiesz,
          kiedy wypaliłem kawę, którą pijesz.
        </p>
      </div>
      <div class="prose">
        <h2>Skąd ziarno</h2>
        <p>
          Kupuję od {numbers.plantations} plantacji w Etiopii, Kenii, Kolumbii, Brazylii i
          Gwatemali. Wracam do tych samych rolników, bo dzięki temu wiem, czego się spodziewać.
          Każdą partię zielonego ziarna najpierw próbuję, dopiero potem trafia do pieca.
        </p>
      </div>
      <div class="prose">
        <h2>Jak palę</h2>
        <p>
          Skala palenia ma {numbers.scaleSteps} stopni, od jasnego do ciemnego. Stawiam kawy na
          trzech z nich: 3, 6 i 9. Każdą krzywą zapisuję i trzymam się jej co do sekundy. Filtr
          wyjmuję tuż po pierwszym trzasku, a espresso kończę na stopniu 9.
        </p>
        <p>
          Po paleniu kawa odpoczywa {numbers.restDays} dni i dopiero wtedy jedzie do worka. W tym
          czasie ucieka z niej nadmiar gazu i smak się wyrównuje.
        </p>
        <p>
          <a href={link('/palarnia-kawy-nadodrze/#palimy')}>
            Zobacz krzywą palenia na stronie głównej
          </a>
        </p>
      </div>
    </div>
    <div class="info__aside">
      <div class="card card--tilt">
        <h2>W liczbach</h2>
        <dl class="about-stats">
          {stats.map(([value, label]) => (
            <div>
              <dd>{value}</dd>
              <dt>{label}</dt>
            </div>
          ))}
        </dl>
      </div>
      <div class="card">
        <h2>Odwiedź nas</h2>
        <p>
          {business.street}, {business.postcode} {business.city}
        </p>
        <p>
          <a class="credits-link" href={link('/palarnia-kawy-nadodrze/kontakt/')}>
            Godziny i dojazd
          </a>
        </p>
      </div>
    </div>
  </div>
</Layout>
