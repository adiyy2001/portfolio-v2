---
import { link } from '../../shared/link';
import Layout from '../../sites/palarnia-kawy-nadodrze/Layout.astro';
import NeighbourhoodMap from '../../sites/palarnia-kawy-nadodrze/components/NeighbourhoodMap.astro';
import {
  business,
  numbers,
  openingRows,
  roaster,
  degreePriceZl,
} from '../../sites/palarnia-kawy-nadodrze/data/site';
import { recipes, timeNote, waterNote } from '../../sites/palarnia-kawy-nadodrze/data/recipes';

const nbsp = '\u00a0';
const scale = Array.from({ length: numbers.scaleSteps }, (_, index) => index + 1);
const highlighted = [3, 6, 9];
const recipeList = [recipes.espresso, recipes.przelew, recipes.prasa];
const img = (name: string) => link(`/palarnia-kawy-nadodrze/${name}`);
const price = (degree: 3 | 6 | 9) => `${degreePriceZl[degree]}${nbsp}zł`;
const bagUnit = `za worek ${numbers.bagGrams}${nbsp}g`;
---

<Layout
  title="Palarnia Kawy Nadodrze, Wrocław"
  description="Mała palarnia kawy z Nadodrza we Wrocławiu. Palę małe partie, każdy worek ma numer i datę palenia. Zamów w sklepie i odbierz w palarni."
  path="/palarnia-kawy-nadodrze/"
  bundles={['home', 'map']}>
  <section class="hero" id="start" aria-labelledby="hero-t">
    <h1 class="hero-word" id="hero-t">
      <picture>
        <img
          src={img('word-desk-1x.webp')}
          srcset={`${img('word-desk-1x.webp')} 1440w, ${img('word-desk-2x.webp')} 2880w`}
          sizes="100vw"
          width="1440"
          height="640"
          alt="Kawa. Napis ułożony z prawdziwych ziaren kawy."
          fetchpriority="high"
        />
      </picture>
    </h1>
    <div class="hero-notes">
      <p class="note note-place">
        <span
          class="hand"
          data-hand="mała palarnia|nad Odrą na Nadodrzu"
          data-read="Mała palarnia nad Odrą, na Nadodrzu">
          Mała palarnia nad Odrą, na Nadodrzu
        </span>
      </p>
      <p class="note note-type">
        Palę małe partie, od jasnego po ciemne palenie, z ziarna od dziewięciu plantacji. Każdy
        worek dostaje numer partii i datę palenia.
      </p>
      <a class="cta" href={link('/palarnia-kawy-nadodrze/sklep/')}>
        <span class="hand" data-hand="zobacz kawy">
          zobacz kawy
        </span>
      </a>
      <p class="note note-batch hand" data-hand={`partia ${numbers.currentFiltrBatch}, filtr`}>
        partia {numbers.currentFiltrBatch}, filtr
      </p>
    </div>
  </section>

  <section class="sec coffees" id="kawy" aria-labelledby="kawy-t">
    <div class="coffees-head">
      <h2 id="kawy-t" class="hand hand-xl" data-hand="Co dziś palę">
        Co dziś palę
      </h2>
      <p class="typed typed-side">
        Skala palenia ma {numbers.scaleSteps} stopni, od jasnego do ciemnego. Dziś palę trzy: 3, 6 i
        9. Każdą kawę stawiam na jednym z nich i go nie ruszam.
      </p>
    </div>

    <div class="scale" role="group" aria-label="Skala palenia od 1 do 12">
      <picture>
        <source
          media="(max-width: 699px)"
          srcset={`${img('scale-grid-1x.webp')} 788w, ${img('scale-grid-2x.webp')} 1576w`}
          sizes="100vw"
          width="788"
          height="372"
        />
        <img
          src={img('scale-row-1x.webp')}
          srcset={`${img('scale-row-1x.webp')} 1433w, ${img('scale-row-2x.webp')} 2866w`}
          sizes="100vw"
          width="1433"
          height="135"
          alt="Dwanaście ziaren kawy, od jasnych po ciemne"
        />
      </picture>
      <span class="mark mark-lo hand" data-hand="jasne" aria-hidden="true">
        jasne
      </span>
      <span class="mark mark-hi hand" data-hand="ciemne" aria-hidden="true">
        ciemne
      </span>
      <ol class="scale-nums" aria-label="Stopnie palenia">
        {scale.map(step => (
          <li class={highlighted.includes(step) ? 'on' : undefined}>{step}</li>
        ))}
      </ol>
    </div>

    <div class="stairs">
      <article class="pick pick-3" aria-labelledby="c-filtr">
        <svg
          class="stem"
          viewBox="0 0 30 100"
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false">
          <path d="M15 0C8 28 22 62 15 100"></path>
        </svg>
        <p class="pick-deg hand" data-hand="stopień 3 z 12">
          stopień 3 z 12
        </p>
        <h3 id="c-filtr" class="hand hand-m" data-hand="Filtr">
          Filtr
        </h3>
        <p class="typed">
          Jasne palenie. Jaśmin, brzoskwinia i herbaciana lekkość. Ziarno z Etiopii i Kenii, na
          przelew i drip.
        </p>
        <p class="price hand" data-hand={price(3)}>
          {price(3)}
        </p>
        <p class="price-unit typed">{bagUnit}</p>
        <a
          class="more hand"
          href={link('/palarnia-kawy-nadodrze/sklep/?stopien=3')}
          data-hand="kawy do filtra">
          kawy do filtra
        </a>
      </article>

      <article class="pick pick-6" aria-labelledby="c-abo">
        <svg
          class="stem"
          viewBox="0 0 30 100"
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false">
          <path d="M15 0C22 30 8 66 15 100"></path>
        </svg>
        <p class="pick-deg hand" data-hand="stopień 6 z 12">
          stopień 6 z 12
        </p>
        <h3 id="c-abo" class="hand hand-m" data-hand="Abonament">
          Abonament
        </h3>
        <p class="typed">
          Średnie palenie. Orzech, karmel i kakao, ziarno z Kolumbii. Co tydzień odbierasz świeży
          worek, a ja piszę na nim datę palenia.
        </p>
        <p class="price hand" data-hand={price(6)}>
          {price(6)}
        </p>
        <p class="price-unit typed">{bagUnit}, co tydzień</p>
        <a
          class="more hand"
          href={link('/palarnia-kawy-nadodrze/subskrypcja/')}
          data-hand="zamów abonament">
          zamów abonament
        </a>
      </article>

      <article class="pick pick-9" aria-labelledby="c-esp">
        <svg
          class="stem"
          viewBox="0 0 30 100"
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false">
          <path d="M15 0C9 34 21 58 15 100"></path>
        </svg>
        <p class="pick-deg hand" data-hand="stopień 9 z 12">
          stopień 9 z 12
        </p>
        <h3 id="c-esp" class="hand hand-m" data-hand="Espresso">
          Espresso
        </h3>
        <p class="typed">
          Ciemniejsze palenie. Czekolada, orzech i karmel, gęsta pianka. Ziarno z Brazylii i
          Gwatemali, do ekspresu i kawiarki.
        </p>
        <p class="price hand" data-hand={price(9)}>
          {price(9)}
        </p>
        <p class="price-unit typed">{bagUnit}</p>
        <a
          class="more hand"
          href={link('/palarnia-kawy-nadodrze/sklep/?stopien=9')}
          data-hand="kawy do espresso">
          kawy do espresso
        </a>
      </article>

      <div class="stairs-foot">
        <figure class="photo bag">
          <picture>
            <source
              type="image/webp"
              srcset={`${img('bag-1x.webp')} 520w, ${img('bag-2x.webp')} 1040w`}
              sizes="(max-width: 699px) 80vw, 320px"
            />
            <img
              src={img('bag-1x.webp')}
              width="520"
              height="228"
              alt="Papierowy worek na kawę z okienkiem, bez etykiety, zdjęcie poglądowe"
              loading="lazy"
            />
          </picture>
          <figcaption class="typed">
            Zdjęcie poglądowe: papierowy worek z okienkiem. Etykietę z numerem partii i datą palenia
            naklejam osobno przy pakowaniu.
          </figcaption>
        </figure>
        <div class="order">
          <p class="stairs-note typed">
            Ceny brutto. Zamawiasz w sklepie, telefonem albo mailem, odbierasz w palarni i płacisz
            przy odbiorze. Wysyłki nie robię.
          </p>
          <p class="order-links">
            <a class="order-link typed" href={link('/palarnia-kawy-nadodrze/sklep/')}>
              Wejdź do sklepu
            </a>
            <a class="order-link typed" href={business.phoneHref}>
              Zadzwoń: {business.phone}
            </a>
            <a class="order-link typed" href={`mailto:${business.email}?subject=Zam%C3%B3wienie`}>
              Napisz: {business.email}
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec roast kraft" id="palimy" aria-labelledby="palimy-t">
    <div class="roast-head">
      <h2 id="palimy-t" class="hand hand-xl" data-hand="Jak palę">
        Jak palę
      </h2>
      <p class="typed typed-side">
        Palarnia na Nadodrzu. Krzywą każdej kawy zapisuję i trzymam się jej co do sekundy.
      </p>
    </div>
    <div class="roast-grid">
      <figure class="curve" aria-label="Wykres krzywej palenia">
        <div class="curve-plot">
          <svg class="curve-draw" viewBox="0 0 900 420" aria-hidden="true" focusable="false">
            <g filter="url(#hand-rough)">
              <g class="axes">
                <path d="M60 380C300 383 600 378 870 381"></path>
                <path d="M64 384C62 260 66 140 63 14"></path>
                <path d="M52 370L74 370M52 308L74 308M52 215L74 215M52 123L74 123M52 30L74 30"></path>
              </g>
              <g class="guides">
                <path d="M76 308L672 308"></path>
                <path d="M76 123L822 123"></path>
              </g>
              <path
                class="line2"
                d="M72 367C232 363 522 340 693 313C761 302 802 205 842 128"></path>
              <path class="line" d="M70 362C230 358 520 335 691 308C759 297 800 200 840 123"></path>
              <g class="rings">
                <path d="M705 306C704 294 689 290 679 297C671 306 680 323 694 323C707 321 709 308 701 295"></path>
                <path d="M854 121C853 109 838 105 828 112C820 121 829 138 843 138C856 136 858 123 850 110"></path>
              </g>
              <g class="arrows">
                <path d="M128 312C112 328 100 340 88 349M82 334L88 351L103 344"></path>
                <path d="M652 236C672 252 686 270 692 288M680 284L692 292L696 277"></path>
              </g>
            </g>
          </svg>
          <span class="ytitle hand" data-hand="stopień palenia" aria-hidden="true">
            stopień palenia
          </span>
          <span class="ylab y12 hand" data-hand="12" aria-hidden="true">
            12
          </span>
          <span class="ylab y9 hand" data-hand="9" aria-hidden="true">
            9
          </span>
          <span class="ylab y6 hand" data-hand="6" aria-hidden="true">
            6
          </span>
          <span class="ylab y3 hand" data-hand="3" aria-hidden="true">
            3
          </span>
          <span class="ylab y1 hand" data-hand="1" aria-hidden="true">
            1
          </span>
          <span class="xlab x0 hand" data-hand="0:00" aria-hidden="true">
            0:00
          </span>
          <span class="xlab x1 hand" data-hand="7:40" aria-hidden="true">
            7:40
          </span>
          <span class="xlab x2 hand" data-hand="9:30" aria-hidden="true">
            9:30
          </span>
        </div>
        <div class="curve-notes">
          <div class="cnote cn-a">
            <p class="cn-title hand" data-hand="Zielone ziarno">
              Zielone ziarno
            </p>
            <p class="typed">
              Każdą partię najpierw próbuję. Kupuję od dziewięciu plantacji i wracam do tych samych
              rolników.
            </p>
          </div>
          <div class="cnote cn-b">
            <p class="cn-title hand" data-hand="7:40, pierwszy trzask">
              7:40, pierwszy trzask
            </p>
            <p class="typed">Tu wyjmuję filtr, stopień 3. Ziarno pachnie jeszcze herbatą.</p>
          </div>
        </div>
        <p class="sr-only">
          Stopień palenia rośnie w czasie, od 0:00 do 9:30. Opisy etapów stoją obok wykresu.
        </p>
      </figure>
      <div class="roast-aside">
        <div class="cnote cn-c">
          <p class="cn-title hand" data-hand="9:30, koniec">
            9:30, koniec
          </p>
          <p class="typed">
            Espresso kończę na stopniu 9. Potem kawa odpoczywa {numbers.restDays} dni i dopiero
            wtedy jedzie do worka.
          </p>
        </div>
        <div class="roaster">
          <p class="roaster-name hand" data-hand={roaster.name}>
            {roaster.name}
          </p>
          <p class="typed">
            Palacz. Od ośmiu lat stoję przy piecu, mam certyfikat {roaster.certificate}. Każdą
            krzywą pilnuję sam.
          </p>
        </div>
        <p class="typed roast-year">
          W tym roku wyszło {numbers.batchesThisYear} partii po {numbers.batchKg}&nbsp;kilogramów.
          Numer partii znajdziesz na etykiecie worka.
          <a class="credits-link" href={link('/palarnia-kawy-nadodrze/o-palarni/')}>
            Więcej o palarni
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="sec recipe" id="przepis" aria-labelledby="przepis-t">
    <div class="recipe-head">
      <h2 id="przepis-t" class="hand hand-xl" data-hand="Tak parzę">
        Tak parzę
      </h2>
    </div>
    <div class="recipe-grid">
      <div class="sheet-wrap">
        <article class="sheet" aria-label="Odręczna notatka z przepisami">
          <ul class="rec">
            {recipeList.map(recipe => (
              <li>
                <div class="rec-head">
                  <h3 class="hand hand-m" data-hand={recipe.title}>
                    {recipe.title}
                  </h3>
                  <span class="rec-deg hand" data-hand={`stopień ${recipe.degree}`}>
                    stopień {recipe.degree}
                  </span>
                </div>
                <p class="rec-line hand" data-hand={recipe.line}>
                  {recipe.line}
                </p>
                <p class="typed">{recipe.grind}</p>
              </li>
            ))}
          </ul>
          <p class="sheet-foot hand" data-hand={waterNote}>
            {waterNote}
          </p>
        </article>
      </div>
      <p class="typed recipe-side">Ta kartka wisi u mnie przy młynku. {timeNote}</p>
    </div>
  </section>

  <section class="sec visit" id="kontakt" aria-labelledby="kontakt-t">
    <div class="visit-head">
      <h2 id="kontakt-t" class="hand hand-xl" data-hand="Wpadnij|na filiżankę">
        Wpadnij na filiżankę
      </h2>
      <figure class="photo shop">
        <picture>
          <source
            type="image/webp"
            srcset={`${img('shop-1x.webp')} 560w, ${img('shop-2x.webp')} 1120w`}
            sizes="(max-width: 699px) 80vw, 460px"
          />
          <img
            src={img('shop-1x.webp')}
            width="560"
            height="453"
            alt="Półki ze słojami pełnymi ziarna kawy w amerykańskiej palarni, zdjęcie poglądowe"
            loading="lazy"
          />
        </picture>
        <figcaption class="typed">
          Zdjęcie poglądowe: półki ze słojami w amerykańskiej palarni, nie w naszej. Etykiety na
          słojach są po angielsku.
        </figcaption>
      </figure>
    </div>
    <div class="contact">
      <div class="ring">
        <img
          class="ring-img"
          src={img('stain.webp')}
          width="820"
          height="598"
          alt=""
          loading="lazy"
        />
        <div class="ring-in">
          <p class="status hand" id="chip-text" role="status" data-hand="Godziny otwarcia">
            Godziny otwarcia
          </p>
          <dl class="hours">
            {openingRows.map(([day, hours]) => (
              <div>
                <dt>{day}</dt>
                <dd class="hand" data-hand={hours}>
                  {hours}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <div class="contact-side">
        <p class="typed contact-lead">
          Wpadnij po worek albo na espresso przy ladzie. Napisz, co lubisz pić, dobiorę kawę.
        </p>
        <dl class="contact-lines">
          <div>
            <dt>Adres</dt>
            <dd>
              <span class="addr-line">{business.street}</span>
              <span class="addr-line">
                {business.postcode} {business.city}
              </span>
            </dd>
          </div>
          <div>
            <dt>Telefon</dt>
            <dd>
              <a href={business.phoneHref}>{business.phone}</a>
            </dd>
          </div>
          <div>
            <dt>E-mail</dt>
            <dd>
              <a href={`mailto:${business.email}`}>{business.email}</a>
            </dd>
          </div>
        </dl>
        <a class="credits-link" href={link('/palarnia-kawy-nadodrze/kontakt/')}>
          Dojazd i formularz
        </a>
      </div>

      <NeighbourhoodMap />
    </div>
  </section>
</Layout>
