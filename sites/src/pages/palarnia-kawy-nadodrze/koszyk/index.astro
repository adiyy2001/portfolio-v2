---
import Layout from '../../../sites/palarnia-kawy-nadodrze/Layout.astro';
import CartPage from '../../../sites/palarnia-kawy-nadodrze/islands/CartPage';
---

<Layout
  title="Koszyk"
  description="Twój koszyk w palarni. Sprawdź worki, wybierz mielenie i przejdź do kasy. Odbiór w palarni na Nadodrzu, płatność przy odbiorze."
  path="/palarnia-kawy-nadodrze/koszyk/"
  current="koszyk"
  bundles={['cart']}>
  <div class="page-head">
    <h1 class="hand" data-hand="Koszyk">
      Koszyk
    </h1>
  </div>
  <CartPage client:load />
  <noscript>
    <p class="cart-loading">Koszyk potrzebuje JavaScriptu, bo trzyma worki w tej przeglądarce.</p>
  </noscript>
</Layout>
