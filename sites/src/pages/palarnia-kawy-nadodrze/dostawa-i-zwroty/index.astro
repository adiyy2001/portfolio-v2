---
import { link } from '../../../shared/link';
import Layout from '../../../sites/palarnia-kawy-nadodrze/Layout.astro';
import {
  business,
  degreePriceZl,
  numbers,
  openingRows,
  pickupWindows,
  subscriptionTerms,
} from '../../../sites/palarnia-kawy-nadodrze/data/site';

const nbsp = '\u00a0';
const windowText = (list: Array<[number, number]>) =>
  list.map(([from, to]) => `${from}:00 do ${to}:00`).join(', ');
---

<Layout
  title="Odbiór i zwroty"
  description="Jak odebrać zamówienie w palarni na Nadodrzu, kiedy płacisz i co zrobić, gdy kawa ci nie smakuje. Wysyłki nie ma. Zasady abonamentu."
  path="/palarnia-kawy-nadodrze/dostawa-i-zwroty/"
  current="dostawa"
  bundles={['info']}>
  <div class="page-head">
    <h1 class="hand" data-hand="Odbiór" data-read="Odbiór i zwroty">
      Odbiór
    </h1>
    <p class="typed page-head__lead">Wysyłki nie robię. Zamówienie odbierasz w palarni.</p>
  </div>
  <div class="info">
    <div class="info__main">
      <div class="prose">
        <h2>Jak to działa</h2>
        <ol class="steps">
          <li>Wybierasz kawy w sklepie i dodajesz je do koszyka.</li>
          <li>W kasie wybierasz dzień i okno odbioru, a ja przygotowuję worki.</li>
          <li>
            Odbierasz je w palarni przy {business.street} i płacisz przy odbiorze, gotówką albo
            kartą. Nic nie płacisz w sieci.
          </li>
        </ol>
        <p>
          Cena worka {numbers.bagGrams}
          {nbsp}g to {degreePriceZl[3]}
          {nbsp}zł dla stopnia 3, {degreePriceZl[6]}
          {nbsp}zł dla stopnia 6 i {degreePriceZl[9]}
          {nbsp}zł dla stopnia 9. Nie ma kodów rabatowych ani opłat dodatkowych.
        </p>
      </div>
      <div class="prose">
        <h2>Okna odbioru</h2>
        <ul>
          <li>Od poniedziałku do piątku: {windowText(pickupWindows.weekday)}.</li>
          <li>W soboty: {windowText(pickupWindows.saturday)}.</li>
          <li>W niedziele i święta palarnia jest zamknięta.</li>
        </ul>
        <p>Worek czeka w palarni od następnego dnia otwarcia po złożeniu zamówienia.</p>
      </div>
      <div class="prose">
        <h2>Zwroty i reklamacje</h2>
        <p>
          Jeśli kawa ci nie smakuje albo coś jest nie tak z workiem, napisz albo zadzwoń w ciągu 7
          dni od odbioru. Wymienię worek na inny albo oddam pieniądze, a nieotwarty worek możesz
          przynieść z powrotem w godzinach otwarcia.
        </p>
        <p>
          Kontakt: <a href={`mailto:${business.email}`}>{business.email}</a> lub{' '}
          <a href={business.phoneHref}>{business.phone}</a>.
        </p>
      </div>
      <div class="prose">
        <h2>Abonament</h2>
        <p>
          Abonament to co tydzień od 1 do {subscriptionTerms.maxBags} worków ze stopnia{' '}
          {subscriptionTerms.degree}, bez minimalnego okresu. Zmiany i rezygnację zgłaszasz{' '}
          {subscriptionTerms.cutoff}. Pełne zasady są{' '}
          <a href={link('/palarnia-kawy-nadodrze/subskrypcja/#zasady')}>na stronie abonamentu</a>.
        </p>
      </div>
    </div>
    <div class="info__aside">
      <div class="card card--tilt hours-card">
        <h2>Godziny otwarcia</h2>
        <dl class="facts">
          {openingRows.map(([day, hours]) => (
            <div>
              <dt>{day}</dt>
              <dd>{hours}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="card">
        <h2>Gdzie odbierasz</h2>
        <p>
          {business.street}
          <br />
          {business.postcode} {business.city}
        </p>
      </div>
    </div>
  </div>
</Layout>
