---
import { assetUrl } from '../shared/manifest';
import { identityBrands } from '../../shared/sites';

interface Props {
  href: string;
}

const { href } = Astro.props;
const meta = identityBrands.find(item => item.slug === 'nosna')!;
---

<a class="nosna-tile" href={href}>
  <span class="nosna-tile__bar" aria-hidden="true"></span>
  <img
    class="nosna-tile__logo"
    src={assetUrl('nosna', 'logo/nosna-negative.svg')}
    alt=""
    width="600"
    height="392"
  />
  <span class="nosna-tile__style">{meta.style}</span>
  <span class="nosna-tile__name">{meta.name}</span>
  <span class="nosna-tile__trade">
    {meta.trade}, {meta.city}
  </span>
  <span class="nosna-tile__go">Zobacz identyfikację</span>
</a>

<style is:global>
  .nosna-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-height: 260px;
    padding: 24px 24px 22px;
    background: #0e0e12;
    color: #e9e6de;
    text-decoration: none;
    border-top: 10px solid #ff3d1f;
    transition: border-color 0.2s ease;
  }

  .nosna-tile:hover,
  .nosna-tile:focus-visible {
    border-top-color: #ff2d95;
  }

  .nosna-tile__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background: linear-gradient(90deg, #ff3d1f 33%, #00b3a4 33% 66%, #ff2d95 66%);
  }

  .nosna-tile__logo {
    width: 170px;
    height: auto;
    align-self: flex-start;
    margin-bottom: 8px;
  }

  .nosna-tile__style {
    font:
      700 12px/1.3 ui-monospace,
      Menlo,
      Consolas,
      monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .nosna-tile__name {
    font:
      800 30px/1.1 system-ui,
      'Segoe UI',
      Arial,
      sans-serif;
  }

  .nosna-tile__trade {
    font-size: 15px;
  }

  .nosna-tile__go {
    margin-top: auto;
    padding-top: 12px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .nosna-tile {
      transition: none;
    }
  }
</style>
