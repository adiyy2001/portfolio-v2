---
import { link, portfolio } from '../../shared/link';
import ColorTable from '../shared/ColorTable.astro';
import ContrastTable from '../shared/ContrastTable.astro';
import Downloads from '../shared/Downloads.astro';
import SampleLine from '../shared/SampleLine.astro';
import Shell from '../shared/Shell.astro';
import { fontFaceCss, preloadFonts } from '../shared/fonts';
import { formatBytes } from '../shared/format';
import { readManifest } from '../shared/manifest';
import Generator from './Generator.tsx';
import { brand } from './brand';
import { content, contact, extras } from './content';
import { primaryVariant } from './lib/field';
import { css } from './styles';
import { asset, fileInfo, gridCells, ink, iconNames, logoVariants, sizeTest } from './view';

const manifest = readManifest('nosna');
const colors = manifest.palette;
const icons = iconNames(manifest);
const zip = manifest.zip;
const mockups = content.applications.map(item => ({
  ...item,
  info: fileInfo(manifest, item.image),
}));
const posts = extras.social.map(item => ({
  ...item,
  path: `social/nosna-${item.id}.png`,
}));
const fontCss = fontFaceCss(manifest);
const days = [
  { id: 'piatek', name: 'Piątek', sub: 'Zadanie, kierunek, proces', text: 'piatek-tekst' },
  { id: 'sobota', name: 'Sobota', sub: 'System i generator', text: 'sobota-tekst' },
  {
    id: 'niedziela',
    name: 'Niedziela',
    sub: 'Animacja, zastosowania, pliki',
    text: 'niedziela-tekst',
  },
] as const;
const dayStyle = (index: number) =>
  `--day:var(--${days[index].id});--day-text:var(--${days[index].text})`;
---

<Shell
  brand={brand}
  title="Identyfikacja wizualna festiwalu sztuki nowych mediów"
  description="Generatywna identyfikacja zmyślonego festiwalu Nośna z Łodzi: stały napis i linia nośna oraz pole, które powstaje z dnia, sceny i tempa. Z generatorem, plikami do druku, animacją i brand bookiem."
  css={fontCss + css}
  preload={preloadFonts(manifest, ['display'])}
  bodyClass="nosna">
  <header class="rail">
    <a href={link('/identyfikacja/')}>Wzornik, identyfikacja</a>
    <a href={portfolio('/dla-klienta/#wzornik')}>Wróć do portfolio</a>
  </header>

  <main id="main" tabindex="-1">
    <section class="hero" aria-labelledby="t-hero">
      <div class="wrap">
        <p class="kicker">Identyfikacja wizualna, festiwal sztuki nowych mediów, Łódź</p>
        <h1 id="t-hero">Nośna</h1>
        <p class="hero__lead">{content.lead}</p>
        <ul class="hero__nav" aria-label="Spis treści">
          {days.map(day => (
            <li>
              <a href={`#${day.id}`}>
                <i style={`background:var(--${day.id})`}></i>
                {day.name}: {day.sub}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="wrap" style="margin-top:clamp(24px,4vw,44px)">
        <Generator client:visible initial={primaryVariant} ink={ink} />
      </div>
    </section>

    <section class="day" id="piatek" aria-labelledby="t-piatek" style={dayStyle(0)}>
      <div class="day__head">
        <div class="wrap">
          <h2 id="t-piatek">Piątek</h2>
          <p>{days[0].sub}</p>
        </div>
      </div>
      <div class="wrap">
        <div class="row">
          <div class="row__label">
            <span class="row__no">01</span>
            <h3>Klient i zadanie</h3>
          </div>
          <div class="row__body two">
            <div class="prose">
              {content.client.paragraphs.map(text => (
                <p>{text}</p>
              ))}
            </div>
            <dl class="facts">
              {content.client.facts.map(([term, text]) => (
                <div>
                  <dt>{term}</dt>
                  <dd>{text}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>

        <div class="row">
          <div class="row__label">
            <span class="row__no">02</span>
            <h3>Kierunek i strategia</h3>
          </div>
          <div class="row__body">
            <h4 class="mono muted">{content.direction.title}</h4>
            <div class="prose">
              {content.direction.paragraphs.map(text => (
                <p>{text}</p>
              ))}
            </div>
            <p class="keywords">
              {content.direction.keywords.map(word => (
                <span>{word}</span>
              ))}
            </p>
            <div class="cols three">
              {content.strategy.values.map(value => (
                <article class="col">
                  <h4>{value.title}</h4>
                  <p>{value.text}</p>
                </article>
              ))}
            </div>
            <dl class="facts">
              <div>
                <dt>Odbiorcy</dt>
                <dd>{content.strategy.audience}</dd>
              </div>
              <div>
                <dt>Osobowość</dt>
                <dd>{content.strategy.personality.join(', ')}</dd>
              </div>
              <div>
                <dt>Czego unikamy</dt>
                <dd>{content.strategy.avoids}</dd>
              </div>
            </dl>
            <blockquote>{content.strategy.positioning}</blockquote>
          </div>
        </div>

        <div class="row">
          <div class="row__label">
            <span class="row__no">03</span>
            <h3>Proces</h3>
          </div>
          <div class="row__body">
            <p class="prose">{content.process.intro}</p>
            <div class="cols three">
              {content.process.rejected.map(item => (
                <article class="col">
                  <img src={asset(item.thumb)} alt="" width="200" height="200" loading="lazy" />
                  <h4>{item.title}</h4>
                  <p class="muted">{item.text}</p>
                  <p>{item.reason}</p>
                </article>
              ))}
              <article class="col col--chosen">
                <img
                  src={asset('figures/direction-nosna.svg')}
                  alt=""
                  width="200"
                  height="200"
                  loading="lazy"
                />
                <h4>{content.process.chosen.title}</h4>
                <p>{content.process.chosen.reason}</p>
              </article>
            </div>
            <div class="two two--even">
              <div class="prose">
                <h4>Ręczny kerning</h4>
                <p>{content.process.refinement[0].text}</p>
              </div>
              <div class="kern">
                <figure>
                  <img
                    src={asset('figures/wordmark-default.svg')}
                    alt="Napis Nośna bez korekty kerningu"
                    width="320"
                    height="190"
                    loading="lazy"
                  />
                  <figcaption>Bez korekty</figcaption>
                </figure>
                <figure>
                  <img
                    src={asset('figures/wordmark-kerned.svg')}
                    alt="Napis Nośna po ręcznej korekcie kerningu"
                    width="320"
                    height="190"
                    loading="lazy"
                  />
                  <figcaption>Po korekcie</figcaption>
                </figure>
              </div>
            </div>
            <div class="prose">
              <h4>Wyrównania optyczne i test czytelności</h4>
              <p>{content.process.refinement[1].text}</p>
              <p>{content.process.refinement[2].text}</p>
            </div>
            <ul class="sizes">
              {sizeTest.map(item => (
                <li>
                  <img
                    src={asset(item.src)}
                    alt=""
                    width={item.size}
                    height={item.size}
                    style={`width:${item.size}px;height:${item.size}px`}
                  />
                  <span>{item.label}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="day" id="sobota" aria-labelledby="t-sobota" style={dayStyle(1)}>
      <div class="day__head">
        <div class="wrap">
          <h2 id="t-sobota">Sobota</h2>
          <p>{days[1].sub}</p>
        </div>
      </div>
      <div class="wrap">
        <div class="row">
          <div class="row__label">
            <span class="row__no">04</span>
            <h3>Logo jako system</h3>
          </div>
          <div class="row__body">
            <div class="two two--even">
              <div class="prose">
                <h4>Co stałe</h4>
                <ul class="constants">
                  {extras.constants.map(item => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
              <figure class="clear">
                <img
                  src={asset('figures/days-envelope.svg')}
                  alt="Trzy obwiednie pola: piątek z szczytem na początku, sobota symetryczna, niedziela ze szczytem na końcu"
                  width="600"
                  height="200"
                  loading="lazy"
                />
              </figure>
            </div>
            <ul class="variants">
              {logoVariants.map(variant => (
                <li class={`ground ground--${variant.ground}`}>
                  <img
                    src={asset(`logo/nosna-${variant.id}.svg`)}
                    alt={`Logo Nośna, wersja ${variant.name.toLowerCase()}`}
                    width="240"
                    height="160"
                    loading="lazy"
                  />
                  <p>
                    <strong>{variant.name}</strong>
                    <span>{variant.note}</span>
                  </p>
                </li>
              ))}
            </ul>
            <div class="two two--even">
              <figure class="clear">
                <img
                  src={asset('figures/clearspace.svg')}
                  alt="Logo główne otoczone polem ochronnym równym wysokości litery N"
                  width="600"
                  height="400"
                  loading="lazy"
                />
              </figure>
              <div class="prose">
                <h4>Pole ochronne i rozmiary</h4>
                <p>{extras.clearSpace}</p>
                <ul class="plain">
                  <li>Sygnet: {extras.minimum.symbol}.</li>
                  <li>Logo z napisem: {extras.minimum.fullStamp}.</li>
                  <li>Logo główne: {extras.minimum.primary}.</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <div class="row">
          <div class="row__label">
            <span class="row__no">05</span>
            <h3>Dwanaście pól</h3>
          </div>
          <div class="row__body">
            <p class="prose">
              Dwanaście kombinacji trzech dni i czterech scen, każda przy tempie wyjściowym sceny.
              Czyta się je jako jedną markę, bo zawsze mają tę samą nośną, ten sam pierścień i tę
              samą grubość nitki. Każde pole można pobrać jako osobny plik SVG.
            </p>
            <ul class="grid12">
              {gridCells.map(cell => (
                <li>
                  <svg
                    viewBox={cell.viewBox}
                    role="img"
                    aria-label={cell.name}
                    set:html={cell.markup}
                  />
                  <span>
                    <a href={asset(cell.file)} download>
                      {cell.name}
                    </a>
                  </span>
                </li>
              ))}
            </ul>
            <ul class="params">
              {extras.rules.map(rule => (
                <li>
                  <b>{rule.parameter}</b>
                  <em>{rule.sets}</em>
                  <span>{rule.text}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="row">
          <div class="row__label">
            <span class="row__no">06</span>
            <h3>Kolor</h3>
          </div>
          <div class="row__body">
            <ul class="swatches">
              {colors.map(color => (
                <li>
                  <span class="swatches__chip" style={`background:${color.hex}`}></span>
                  <strong>{color.name}</strong>
                  <span>{color.hex}</span>
                  <em>{color.role}</em>
                </li>
              ))}
            </ul>
            <ColorTable colors={colors} />
            <h4>Kontrast</h4>
            <p class="muted">
              Każda para tekstu i tła w systemie ma policzony stosunek kontrastu. Teksty spełniają
              WCAG AA, a barwy dni na kości służą wyłącznie jako dekoracja, więc w tekście na jasnym
              tle używamy ich ciemnych odpowiedników.
            </p>
            <ContrastTable pairs={manifest.contrast} />
          </div>
        </div>

        <div class="row">
          <div class="row__label">
            <span class="row__no">07</span>
            <h3>Typografia</h3>
          </div>
          <div class="row__body">
            <div class="two two--even">
              <div class="face">
                <p class="face__name face__name--display">Syne</p>
                <p class="face__sample face__sample--display">{extras.specimen}</p>
                <p class="muted">Nagłówki i napis. Grubości 500, 700 i 800. Licencja OFL.</p>
              </div>
              <div class="face">
                <p class="face__name face__name--mono">Martian Mono</p>
                <p class="face__sample face__sample--mono">{extras.specimen}</p>
                <p class="muted">
                  Parametry, godziny i ziarna. Grubości 400, 500 i 700. Licencja OFL.
                </p>
              </div>
            </div>
            <ul class="scale">
              {extras.typeScale.map(row => (
                <li>
                  <span
                    class={`scale__sample scale__sample--${row.font}`}
                    style={`font-size:${Math.min(row.size, 40)}px;font-weight:${row.weight}`}>
                    {row.name}
                  </span>
                  <span class="muted">
                    {row.size} px, interlinia {String(row.line).replace('.', ',')}. {row.use}
                  </span>
                </li>
              ))}
            </ul>
            <p class="glyphs">{extras.glyphs}</p>
          </div>
        </div>

        <div class="row">
          <div class="row__label">
            <span class="row__no">08</span>
            <h3>Ikony i wzór</h3>
          </div>
          <div class="row__body">
            <ul class="icons">
              {icons.map(name => (
                <li>
                  <img
                    src={asset(`icons/svg/nosna-icon-${name}.svg`)}
                    alt=""
                    width="40"
                    height="40"
                    loading="lazy"
                  />
                  <span>{name}</span>
                </li>
              ))}
            </ul>
            <div
              class="pattern"
              role="img"
              aria-label="Wzór z dwunastu przesuniętych w fazie fal, jedna na cztery w kolorze piątku"
              style={`background-image:url(${asset('pattern/nosna-pattern.svg')})`}></div>
            <div class="cols three">
              {extras.graphics.map(item => (
                <article class="col">
                  <h4>{item.title}</h4>
                  <p>{item.text}</p>
                </article>
              ))}
            </div>
            <ul class="plain plain--rules">
              {extras.layoutRules.map(rule => (
                <li>{rule}</li>
              ))}
            </ul>
          </div>
        </div>

        <div class="row">
          <div class="row__label">
            <span class="row__no">09</span>
            <h3>Zdjęcia i ton głosu</h3>
          </div>
          <div class="row__body">
            <p class="prose">{extras.photoStyle}</p>
            <div class="tone">
              {content.tone.map(rule => (
                <article>
                  <h4>{rule.title}</h4>
                  <p>{rule.text}</p>
                  <p class="yes">
                    <span class="tag">Tak</span>
                    {rule.yes}
                  </p>
                  <p class="no">
                    <span class="tag">Nie</span>
                    {rule.no}
                  </p>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="day" id="niedziela" aria-labelledby="t-niedziela" style={dayStyle(2)}>
      <div class="day__head">
        <div class="wrap">
          <h2 id="t-niedziela">Niedziela</h2>
          <p>{days[2].sub}</p>
        </div>
      </div>
      <div class="wrap">
        <div class="row">
          <div class="row__label">
            <span class="row__no">10</span>
            <h3>Animacja</h3>
          </div>
          <div class="row__body">
            <p class="prose">{extras.animation}</p>
            <video
              class="film"
              controls
              muted
              loop
              playsinline
              preload="metadata"
              width="1080"
              height="1080">
              <source src={`${asset('animation/nosna-logo.webm')}#t=2.9`} type="video/webm" />
              <source src={`${asset('animation/nosna-logo.mp4')}#t=2.9`} type="video/mp4" />
              <img
                class="film-fallback"
                src={asset('logo/nosna-negative.svg')}
                alt="Logo Nośna, wersja nieruchoma"
                width="600"
                height="392"
              />
            </video>
          </div>
        </div>

        <div class="row">
          <div class="row__label">
            <span class="row__no">11</span>
            <h3>Użycie w praktyce</h3>
          </div>
          <div class="row__body">
            <div class="gallery">
              {mockups.map(item => (
                <figure class={`gallery__item gallery__item--${item.id}`}>
                  <img
                    src={asset(item.image)}
                    alt={item.alt}
                    width={item.info?.width}
                    height={item.info?.height}
                    loading="lazy"
                  />
                  <figcaption>
                    <strong>{item.title}</strong>
                    <span>{item.caption}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
            <h4>Media społecznościowe</h4>
            <ul class="posts">
              <li>
                <img
                  src={asset('social/nosna-avatar.png')}
                  alt="Awatar Nośnej: czerwone pole nitek na linii nośnej na ciemnym tle"
                  width="1080"
                  height="1080"
                  loading="lazy"
                />
                <span>Awatar</span>
              </li>
              {posts.map(post => (
                <li>
                  <img
                    src={asset(post.path)}
                    alt={`Post w mediach społecznościowych: ${post.headline}. ${post.body}`}
                    width="1080"
                    height="1350"
                    loading="lazy"
                  />
                  <span>{post.headline}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="row" id="pliki">
          <div class="row__label">
            <span class="row__no">12</span>
            <h3>Pliki do pobrania</h3>
          </div>
          <div class="row__body">
            <p class="prose">{content.deliverables.intro}</p>
            {zip && <p class="muted">Cała paczka waży {formatBytes(zip.bytes)}.</p>}
            <Downloads manifest={manifest} />
            <p class="muted">{content.deliverables.note}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta" aria-labelledby="t-cta">
      <div class="wrap">
        <h2 id="t-cta">{content.cta.title}</h2>
        <p>{content.cta.text}</p>
        <a class="cta__link" href={portfolio('/dla-klienta/#wzornik')}>
          Zobacz ofertę dla klientów
        </a>
      </div>
    </section>
  </main>

  <footer class="foot">
    <SampleLine name={brand.name} />
    <p class="foot__contact">
      {contact.street}, {contact.city}. Dane kontaktowe są zmyślone.
    </p>
  </footer>
</Shell>
