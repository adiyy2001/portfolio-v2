---
import { nbsp } from './lib/typo';

const markup = await Astro.slots.render('default');
const parts = markup.split(/(<script[\s\S]*?<\/script>|<style[\s\S]*?<\/style>)/);
const tied = parts
  .map((part, index) =>
    index % 2 === 1 ? part : part.replace(/>([^<>]+)</g, (_, text) => `>${nbsp(text)}<`),
  )
  .join('');
---

<Fragment set:html={tied} />
