---
interface Props {
  name: string;
  style: string;
  trade: string;
  city: string;
}

const { name, style, trade, city } = Astro.props;
---

<div class="stub">
  <p class="stub__style">{style}</p>
  <p class="stub__name">{name}</p>
  <p class="stub__trade">
    {trade}, {city}
  </p>
  <p class="stub__state">Realizacja w przygotowaniu</p>
</div>
