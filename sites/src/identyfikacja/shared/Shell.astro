---
import { baseCss } from './base';
import { assetUrl, pageUrl } from './manifest';
import type { BrandMeta } from './types';

interface Props {
  brand: BrandMeta;
  title: string;
  description: string;
  css: string;
  preload?: string[];
  bodyClass?: string;
}

const { brand, title, description, css, preload = [], bodyClass } = Astro.props;
const canonical = new URL(pageUrl(brand.slug), Astro.site).href;
const ogImage = new URL(assetUrl(brand.slug, 'og.png'), Astro.site).href;
const fullTitle = `${title} | ${brand.name}`;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={brand.themeColor} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={assetUrl(brand.slug, 'favicon.svg')} />
    <link rel="icon" type="image/x-icon" sizes="48x48" href={assetUrl(brand.slug, 'favicon.ico')} />
    <link rel="apple-touch-icon" href={assetUrl(brand.slug, 'apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={brand.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {preload.map(href => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />
    ))}
    <style set:html={baseCss + css}></style>
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">
      Przejdź do treści
    </a>
    <slot />
  </body>
</html>
