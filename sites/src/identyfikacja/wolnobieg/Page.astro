---
import { link, portfolio } from '../../shared/link';
import ColorTable from '../shared/ColorTable.astro';
import ContrastTable from '../shared/ContrastTable.astro';
import Downloads from '../shared/Downloads.astro';
import SampleLine from '../shared/SampleLine.astro';
import Shell from '../shared/Shell.astro';
import { fontFaceCss, preloadFonts } from '../shared/fonts';
import { formatBytes } from '../shared/format';
import { readManifest } from '../shared/manifest';
import StripeComposer from './StripeComposer.tsx';
import { brand } from './brand';
import { content, contact, extras } from './content';
import { css } from './styles';
import { asset, fileInfo, heroArcs, iconNames, logoVariants, sizeTest } from './view';

const manifest = readManifest('wolnobieg');
const colors = manifest.palette;
const icons = iconNames(manifest);
const zip = manifest.zip;
const mockups = content.applications.map(item => ({
  ...item,
  info: fileInfo(manifest, item.image),
}));
const posts = extras.social.map(item => ({
  ...item,
  path: `social/wolnobieg-${item.id}.png`,
}));
const fontCss = fontFaceCss(manifest);
const navigation = [
  ['zadanie', 'Zadanie'],
  ['kierunek', 'Kierunek'],
  ['proces', 'Proces'],
  ['system', 'System'],
  ['zastosowania', 'Zastosowania'],
  ['pliki', 'Pliki'],
];
const coinTones = ['coin--orange', 'coin--cream', 'coin--brown'];
const picks = [
  ...content.process.rejected.map(item => ({
    title: item.title,
    text: item.text,
    reason: item.reason,
    thumb: item.thumb,
    chosen: false,
  })),
  {
    title: content.process.chosen.title,
    text: '',
    reason: content.process.chosen.reason,
    thumb: 'figures/direction-kolo.svg',
    chosen: true,
  },
];
---

<Shell
  brand={brand}
  title="Identyfikacja wizualna serwisu rowerowego"
  description="Pasy i koło w stylu lat siedemdziesiątych: kompletna identyfikacja zmyślonego serwisu rowerowego Wolnobieg z Gdańska, od strategii i procesu po pliki do druku, animację i brand book."
  css={fontCss + css}
  preload={preloadFonts(manifest, ['display'])}
  bodyClass="wolnobieg">
  <header class="top">
    <a href={link('/identyfikacja/')}>Wzornik, identyfikacja</a>
    <a href={portfolio('/dla-klienta/#wzornik')}>Wróć do portfolio</a>
  </header>

  <nav class="route" aria-label="Spis treści">
    <img class="route__mark" src={asset('favicon.svg')} alt="" width="40" height="40" />
    <ul>
      {navigation.map(([id, label]) => (
        <li>
          <a href={`#${id}`}>{label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <main id="main" tabindex="-1">
    <section class="band band--hero" style="--z:9" aria-labelledby="t-hero">
      <div class="hero__in">
        <div class="hero__head">
          <p class="kicker">Identyfikacja wizualna, serwis i sklep rowerowy, Gdańsk</p>
          <h1 id="t-hero">Wolnobieg</h1>
        </div>
        <div class="hero__text">
          <p class="hero__lead">{content.lead}</p>
          <dl class="hero__facts">
            {content.client.facts.slice(0, 3).map(([term, text]) => (
              <div>
                <dt>{term}</dt>
                <dd>{text}</dd>
              </div>
            ))}
          </dl>
        </div>
        <figure class="hero__art">
          <svg viewBox="0 0 600 600" aria-hidden="true" focusable="false">
            {heroArcs.map(arc => (
              <path d={arc.d} fill={arc.color}></path>
            ))}
            {heroArcs.map(arc => (
              <rect x="598" y={arc.runY} width="900" height="66" fill={arc.color}></rect>
            ))}
          </svg>
          <div class="hero__badge">
            <img
              src={asset('logo/wolnobieg-symbol.svg')}
              alt="Odznaka Wolnobiegu: zębatka z pierścieniami jak koło wolnobiegu"
              width="400"
              height="400"
            />
          </div>
        </figure>
      </div>
    </section>

    <section class="band band--cream" style="--z:8" id="zadanie" aria-labelledby="t-zadanie">
      <div class="wrap">
        <header class="sh">
          <span class="sh__no" aria-hidden="true">
            1
          </span>
          <h2 id="t-zadanie" class="sh__title">
            Klient i zadanie
          </h2>
          <span class="sh__rail" aria-hidden="true"></span>
        </header>
        <div class="task">
          <div class="task__lead prose">
            {content.client.paragraphs.map(text => (
              <p>{text}</p>
            ))}
          </div>
          <dl class="tags">
            {content.client.facts.map(([term, text]) => (
              <div>
                <dt>{term}</dt>
                <dd>{text}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section class="band band--mustard" style="--z:7" id="kierunek" aria-labelledby="t-kierunek">
      <div class="wrap">
        <header class="sh">
          <span class="sh__no" aria-hidden="true">
            2
          </span>
          <h2 id="t-kierunek" class="sh__title">
            Kierunek i strategia
          </h2>
          <span class="sh__rail" aria-hidden="true"></span>
        </header>
        <div class="dir">
          <p class="keywords" aria-label="Trzy słowa klucze">
            {content.direction.keywords.map(word => (
              <span>{word}</span>
            ))}
          </p>
          <div class="dir__text">
            <h3 class="lede">{content.direction.title}</h3>
            <div class="prose">
              {content.direction.paragraphs.map(text => (
                <p>{text}</p>
              ))}
            </div>
          </div>
        </div>
        <ul class="coins">
          {content.strategy.values.map((value, index) => (
            <li class={`coin ${coinTones[index]}`}>
              <h3>{value.title}</h3>
              <p>{value.text}</p>
            </li>
          ))}
        </ul>
        <div class="panel panel--brown strat">
          <dl class="strat__facts">
            <div>
              <dt>Odbiorcy</dt>
              <dd>{content.strategy.audience}</dd>
            </div>
            <div>
              <dt>Osobowość</dt>
              <dd>{content.strategy.personality.join(', ')}</dd>
            </div>
            <div>
              <dt>Czego unikamy</dt>
              <dd>{content.strategy.avoids}</dd>
            </div>
          </dl>
          <blockquote>{content.strategy.positioning}</blockquote>
        </div>
      </div>
    </section>

    <section class="band band--brown" style="--z:6" id="proces" aria-labelledby="t-proces">
      <div class="wrap">
        <header class="sh">
          <span class="sh__no" aria-hidden="true">
            3
          </span>
          <h2 id="t-proces" class="sh__title">
            Proces
          </h2>
          <span class="sh__rail" aria-hidden="true"></span>
        </header>
        <p class="band__lead">{content.process.intro}</p>
        <ol class="picks">
          {picks.map((item, index) => (
            <li class={item.chosen ? 'pick pick--chosen' : 'pick'}>
              <span class="pick__label">{item.chosen ? 'Wybrany' : `Odrzucony ${index + 1}`}</span>
              <span class="pick__img">
                <img src={asset(item.thumb)} alt="" width="200" height="200" loading="lazy" />
              </span>
              <h3>{item.title}</h3>
              {item.text && <p class="pick__text">{item.text}</p>}
              <p>{item.reason}</p>
            </li>
          ))}
        </ol>
        <div class="duo">
          <div class="panel panel--cream panel--wide">
            <h3 class="panel__title">Ręczny kerning</h3>
            <p>{content.process.refinement[0].text}</p>
            <div class="kern">
              <figure>
                <img
                  src={asset('figures/wordmark-default.svg')}
                  alt="Napis Wolnobieg bez korekty kerningu"
                  width="320"
                  height="190"
                  loading="lazy"
                />
                <figcaption>Bez korekty</figcaption>
              </figure>
              <figure>
                <img
                  src={asset('figures/wordmark-kerned.svg')}
                  alt="Napis Wolnobieg po ręcznej korekcie kerningu"
                  width="320"
                  height="190"
                  loading="lazy"
                />
                <figcaption>Po korekcie</figcaption>
              </figure>
            </div>
            <p class="muted">{content.process.refinement[1].text}</p>
          </div>
          <div class="panel panel--cream panel--flip panel--wide">
            <h3 class="panel__title">Test czytelności</h3>
            <p>{content.process.refinement[2].text}</p>
            <div class="sizes">
              {sizeTest.map(group => (
                <div class="sizes__group">
                  <ul class="sizes__row">
                    {group.items.map(item => (
                      <li>
                        <img
                          src={asset(item.src)}
                          alt=""
                          width={item.size}
                          height={item.size}
                          style={`width:${item.size}px;height:${item.size}px`}
                        />
                        <span>{item.size} px</span>
                      </li>
                    ))}
                  </ul>
                  <p class="sizes__title">{group.title}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="band band--cream" style="--z:5" id="system" aria-labelledby="t-system">
      <div class="wrap">
        <header class="sh">
          <span class="sh__no" aria-hidden="true">
            4
          </span>
          <h2 id="t-system" class="sh__title">
            System identyfikacji
          </h2>
          <span class="sh__rail" aria-hidden="true"></span>
        </header>

        <div class="sys">
          <h3 class="pill">Logo w sześciu wersjach</h3>
          <ul class="variants">
            {logoVariants.map(variant => (
              <li class={`ground ground--${variant.ground}`}>
                <img
                  src={asset(`logo/wolnobieg-${variant.id}.svg`)}
                  alt={`Logo Wolnobieg, wersja ${variant.name.toLowerCase()}`}
                  width="240"
                  height="160"
                  loading="lazy"
                />
                <p>
                  <strong>{variant.name}</strong>
                  <span>{variant.note}</span>
                </p>
              </li>
            ))}
          </ul>
          <div class="duo duo--even">
            <figure class="clear">
              <img
                src={asset('figures/clearspace.svg')}
                alt="Logo główne otoczone polem ochronnym równym wysokości litery W"
                width="857"
                height="370"
                loading="lazy"
              />
            </figure>
            <div class="prose">
              <h4>Pole ochronne i rozmiary</h4>
              <p>{extras.clearSpace}</p>
              <ul class="plain">
                <li>Sygnet: {extras.minimum.symbol}.</li>
                <li>Pełna odznaka: {extras.minimum.fullBadge}.</li>
                <li>Logo główne: {extras.minimum.primary}.</li>
                <li>Logo pionowe: {extras.minimum.vertical}.</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="sys">
          <h3 class="pill">Kolor</h3>
          <ul class="swatches">
            {colors.map(color => (
              <li>
                <span class="swatches__chip" style={`background:${color.hex}`}></span>
                <strong>{color.name}</strong>
                <span>{color.hex}</span>
                <em>{color.role}</em>
              </li>
            ))}
          </ul>
          <div class="panel panel--white">
            <ColorTable colors={colors} />
            <h4>Kontrast</h4>
            <p class="muted">
              Każda para tekstu i tła w systemie ma policzony stosunek kontrastu. Teksty spełniają
              WCAG AA, a elementy dekoracyjne są oznaczone osobno.
            </p>
            <ContrastTable pairs={manifest.contrast} />
          </div>
        </div>

        <div class="sys">
          <h3 class="pill">Typografia</h3>
          <div class="panel panel--orange type">
            <div class="duo duo--even">
              <div class="face">
                <p class="face__name face__name--display">Rammetto One</p>
                <p class="face__sample face__sample--display">{extras.specimen}</p>
                <p class="muted">Nagłówki i napis logo. Jedna grubość, 400. Licencja OFL.</p>
              </div>
              <div class="face">
                <p class="face__name face__name--text">Baloo 2</p>
                <p class="face__sample face__sample--text">{extras.specimen}</p>
                <p class="muted">Tekst. Grubości 400, 600 i 800. Licencja OFL.</p>
              </div>
            </div>
            <ul class="scale">
              {extras.typeScale.map(row => (
                <li>
                  <span
                    class={`scale__sample scale__sample--${row.font}`}
                    style={`font-size:${Math.min(row.size, 40)}px;font-weight:${'weight' in row ? row.weight : 400}`}>
                    {row.name}
                  </span>
                  <span class="muted">
                    {row.size} px, interlinia {String(row.line).replace('.', ',')}. {row.use}
                  </span>
                </li>
              ))}
            </ul>
            <p class="glyphs">{extras.glyphs}</p>
          </div>
        </div>

        <div class="sys">
          <h3 class="pill">Ikony i wzór</h3>
          <ul class="icons">
            {icons.map(name => (
              <li>
                <img
                  src={asset(`icons/svg/wolnobieg-icon-${name}.svg`)}
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                />
                <span>{extras.iconLabels[name] ?? name}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div
        class="pattern"
        role="img"
        aria-label="Wzór z koncentrycznych pierścieni w pomarańczy, musztardzie i brązie"
        style={`background-image:url(${asset('pattern/wolnobieg-pattern.svg')})`}></div>

      <div class="wrap">
        <div class="sys">
          <ul class="graphics">
            {extras.graphics.map(item => (
              <li>
                <h4>{item.title}</h4>
                <p>{item.text}</p>
              </li>
            ))}
          </ul>
          <ul class="plain plain--rules">
            {extras.layoutRules.map(rule => (
              <li>{rule}</li>
            ))}
          </ul>
        </div>

        <div class="sys">
          <h3 class="pill">Zdjęcia i ton głosu</h3>
          <p class="prose-p">{extras.photoStyle}</p>
          <div class="tone">
            {content.tone.map((rule, index) => (
              <article class={index % 2 ? 'tone__item tone__item--alt' : 'tone__item'}>
                <h4>{rule.title}</h4>
                <p>{rule.text}</p>
                <p class="yes">
                  <span class="tag">Tak</span>
                  {rule.yes}
                </p>
                <p class="no">
                  <span class="tag">Nie</span>
                  {rule.no}
                </p>
              </article>
            ))}
          </div>
        </div>

        <div class="sys">
          <div class="panel panel--mustard film">
            <div class="film__text">
              <h3 class="panel__title">Animacja</h3>
              <p>{extras.animation}</p>
              <dl class="facts">
                {extras.animationFacts.map(([term, text]) => (
                  <div>
                    <dt>{term}</dt>
                    <dd>{text}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <video
              class="film__video"
              controls
              muted
              loop
              playsinline
              preload="metadata"
              width="1080"
              height="1080">
              <source src={`${asset('animation/wolnobieg-logo.webm')}#t=2.9`} type="video/webm" />
              <source src={`${asset('animation/wolnobieg-logo.mp4')}#t=2.9`} type="video/mp4" />
            </video>
          </div>
        </div>

        <div class="sys">
          <h3 class="pill">Ułóż własne pasy</h3>
          <p class="prose-p">
            Pasy to najważniejszy element systemu. Zmień liczbę, kolory i łuk, a potem pobierz
            gotowy plik SVG.
          </p>
          <div class="panel panel--sand">
            <StripeComposer client:visible />
          </div>
        </div>
      </div>
    </section>

    <section
      class="band band--olive"
      style="--z:4"
      id="zastosowania"
      aria-labelledby="t-zastosowania">
      <div class="wrap">
        <header class="sh">
          <span class="sh__no" aria-hidden="true">
            5
          </span>
          <h2 id="t-zastosowania" class="sh__title">
            Zastosowania
          </h2>
          <span class="sh__rail" aria-hidden="true"></span>
        </header>
        <div class="gallery">
          {mockups.map(item => (
            <figure class={`gallery__item gallery__item--${item.id}`}>
              <img
                src={asset(item.image)}
                alt={item.alt}
                width={item.info?.width}
                height={item.info?.height}
                loading="lazy"
              />
              <figcaption>
                <strong>{item.title}</strong>
                <span>{item.caption}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <h3 class="pill pill--light">Media społecznościowe</h3>
        <ul class="posts">
          <li class="posts__avatar">
            <img
              src={asset('social/wolnobieg-avatar.png')}
              alt="Awatar Wolnobiegu: odznaka z zębatką na pomarańczowym tle"
              width="1080"
              height="1080"
              loading="lazy"
            />
            <span>Awatar</span>
          </li>
          {posts.map(post => (
            <li>
              <img
                src={asset(post.path)}
                alt={`Post w mediach społecznościowych: ${post.headline} ${post.body}`}
                width="1080"
                height="1350"
                loading="lazy"
              />
              <span>{post.headline}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="band band--orange" style="--z:3" id="pliki" aria-labelledby="t-pliki">
      <div class="wrap">
        <header class="sh">
          <span class="sh__no" aria-hidden="true">
            6
          </span>
          <h2 id="t-pliki" class="sh__title">
            Pliki do pobrania
          </h2>
          <span class="sh__rail" aria-hidden="true"></span>
        </header>
        <div class="panel panel--cream files">
          <p>{content.deliverables.intro}</p>
          {zip && <p class="muted">Cała paczka waży {formatBytes(zip.bytes)}.</p>}
          <Downloads manifest={manifest} />
          <p class="muted">{content.deliverables.note}</p>
        </div>
      </div>
    </section>

    <section class="band band--cta" style="--z:2" aria-labelledby="t-cta">
      <div class="wrap cta">
        <h2 id="t-cta">{content.cta.title}</h2>
        <p>{content.cta.text}</p>
        <a class="cta__link" href={portfolio('/dla-klienta/#wzornik')}>
          Zobacz ofertę dla klientów
        </a>
      </div>
    </section>
  </main>

  <footer class="foot">
    <SampleLine name={brand.name} />
    <p class="foot__contact">
      {contact.street}, {contact.city}. Dane kontaktowe są zmyślone.
    </p>
  </footer>
</Shell>
