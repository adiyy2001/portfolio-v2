---
interface Props {
  size?: number;
}

const { size = 28 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect x="3" y="3" width="26" height="26" fill="#ff5b24"></rect>
  <rect x="14.5" y="3" width="3" height="26" fill="#0f1f3d"></rect>
</svg>
