---
import { link } from '../../shared/link';
import { navItems, site } from './data';
import Rings from './Rings.astro';

interface Props {
  current?: 'crisis' | 'privacy';
}

const { current } = Astro.props;
const home = link(site.home);
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="logo" href={home} aria-label="Tafla, strona główna">
      <Rings count={3} gap={7} class="logo__mark" />
      <span>{site.name}</span>
    </a>
    <button
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-button>
      Menu
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Główna nawigacja" data-nav>
      <ul>
        {navItems.map(item => (
          <li>
            <a href={`${home}#${item.id}`} data-section-link={item.id}>
              {item.label}
            </a>
          </li>
        ))}
        <li class="site-nav__crisis">
          <a href={link(site.crisis)} aria-current={current === 'crisis' ? 'page' : undefined}>
            W kryzysie
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import { initNav } from './nav';

  initNav();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--sage);
    border-bottom: 1px solid var(--line);
  }

  .site-header__inner {
    position: relative;
    display: flex;
    min-height: var(--header-height);
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    column-gap: 24px;
  }

  .logo {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    font: 350 1.875rem / 1 var(--font-display);
    letter-spacing: -0.005em;
    text-decoration: none;
  }

  .logo :global(.logo__mark) {
    width: 42px;
    color: var(--pine);
  }

  .menu-button {
    display: none;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 clamp(18px, 2.2vw, 36px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    position: relative;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    color: var(--ink);
    font-size: 1.0625rem;
    text-decoration: none;
  }

  .site-nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .site-nav a::before,
  .site-nav a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 2px;
    width: 100%;
    height: 9px;
    border: 1px solid var(--pine);
    border-radius: 50%;
    opacity: 0;
    transform: translateX(-50%) scaleX(0.4);
    transition:
      opacity 0.5s var(--ease),
      transform 0.7s var(--ease);
    pointer-events: none;
  }

  .site-nav a::after {
    width: 150%;
    height: 14px;
    bottom: -1px;
    border-color: color-mix(in srgb, var(--pine) 45%, transparent);
    transition-delay: 0.12s;
  }

  .site-nav a[aria-current]::before,
  .site-nav a[aria-current]::after {
    opacity: 1;
    transform: translateX(-50%) scaleX(1);
  }

  .site-nav__crisis {
    margin-left: clamp(0px, 0.6vw, 12px);
    padding-left: clamp(18px, 2.2vw, 36px);
    border-left: 1px solid var(--line);
  }

  .site-nav__crisis a {
    color: var(--pine);
    font-weight: 560;
  }

  @media (max-width: 859px) {
    :global(.js) .menu-button {
      display: inline-flex;
      min-height: 44px;
      align-items: center;
      padding: 0 20px;
      border: 1.5px solid var(--ink);
      background: transparent;
      font-size: 1.0625rem;
      font-weight: 560;
    }

    :global(.js) .menu-button[aria-expanded='true'] {
      background: var(--ink);
      color: var(--sage);
    }

    :global(.js) .site-nav {
      display: none;
    }

    :global(.js) .site-nav[data-open='true'] {
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      display: block;
      padding: 8px var(--margin) 24px;
      background: var(--sage);
      border-bottom: 1px solid var(--line);
    }

    :global(.js) .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    :global(.js) .site-nav li {
      border-bottom: 1px solid var(--line);
    }

    :global(.js) .site-nav a {
      width: 100%;
      min-height: 56px;
      font: 350 1.75rem / 1.1 var(--font-display);
    }

    :global(.js) .site-nav a::before,
    :global(.js) .site-nav a::after {
      display: none;
    }

    :global(.js) .site-nav__crisis {
      margin: 0;
      padding: 0;
      border-left: 0;
    }

    :global(.js) .site-nav__crisis a {
      font-weight: 400;
    }

    .site-nav {
      width: 100%;
      padding-bottom: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav a::before,
    .site-nav a::after {
      transition: none;
    }
  }
</style>
