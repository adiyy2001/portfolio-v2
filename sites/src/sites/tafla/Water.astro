---
import { POND_HEIGHT, POND_SEED, POND_WIDTH, STILL_TIME, createPond } from './ripples';

const round = (value: number) => Math.round(value * 10) / 10;
const ripples = createPond(POND_SEED).ripplesAt(STILL_TIME);
---

<div class="water" data-water data-state="still" aria-hidden="true">
  <svg
    class="water__still"
    viewBox={`0 0 ${POND_WIDTH} ${POND_HEIGHT}`}
    fill="none"
    stroke="currentColor"
    preserveAspectRatio="xMidYMin slice"
    focusable="false">
    {ripples.map(ripple => (
      <ellipse
        cx={round(ripple.x)}
        cy={round(ripple.y)}
        rx={round(ripple.rx)}
        ry={round(ripple.ry)}
        stroke-opacity={ripple.alpha.toFixed(2)}
        vector-effect="non-scaling-stroke"
      />
    ))}
  </svg>
  <canvas class="water__canvas" data-water-canvas></canvas>
</div>

<script>
  import { initWater } from './water';

  initWater();
</script>

<style>
  .water {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 0;
    width: min(64%, 1180px);
    aspect-ratio: 1000 / 625;
    color: var(--pine);
    pointer-events: none;
    mask-image:
      linear-gradient(to right, transparent, #000 34%),
      linear-gradient(to bottom, transparent, #000 30%);
    mask-composite: intersect;
    -webkit-mask-composite: source-in;
  }

  .water__still,
  .water__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .water__still ellipse {
    stroke-width: 1.5px;
  }

  .water__canvas {
    opacity: 0;
  }

  .water[data-ready] .water__canvas {
    opacity: 1;
  }

  .water[data-ready] .water__still {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .water__canvas {
      display: none;
    }

    .water[data-ready] .water__still {
      visibility: visible;
    }
  }

  @media (max-width: 899px) {
    .water {
      position: relative;
      width: 100%;
      mask-image: linear-gradient(to bottom, #000 62%, transparent);
    }
  }

  @media (max-width: 360px) {
    .water {
      aspect-ratio: 1000 / 420;
    }
  }
</style>
