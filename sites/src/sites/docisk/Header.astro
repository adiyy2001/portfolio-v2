---
import { link } from '../../shared/link';
import { navItems, site } from './data';

const home = link(site.home);
---

<header class="site-header dark">
  <div class="container site-header__inner">
    <a class="wordmark" href={home} aria-label="Docisk, strona główna">
      {site.name}
    </a>
    <nav class="site-nav" aria-label="Główna nawigacja">
      <ul>
        {navItems.map(item => (
          <li>
            <a href={`#${item.id}`}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <button class="button button--small site-header__action" type="button" data-assistant="open">
      Zapytaj asystenta
    </button>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line-light);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'mark action'
      'nav nav';
    align-items: center;
    column-gap: 1rem;
    padding-block: 0.5rem;
  }

  .wordmark {
    grid-area: mark;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.75rem;
    justify-self: start;
    color: var(--chalk);
    font: 700 2rem / 1 var(--font-display);
    letter-spacing: 0.02em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .wordmark::before {
    content: '';
    width: 1.25rem;
    height: 1.25rem;
    background: var(--stripe);
    border: 2px solid var(--yellow);
  }

  .site-nav {
    grid-area: nav;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--chalk);
    font-weight: 600;
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--yellow);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .site-header__action {
    grid-area: action;
  }

  @media (min-width: 48rem) {
    .site-header__inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'mark nav action';
      column-gap: 2rem;
      padding-block: 0.75rem;
    }

    .site-nav ul {
      justify-content: flex-end;
    }
  }
</style>
