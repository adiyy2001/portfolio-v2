---
import { link } from '../../../shared/link';
import { bookingPath, clinic } from '../data/site';
import { nbsp } from '../lib/typography';

interface Props {
  title: string;
  text: string;
  topic?: string;
}

const { title, text, topic } = Astro.props;
const href = link(
  topic ? `${bookingPath.replace('#', `?temat=${encodeURIComponent(topic)}#`)}` : bookingPath,
);
---

<section class="wrap sec-in" aria-labelledby="cta-title">
  <div class="cta-band is-cobalt">
    <div>
      <h2 id="cta-title">{nbsp(title)}</h2>
      <p>{nbsp(text)}</p>
    </div>
    <div class="cta-actions">
      <a class="pill pill-fill" href={href}>
        Umów wizytę
        <svg viewBox="0 0 18 18" aria-hidden="true">
          <path
            d="M2 9h13M10 4l5 5-5 5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
      <a class="text-link" href={clinic.phoneHref}>
        Zadzwoń: {clinic.phoneDisplay}
      </a>
    </div>
  </div>
</section>
