---
import ArchRule from '../components/ArchRule.astro';
import PageHead from '../components/PageHead.astro';
import { common } from '../content/common';
import { voucherText } from '../content/voucher';
import type { Lang } from '../i18n/lang';
import { VoucherBuilder } from '../islands/VoucherBuilder';
import Layout from '../layouts/Layout.astro';
import bookingCss from '../styles/booking.css?raw';
import voucherCss from '../styles/voucher.css?raw';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const text = voucherText[lang];
const shared = common[lang];
---

<Layout
  lang={lang}
  pageKey="voucher"
  title={text.title}
  description={text.description}
  css={[bookingCss, voucherCss]}>
  <PageHead title={text.heading} lead={text.lead} />
  <section class="section wrap voucher-section" aria-label={text.heading}>
    <VoucherBuilder client:only="preact" lang={lang}>
      <div slot="fallback" class="voucher-fallback" aria-hidden="true"></div>
    </VoucherBuilder>
    <noscript>
      <p class="notice">{shared.noScriptBooking}</p>
    </noscript>
  </section>

  <ArchRule />

  <section class="section wrap" aria-labelledby="steps-title">
    <div class="split">
      <div>
        <h2 id="steps-title" class="section-title">
          {text.stepsHeading}
        </h2>
        <ol class="voucher-steps">
          {text.steps.map(step => (
            <li>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <h2 class="section-title">{text.termsHeading}</h2>
        <ul class="voucher-terms">
          {text.terms.map(term => (
            <li>{term}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Layout>
