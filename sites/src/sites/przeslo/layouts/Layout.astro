---
import SampleNote from '../../../shared/SampleNote.astro';
import { link } from '../../../shared/link';
import { common } from '../content/common';
import { hotel } from '../content/facts';
import { roomTypeById } from '../data/rooms';
import type { RoomTypeId } from '../data/rooms';
import { htmlLocale, languages, otherLanguage, pagePath } from '../i18n/lang';
import type { Lang, PageKey } from '../i18n/lang';
import baseCss from '../styles/base.css?raw';
import { fontFaceCss } from '../styles/fonts';

interface Props {
  lang: Lang;
  pageKey: PageKey;
  title: string;
  description: string;
  roomType?: RoomTypeId;
  css?: string[];
}

const { lang, pageKey, title, description, roomType, css = [] } = Astro.props;
const text = common[lang];

const pathFor = (target: Lang): string =>
  pagePath(pageKey, target, roomType ? roomTypeById(roomType).slug[target] : undefined);
const absolute = (path: string): string => new URL(link(path), Astro.site).href;

const currentPath = pathFor(lang);
const canonical = absolute(currentPath);
const ogImage = absolute('/przeslo/og.png');
const fontUrl = link('/przeslo/fonts/Besley-var.woff2');
const stylesheet = [fontFaceCss(fontUrl), baseCss, ...css].join('\n');

const navKeys: PageKey[] = [
  'home',
  'rooms',
  'booking',
  'myBooking',
  'packages',
  'voucher',
  'breakfast',
  'neighbourhood',
  'contact',
];
const currentOf = (key: PageKey): 'page' | 'true' | undefined => {
  if (key === pageKey) return roomType ? 'true' : 'page';
  return undefined;
};

const ogLocale = htmlLocale[lang];
const ogAlternate = htmlLocale[otherLanguage(lang)];
const ogAlt =
  lang === 'pl'
    ? 'Przęsło, hotel nad Odrą we Wrocławiu: tablica recepcji z kluczami do pokoi'
    : 'Przęsło, a hotel by the Oder in Wrocław: the reception board with room keys';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1c1130" />
    <link rel="canonical" href={canonical} />
    {languages.map(code => (
      <link rel="alternate" hreflang={code} href={absolute(pathFor(code))} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absolute(pathFor('pl'))} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={hotel.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogAlternate} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={link('/przeslo/favicon.svg')} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={stylesheet}></style>
    <noscript>
      <style>
        .rail-panel {
          position: static;
          display: block;
          box-shadow: none;
        }
        .menu-toggle {
          display: none;
        }
        .rail-inner {
          flex-wrap: wrap;
        }
        .rail-panel {
          flex-basis: 100%;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {text.skip}
    </a>
    <div class="shell">
      <header class="rail" data-menu="closed">
        <div class="rail-inner">
          <div>
            <a
              class="mark"
              href={link(pagePath('home', lang))}
              aria-label={`${hotel.name}, ${text.nav.home}`}>
              {hotel.name}
            </a>
            <p class="tagline">{text.tagline}</p>
          </div>
          <div class="rail-actions">
            <a class="btn btn--light" href={link(pagePath('booking', lang))}>
              {text.book}
            </a>
            <button
              class="menu-toggle"
              type="button"
              aria-expanded="false"
              aria-controls="site-menu">
              <span class="bars" aria-hidden="true"></span>
              {text.menu}
            </button>
          </div>
          <div class="rail-panel" id="site-menu">
            <nav aria-label={text.mainNav}>
              <ul class="board-nav">
                {navKeys.map(key => (
                  <li>
                    <a href={link(pagePath(key, lang))} aria-current={currentOf(key)}>
                      <span class="peg" aria-hidden="true"></span>
                      <span>{text.nav[key]}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
            <div class="rail-foot">
              <div class="lang-switch" role="group" aria-label={text.languageLabel}>
                {languages.map(code => (
                  <a
                    href={link(pathFor(code))}
                    hreflang={code}
                    lang={code}
                    aria-current={code === lang ? 'true' : undefined}>
                    {code.toUpperCase()}
                    <span class="visually-hidden"> ({text.languageNames[code]})</span>
                  </a>
                ))}
              </div>
              <address class="rail-address">
                {hotel.street}
                <br />
                {hotel.postalCode} {hotel.city}
                <br />
                <a href={hotel.phoneHref}>{hotel.phone}</a>
              </address>
              <a class="btn btn--light rail-cta" href={link(pagePath('booking', lang))}>
                {text.bookLong}
              </a>
            </div>
          </div>
        </div>
      </header>
      <div class="content">
        <main id="main" tabindex="-1">
          <slot />
        </main>
        <footer class="site-footer">
          <div class="wrap">
            <div class="footer-grid">
              <div>
                <p class="footer-mark">{hotel.name}</p>
                <p>{text.footer.about}</p>
                <address class="footer-address">
                  {hotel.street}, {hotel.postalCode} {hotel.city}
                </address>
              </div>
              <div>
                <h2>{text.footer.hotelHeading}</h2>
                <ul>
                  {text.footer.footerLinks.map(key => (
                    <li>
                      <a href={link(pagePath(key, lang))}>{text.nav[key]}</a>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h2>{text.footer.stayHeading}</h2>
                <ul>
                  {text.footer.stayLinks.map(key => (
                    <li>
                      <a href={link(pagePath(key, lang))}>{text.nav[key]}</a>
                    </li>
                  ))}
                </ul>
                <p class="footer-times">
                  {text.footer.checkIn}
                  <br />
                  {text.footer.checkOut}
                  <br />
                  {text.footer.reception}
                  <br />
                  <a href={hotel.phoneHref}>{hotel.phone}</a>
                  <br />
                  <a href={hotel.emailHref}>{hotel.email}</a>
                </p>
              </div>
            </div>
            <div class="footer-note">
              <SampleNote name={hotel.name} lang={lang} />
            </div>
          </div>
        </footer>
      </div>
    </div>
    <script>
      const rail = document.querySelector<HTMLElement>('.rail');
      const toggle = rail?.querySelector<HTMLButtonElement>('.menu-toggle');
      if (rail && toggle) {
        const setOpen = (open: boolean): void => {
          toggle.setAttribute('aria-expanded', String(open));
          rail.dataset.menu = open ? 'open' : 'closed';
        };
        toggle.addEventListener('click', () => {
          setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });
        document.addEventListener('keydown', event => {
          if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            toggle.focus();
          }
        });
        window.matchMedia('(min-width: 1100px)').addEventListener('change', () => setOpen(false));
      }
    </script>
  </body>
</html>
