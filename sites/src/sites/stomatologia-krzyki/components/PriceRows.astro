---
import { formatPrice } from '../data/prices';
import type { PriceItem } from '../data/prices';
import { nbsp } from '../lib/typography';

interface Props {
  items: readonly PriceItem[];
}

const { items } = Astro.props;
---

<ul class="price-rows">
  {items.map(item => (
    <li>
      <div>
        <span class="pr-name">{item.name}</span>
        <span class="pr-includes">{nbsp(item.includes)}</span>
      </div>
      <div class="pr-price">
        <b>{formatPrice(item)}</b>
        <span>{item.unit}</span>
      </div>
    </li>
  ))}
</ul>
