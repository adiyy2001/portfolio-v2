---
import { bookingPath, clinic, navigation } from '../data/site';
import { page } from '../lib/url';

interface Props {
  current: string;
}

const { current } = Astro.props;
const currentState = (path: string) =>
  current === path ? 'page' : current.startsWith(path) ? 'true' : undefined;
---

<header class="site-header">
  <div class="container site-header__bar">
    <a class="wordmark" href={page('/')} aria-label="Szkliwo, strona główna">
      <span class="tab-mark" aria-hidden="true"></span>
      <span>{clinic.name}</span>
    </a>
    <button
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-button>
      <span class="menu-button__tab" aria-hidden="true"></span>
      Menu
    </button>
    <nav id="site-menu" class="site-nav" aria-label="Główna" data-menu>
      <ul>
        {navigation.map(item => (
          <li>
            <a href={page(item.path)} aria-current={currentState(item.path)}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="site-nav__contact">
        <a class="site-nav__phone" href={clinic.phoneHref}>
          <span class="visually-hidden">Zadzwoń: </span>
          {clinic.phoneDisplay}
        </a>
        <a class="btn" href={page(bookingPath)}>
          Umów wizytę
        </a>
      </div>
    </nav>
    <div class="site-header__actions">
      <a class="site-header__phone" href={clinic.phoneHref}>
        <span class="visually-hidden">Zadzwoń: </span>
        {clinic.phoneDisplay}
      </a>
      <a class="btn" href={page(bookingPath)}>
        Umów wizytę
      </a>
    </div>
  </div>
</header>

<script>
  import '../scripts/menu';
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: clamp(16px, 3vw, 44px);
    min-height: var(--header-height);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding-block: 0.5rem;
    font-size: 1.625rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .menu-button {
    display: none;
  }

  .site-nav ul {
    display: flex;
    height: var(--header-height);
  }

  .site-nav li {
    display: flex;
  }

  .site-nav li a {
    position: relative;
    display: flex;
    align-items: center;
    padding-inline: 14px;
    font-weight: 500;
    text-decoration: none;
  }

  .site-nav li a::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    width: 28px;
    height: 0;
    margin-left: -14px;
    margin-top: -1px;
    border-radius: 0 0 10px 10px;
    background: var(--coral);
  }

  .site-nav li a:hover::after,
  .site-nav li a:focus-visible::after {
    height: 6px;
  }

  .site-nav li a[aria-current]::after {
    height: 10px;
  }

  .site-nav li a[aria-current='page'] {
    font-weight: 600;
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-nav li a::after {
      transition: height 280ms var(--ease);
    }
  }

  .site-nav__contact {
    display: none;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-left: auto;
  }

  .site-header__phone {
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__phone:hover {
    text-decoration: underline;
    text-decoration-color: var(--coral);
    text-decoration-thickness: 2px;
  }

  @media (max-width: 1180px) {
    .site-header__phone {
      display: none;
    }
  }

  @media (max-width: 960px) {
    .site-header__bar {
      flex-wrap: wrap;
      row-gap: 0;
      justify-content: space-between;
    }

    .site-header__actions {
      display: none;
    }

    .site-nav {
      width: 100%;
    }

    .site-nav ul {
      flex-wrap: wrap;
      height: auto;
      padding-bottom: 12px;
      column-gap: 4px;
    }

    .site-nav li a {
      min-height: 44px;
      padding-inline: 12px;
    }

    .site-nav li a::after {
      top: auto;
      bottom: 2px;
      margin-top: 0;
      height: 3px;
      border-radius: 2px;
    }

    .site-nav li a:hover::after,
    .site-nav li a:focus-visible::after,
    .site-nav li a[aria-current]::after {
      height: 3px;
    }

    :global(.js) .menu-button {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 48px;
      padding: 0.5rem 1.1rem 0.6rem;
      border: 2px solid var(--ink);
      border-radius: var(--tab-radius);
      background: transparent;
      font-weight: 600;
      cursor: pointer;
    }

    .menu-button__tab {
      width: 12px;
      height: 14px;
      border-radius: 2px 2px 6px 6px;
      background: var(--coral);
      transform-origin: top;
    }

    .menu-button[aria-expanded='true'] .menu-button__tab {
      transform: scaleY(1.5);
    }

    @media (prefers-reduced-motion: no-preference) {
      .menu-button__tab {
        transition: transform 280ms var(--ease);
      }
    }

    :global(.js) .site-nav {
      display: none;
    }

    :global(.js) .site-nav[data-open] {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      width: auto;
      padding: 8px var(--gutter) 28px;
      background: var(--paper);
      border-bottom: 1px solid var(--rule);
      box-shadow: 0 24px 40px -24px rgb(27 31 42 / 0.35);
    }

    :global(.js) .site-nav[data-open] ul {
      display: block;
      padding-bottom: 8px;
    }

    :global(.js) .site-nav[data-open] li a {
      min-height: 56px;
      padding-inline: 0;
      border-bottom: 1px solid var(--rule);
      font-size: 1.5rem;
      font-weight: 500;
      letter-spacing: -0.02em;
    }

    :global(.js) .site-nav[data-open] li a::after {
      left: auto;
      right: 0;
      top: 50%;
      bottom: auto;
      width: 10px;
      height: 0;
      margin: 0;
      transform: translateY(-50%);
      border-radius: 3px 3px 8px 8px;
    }

    :global(.js) .site-nav[data-open] li a[aria-current]::after {
      height: 24px;
    }

    :global(.js) .site-nav[data-open] .site-nav__contact {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 16px 24px;
      padding-top: 20px;
    }

    .site-nav__phone {
      font-size: 1.5rem;
      font-weight: 600;
      text-decoration: none;
    }
  }

  @media (max-width: 720px) {
    .wordmark {
      font-size: 1.5rem;
    }

    :global(.js) .site-nav[data-open] .site-nav__contact .btn {
      display: none;
    }
  }
</style>
