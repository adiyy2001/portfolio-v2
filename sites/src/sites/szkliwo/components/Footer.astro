---
import SampleNote from '../../../shared/SampleNote.astro';
import { clinic, hoursSummary } from '../data/site';
import { treatments } from '../data/treatments';
import { page } from '../lib/url';
---

<footer class="site-footer on-ink">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a class="wordmark" href={page('/')} aria-label="Szkliwo, strona główna">
        <span class="tab-mark" aria-hidden="true"></span>
        <span class="wordmark__text">{clinic.name}</span>
      </a>
      <p class="site-footer__tagline">{clinic.tagline}</p>
      <p class="muted small">Prywatna klinika stomatologiczna we Wrocławiu. Bez kontraktu z NFZ.</p>
    </div>
    <div>
      <h2 class="site-footer__title">Adres</h2>
      <address>
        {clinic.street}
        <br />
        {clinic.postalCode} {clinic.city}
        <br />
        <span class="muted small">Parter, wejście bez schodów.</span>
      </address>
      <p class="site-footer__contact">
        <a href={clinic.phoneHref}>{clinic.phoneDisplay}</a>
        <br />
        <a href={`mailto:${clinic.email}`}>{clinic.email}</a>
      </p>
    </div>
    <div>
      <h2 class="site-footer__title">Godziny</h2>
      <dl class="site-footer__hours">
        {hoursSummary.map(row => (
          <div>
            <dt>{row.days}</dt>
            <dd>{row.hours}</dd>
          </div>
        ))}
      </dl>
      <p class="site-footer__status small" data-open-status hidden></p>
    </div>
    <div>
      <h2 class="site-footer__title">Zabiegi i cennik</h2>
      <ul class="site-footer__links">
        {treatments.map(treatment => (
          <li>
            <a href={page(`/zabiegi/${treatment.slug}/`)}>{treatment.name}</a>
          </li>
        ))}
        <li>
          <a href={page('/cennik/')}>Cennik</a>
        </li>
      </ul>
    </div>
  </div>
  <div class="container site-footer__base">
    <SampleNote name="Szkliwo" lang="pl" />
    <p class="small muted">© 2026 Szkliwo</p>
  </div>
</footer>

<script>
  import '../scripts/open-status';
</script>

<style>
  .site-footer {
    background: var(--ink);
    color: #fff;
    padding-block: clamp(48px, 6vw, 88px) 32px;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 40px clamp(24px, 4vw, 64px);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    font-size: 1.625rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .site-footer__tagline {
    margin-top: 20px;
    font-size: var(--text-lead);
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .site-footer__brand .small {
    margin-top: 12px;
    max-width: 22em;
  }

  .site-footer__title {
    margin-bottom: 14px;
    font-size: var(--text-small);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--on-ink);
  }

  address {
    font-style: normal;
    line-height: 1.55;
  }

  .site-footer__contact {
    margin-top: 16px;
    line-height: 1.8;
  }

  .site-footer a {
    text-underline-offset: 0.2em;
  }

  .site-footer a:hover {
    color: var(--coral);
  }

  .site-footer__hours div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 6px;
    border-bottom: 1px solid rgb(255 255 255 / 0.16);
  }

  .site-footer__hours dt {
    color: var(--on-ink);
  }

  .site-footer__hours dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .site-footer__status {
    margin-top: 14px;
    color: var(--coral);
    font-weight: 600;
  }

  .site-footer__links li a,
  .site-footer__contact a {
    display: inline-block;
    padding-block: 10px;
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px 32px;
    margin-top: clamp(40px, 5vw, 72px);
    padding-top: 24px;
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }

  @media (max-width: 960px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 720px) {
    .site-footer {
      padding-bottom: calc(32px + var(--action-bar-height) + env(safe-area-inset-bottom, 0px));
    }
  }

  @media (max-width: 560px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
