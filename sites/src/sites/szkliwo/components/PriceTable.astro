---
import type { PriceItem } from '../data/prices';
import { formatZloty } from '../lib/format';
import { searchText } from '../lib/search';

interface Props {
  items: readonly PriceItem[];
  categoryName: string;
  caption: string;
  searchable?: boolean;
}

const { items, categoryName, caption, searchable = false } = Astro.props;
---

<table class="price-table">
  <caption class="visually-hidden">{caption}</caption>
  <thead class="visually-hidden">
    <tr>
      <th scope="col">Pozycja</th>
      <th scope="col">Cena</th>
    </tr>
  </thead>
  <tbody>
    {items.map(item => (
      <tr data-price-row data-search={searchable ? searchText(item, categoryName) : undefined}>
        <th scope="row">
          <span class="price-table__name">{item.name}</span>
          {item.note && <span class="price-table__note">{item.note}</span>}
        </th>
        <td>
          <span class="price-table__amount">
            {item.from ? 'od ' : ''}
            {formatZloty(item.price)}
          </span>
          {item.unit && <span class="price-table__unit">{item.unit}</span>}
        </td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .price-table {
    border-top: 2px solid var(--ink);
  }

  .price-table tr {
    border-bottom: 1px solid var(--edge);
  }

  .price-table th,
  .price-table td {
    padding: 16px 0;
    vertical-align: top;
    text-align: left;
    font-weight: 400;
  }

  .price-table th {
    padding-right: 24px;
  }

  .price-table td {
    text-align: right;
    white-space: nowrap;
  }

  .price-table__name {
    display: block;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .price-table__note {
    display: block;
    max-width: 38em;
    margin-top: 4px;
    font-size: var(--text-small);
    line-height: 1.45;
    color: var(--muted);
  }

  .price-table__amount {
    display: block;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .price-table__unit {
    display: block;
    font-size: var(--text-small);
    color: var(--muted);
  }

  .price-table tr[hidden] {
    display: none;
  }
</style>
