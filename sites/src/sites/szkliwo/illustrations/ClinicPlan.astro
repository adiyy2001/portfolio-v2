---
const rooms = [
  { id: 'waiting', label: 'Poczekalnia', x: 20, y: 40, width: 280, height: 200, tone: 'mist' },
  { id: 'room-1', label: 'Gabinet 1', x: 300, y: 40, width: 200, height: 200, tone: 'white' },
  { id: 'room-2', label: 'Gabinet 2', x: 500, y: 40, width: 240, height: 200, tone: 'white' },
  { id: 'desk', label: 'Rejestracja', x: 20, y: 240, width: 190, height: 200, tone: 'coral' },
  { id: 'wc', label: 'WC', x: 210, y: 240, width: 90, height: 200, tone: 'mist' },
  { id: 'sterile', label: 'Sterylizacja', x: 300, y: 240, width: 120, height: 200, tone: 'mist' },
  { id: 'xray', label: 'RTG', x: 420, y: 240, width: 100, height: 200, tone: 'mist' },
  { id: 'room-3', label: 'Gabinet 3', x: 520, y: 240, width: 220, height: 200, tone: 'white' },
] as const;

const fills = { mist: '#f1f3f6', white: '#ffffff', coral: '#ffd9d2' } as const;

const doors = [
  { x: 150, y: 240 },
  { x: 400, y: 240 },
  { x: 620, y: 240 },
  { x: 250, y: 240 },
  { x: 360, y: 240 },
  { x: 470, y: 240 },
] as const;

const narrowRooms = [
  { label: 'Gabinet 1', x: 10, y: 30, width: 170, height: 130, tone: 'white' },
  { label: 'Gabinet 2', x: 180, y: 30, width: 170, height: 130, tone: 'white' },
  { label: 'Gabinet 3', x: 10, y: 160, width: 120, height: 130, tone: 'white' },
  { label: 'Sterylizacja', x: 130, y: 160, width: 120, height: 130, tone: 'mist' },
  { label: 'RTG', x: 250, y: 160, width: 100, height: 130, tone: 'mist' },
  { label: 'Poczekalnia', x: 10, y: 290, width: 220, height: 120, tone: 'mist' },
  { label: 'WC', x: 230, y: 290, width: 120, height: 120, tone: 'mist' },
  { label: 'Rejestracja', x: 10, y: 410, width: 340, height: 120, tone: 'coral' },
] as const;

const narrowDoors = [
  { x: 95, y: 160 },
  { x: 190, y: 160 },
  { x: 300, y: 160 },
  { x: 70, y: 290 },
  { x: 190, y: 290 },
  { x: 290, y: 290 },
  { x: 120, y: 410 },
  { x: 290, y: 410 },
] as const;

const planLabel =
  'Plan kliniki na parterze: wejście bez schodów do rejestracji, obok poczekalnia, trzy gabinety, pracownia RTG, sterylizacja i toaleta.';
---

<div class="plan-frame">
  <svg
    class="plan plan--wide"
    viewBox="0 0 760 500"
    role="img"
    aria-label={planLabel}
    focusable="false">
    <rect x="20" y="40" width="720" height="400" fill="#ffffff"></rect>
    {rooms.map(room => (
      <g>
        <rect
          x={room.x}
          y={room.y}
          width={room.width}
          height={room.height}
          fill={fills[room.tone]}
          stroke="#1b1f2a"
          stroke-width="3"></rect>
        <text
          x={room.x + room.width / 2 + (room.id === 'waiting' ? 36 : 0)}
          y={room.y + room.height / 2 + 5}
          text-anchor="middle"
          font-size="17"
          font-weight="600"
          fill="#1b1f2a">
          {room.label}
        </text>
      </g>
    ))}
    {doors.map(door => (
      <rect
        x={door.x - 18}
        y={door.y - 4}
        width="36"
        height="8"
        fill="#ffffff"
        stroke="none"></rect>
    ))}
    <rect
      x="20"
      y="40"
      width="720"
      height="400"
      fill="none"
      stroke="#1b1f2a"
      stroke-width="6"></rect>
    <rect x="62" y="436" width="106" height="10" fill="#ffffff"></rect>
    <path d="M115,492 L115,456" stroke="#1b1f2a" stroke-width="4" stroke-linecap="round"></path>
    <path
      d="M101,468 L115,454 L129,468"
      fill="none"
      stroke="#1b1f2a"
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <text x="182" y="480" font-size="16" font-weight="600" fill="#1b1f2a">
      Wejście z ul. Pułaskiego, bez schodów
    </text>
    <g fill="#1b1f2a">
      <rect x="46" y="76" width="70" height="24" rx="4"></rect>
      <rect x="46" y="112" width="70" height="24" rx="4"></rect>
      <rect x="46" y="148" width="70" height="24" rx="4"></rect>
    </g>
    <g fill="none" stroke="#1b1f2a" stroke-width="2.5">
      <circle cx="372" cy="90" r="16"></circle>
      <circle cx="590" cy="90" r="16"></circle>
      <circle cx="630" cy="300" r="16"></circle>
    </g>
  </svg>
  <svg
    class="plan plan--narrow"
    viewBox="0 0 360 640"
    role="img"
    aria-label={planLabel}
    focusable="false">
    <rect x="10" y="30" width="340" height="500" fill="#ffffff"></rect>
    {narrowRooms.map(room => (
      <g>
        <rect
          x={room.x}
          y={room.y}
          width={room.width}
          height={room.height}
          fill={fills[room.tone]}
          stroke="#1b1f2a"
          stroke-width="3"></rect>
        <text
          x={room.x + room.width / 2}
          y={room.y + room.height / 2 + 5}
          text-anchor="middle"
          font-size="16"
          font-weight="600"
          fill="#1b1f2a">
          {room.label}
        </text>
      </g>
    ))}
    {narrowDoors.map(door => (
      <rect
        x={door.x - 16}
        y={door.y - 4}
        width="32"
        height="8"
        fill="#ffffff"
        stroke="none"></rect>
    ))}
    <rect
      x="10"
      y="30"
      width="340"
      height="500"
      fill="none"
      stroke="#1b1f2a"
      stroke-width="6"></rect>
    <rect x="52" y="526" width="96" height="10" fill="#ffffff"></rect>
    <path d="M100,596 L100,546" stroke="#1b1f2a" stroke-width="4" stroke-linecap="round"></path>
    <path
      d="M86,558 L100,544 L114,558"
      fill="none"
      stroke="#1b1f2a"
      stroke-width="4"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <text x="132" y="572" font-size="15" font-weight="600" fill="#1b1f2a">
      Wejście z ul. Pułaskiego,
    </text>
    <text x="132" y="592" font-size="15" font-weight="600" fill="#1b1f2a">
      bez schodów
    </text>
    <g fill="#1b1f2a">
      <rect x="34" y="440" width="70" height="22" rx="4"></rect>
      <rect x="34" y="474" width="70" height="22" rx="4"></rect>
    </g>
    <g fill="none" stroke="#1b1f2a" stroke-width="2.5">
      <circle cx="95" cy="66" r="14"></circle>
      <circle cx="265" cy="66" r="14"></circle>
      <circle cx="70" cy="196" r="14"></circle>
    </g>
  </svg>
</div>

<style>
  .plan-frame {
    container-type: inline-size;
  }

  .plan {
    display: block;
    width: 100%;
    height: auto;
  }

  .plan--narrow {
    display: none;
  }

  @container (max-width: 560px) {
    .plan--wide {
      display: none;
    }

    .plan--narrow {
      display: block;
      max-width: 440px;
      margin-inline: auto;
    }
  }
</style>
