---
import { getShade } from '../lib/shades';
import type { Portrait, ToothShape } from '../data/team';

interface Props {
  portrait: Portrait;
}

const { portrait } = Astro.props;
const { initials, tooth, shade, tool, background, handle } = portrait;

const ink = '#1b1f2a';
const coral = '#ff6f5b';
const initialsColor = handle === ink ? '#ffffff' : ink;

const outlines: Record<ToothShape, string> = {
  incisor:
    'M54,76 L146,76 C148,124 142,172 132,206 C130,214 122,218 100,218 C78,218 70,214 68,206 C58,172 52,124 54,76 Z',
  canine:
    'M58,76 L142,76 C146,124 140,164 126,196 C118,212 108,222 100,228 C92,222 82,212 74,196 C60,164 54,124 58,76 Z',
  premolar:
    'M52,76 L148,76 C150,132 146,172 138,200 C132,216 120,216 112,206 C106,200 100,198 100,198 C100,198 94,200 88,206 C80,216 68,216 62,200 C54,172 50,132 52,76 Z',
  molar:
    'M40,76 L160,76 C164,130 160,172 154,198 C150,214 138,216 130,206 C124,198 118,196 112,206 C106,216 94,216 88,206 C82,196 76,198 70,206 C62,216 50,214 46,198 C40,172 36,130 40,76 Z',
  lateral:
    'M62,76 L138,76 C140,124 134,172 126,206 C122,218 112,222 100,222 C88,222 78,218 74,206 C66,172 60,124 62,76 Z',
};

const threadHeights = [136, 148, 160, 172, 184] as const;
const alignedTeeth = [74, 90, 106, 122] as const;
const bristles = [128, 134, 140, 146] as const;
---

<svg class="portrait" viewBox="0 0 200 240" aria-hidden="true" focusable="false">
  <rect width="200" height="240" fill={background}></rect>
  <path
    d={outlines[tooth]}
    fill={getShade(shade).color}
    stroke={ink}
    stroke-width="3.5"
    stroke-linejoin="round"></path>
  <path
    d="M66,76 L66,26 C66,20 70,16 76,16 L124,16 C130,16 134,20 134,26 L134,76 Z"
    fill={handle}></path>
  <text
    x="100"
    y="56"
    text-anchor="middle"
    font-size="26"
    font-weight="700"
    letter-spacing="1"
    fill={initialsColor}>
    {initials}
  </text>

  {tool === 'endoFile' && (
    <g transform="rotate(32 100 150)">
      <rect x="91" y="98" width="18" height="26" rx="6" fill={ink}></rect>
      <rect
        x="88"
        y="126"
        width="24"
        height="9"
        rx="3"
        fill={coral}
        stroke={ink}
        stroke-width="2"></rect>
      <path
        d="M95,138 L105,138 L100,206 Z"
        fill="#ffffff"
        stroke={ink}
        stroke-width="3"
        stroke-linejoin="round"></path>
    </g>
  )}
  {tool === 'implant' && (
    <g stroke={ink} stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
      <rect x="91" y="100" width="18" height="20" rx="3" fill={ink}></rect>
      <path d="M85,124 L115,124 L108,196 L92,196 Z" fill="#ffffff"></path>
      {threadHeights.map(y => (
        <path
          d={`M${90 + (y - 124) / 18},${y} L${110 - (y - 124) / 18},${y - 5}`}
          fill="none"></path>
      ))}
    </g>
  )}
  {tool === 'aligner' && (
    <g>
      <rect
        x="64"
        y="124"
        width="72"
        height="56"
        rx="14"
        fill={coral}
        fill-opacity="0.18"
        stroke={coral}
        stroke-width="4"></rect>
      {alignedTeeth.map(x => (
        <rect
          x={x}
          y="136"
          width="14"
          height="30"
          rx="5"
          fill="#ffffff"
          stroke={ink}
          stroke-width="2.5"></rect>
      ))}
    </g>
  )}
  {tool === 'toothbrush' && (
    <g transform="rotate(-38 100 150)">
      <rect x="62" y="144" width="66" height="12" rx="6" fill={ink}></rect>
      <rect
        x="122"
        y="138"
        width="28"
        height="24"
        rx="4"
        fill={coral}
        stroke={ink}
        stroke-width="2.5"></rect>
      <g stroke={ink} stroke-width="3" stroke-linecap="round">
        {bristles.map(x => (
          <path d={`M${x - 2},138 L${x - 2},126`}></path>
        ))}
      </g>
    </g>
  )}
  {tool === 'mirror' && (
    <g stroke={ink} stroke-linecap="round">
      <path d="M100,142 L80,196" stroke-width="6" fill="none"></path>
      <circle cx="112" cy="124" r="19" fill="#ffffff" stroke-width="3.5"></circle>
      <path d="M102,118 C104,112 110,109 116,110" fill="none" stroke-width="3"></path>
    </g>
  )}
</svg>

<style>
  .portrait {
    width: 100%;
    height: 100%;
  }
</style>
