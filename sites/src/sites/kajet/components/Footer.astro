---
import SampleNote from '../../../shared/SampleNote.astro';
import { link } from '../../../shared/link';
import { business, creditsPath, homePath, navItems, type NavKey } from '../data/site';

interface Props {
  current?: NavKey;
}

const { current } = Astro.props;
---

<footer class="foot">
  <div class="foot-cell">
    <a class="brand" href={link(homePath)}>kajet</a>
    <span class="muted">{business.tagline.toLowerCase()}</span>
  </div>
  <nav class="foot-cell foot-nav" aria-label="Stopka">
    {
      navItems.map(item => (
        <a href={link(item.path)} aria-current={item.key === current ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
    <a href={link(creditsPath)}>credits</a>
  </nav>
  <div class="foot-cell foot-note">
    <SampleNote name="Kajet" lang="pl" />
  </div>
  <div class="foot-meta">
    <span>{business.street}, {business.postalCity}</span>
    <a href={business.phoneHref}>{business.phone}</a>
    <a href={`mailto:${business.email}`}>{business.email}</a>
    <div class="keys-sw js-only">
      <button type="button" id="keys-sw" role="switch" aria-checked="true" aria-label="Skróty klawiszowe">
        <span aria-hidden="true">skróty</span>
        <span class="sw-state" aria-hidden="true">wł.</span>
      </button>
    </div>
  </div>
</footer>
