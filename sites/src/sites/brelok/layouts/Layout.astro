---
import SampleNote from '../../../shared/SampleNote.astro';
import { link } from '../../../shared/link';
import Defs from '../components/Defs.astro';
import Nav from '../components/Nav.astro';
import { common, footerKeys } from '../content/common';
import { hotel, roomTypeById } from '../data/hotel';
import type { RoomId } from '../data/hotel';
import { htmlLocale, languages, otherLanguage, pagePath } from '../i18n/lang';
import type { Lang, PageKey } from '../i18n/lang';
import extraCss from '../styles/extra.css?raw';
import fontsCss from '../styles/fonts.css?raw';
import siteCss from '../styles/site.css?raw';

interface Props {
  lang: Lang;
  pageKey: PageKey;
  title: string;
  description: string;
  roomId?: RoomId;
}

const { lang, pageKey, title, description, roomId } = Astro.props;
const text = common[lang];
const isHome = pageKey === 'home';

const pathFor = (target: Lang): string =>
  pagePath(pageKey, target, roomId ? roomTypeById(roomId).slug[target] : undefined);
const absolute = (path: string): string => new URL(link(path), Astro.site).href;
const switchPath = { pl: pathFor('pl'), en: pathFor('en') };

const canonical = absolute(pathFor(lang));
const ogImage = absolute('/brelok/og.png');
const fontBase = link('/brelok/fonts/');
const stylesheet = [fontsCss.replaceAll('../fonts/', fontBase), siteCss, extraCss].join('\n');
const preloaded = ['playfair-display-400-latin', 'playfair-display-400-latin-ext'];
const current = (key: PageKey): 'page' | undefined => (key === pageKey ? 'page' : undefined);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17392c" />
    <link rel="canonical" href={canonical} />
    {languages.map(code => (
      <link rel="alternate" hreflang={code} href={absolute(pathFor(code))} />
    ))}
    <link rel="alternate" hreflang="x-default" href={absolute(pathFor('pl'))} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={hotel.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={htmlLocale[lang]} />
    <meta property="og:locale:alternate" content={htmlLocale[otherLanguage(lang)]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={text.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href={link('/brelok/favicon.svg')} />
    {preloaded.map(name => (
      <link
        rel="preload"
        href={`${fontBase}${name}.woff2`}
        as="font"
        type="font/woff2"
        crossorigin
      />
    ))}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <style is:inline set:html={stylesheet}></style>
  </head>
  <body>
    <Defs />
    <a class="skip" href="#main">
      {text.skip}
    </a>
    {!isHome && (
      <header class="top">
        <Nav lang={lang} pageKey={pageKey} switchPath={switchPath} />
      </header>
    )}
    <main id="main" tabindex="-1" class:list={{ 'is-home': isHome }}>
      <slot />
    </main>
    <footer class="foot">
      <div class="mark brand">{hotel.name}</div>
      <svg class="flo" viewBox="0 0 260 36" aria-hidden="true" focusable="false">
        <use href="#fl"></use>
      </svg>
      <address class="foot-address" aria-label={text.footer.addressLabel}>
        {hotel.fullName}
        <br />
        {lang === 'pl' ? hotel.street : hotel.streetEn}, {hotel.postalCode} {hotel.city}
        <br />
        <a href={hotel.phoneHref}>{hotel.phone}</a>
      </address>
      <p class="foot-hours">{text.footer.reception}</p>
      <nav class="foot-nav" aria-label={text.footerNav}>
        {footerKeys.map(key => (
          <a href={link(pagePath(key, lang))} aria-current={current(key)}>
            {text.nav[key]}
          </a>
        ))}
      </nav>
      <SampleNote name={text.sampleName} lang={lang} />
      <p class="foot-links">
        <a href={link(pagePath('credits', lang))} aria-current={current('credits')}>
          {text.footer.credits}
        </a>
      </p>
    </footer>
    <script is:inline>
      (function () {
        var nav = document.querySelector('.nav');
        var toggle = document.querySelector('.nav-toggle');
        if (!nav || !toggle) return;
        function setOpen(open) {
          nav.setAttribute('data-menu', open ? 'open' : 'closed');
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        toggle.addEventListener('click', function () {
          setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });
        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            toggle.focus();
          }
        });
        document.addEventListener('click', function (event) {
          if (!nav.contains(event.target)) setOpen(false);
        });
      })();
    </script>
  </body>
</html>
