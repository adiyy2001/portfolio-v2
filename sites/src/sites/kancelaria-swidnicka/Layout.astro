---
import { link } from '../../shared/link';
import Footer from './components/Footer.astro';
import { firm, navItems } from './data/site';
import type { NavKey } from './data/site';
import { preloadedFonts } from './fonts';
import { styleBundles } from './styles';
import type { StyleBundle } from './styles';

interface Props {
  title: string;
  description: string;
  path: string;
  current?: NavKey;
  bundles?: StyleBundle[];
}

const { title, description, path, current, bundles = [] } = Astro.props;
const canonical = new URL(link(path), Astro.site).href;
const ogImage = new URL(link('/kancelaria-swidnicka/og.png'), Astro.site).href;
const fullTitle = path === '/kancelaria-swidnicka/' ? title : `${title} | Kancelaria Świdnicka`;
const css = ['core', ...bundles].map(name => styleBundles[name as StyleBundle]).join('');
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f3ec" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={link('/kancelaria-swidnicka/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kancelaria Świdnicka" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Napis Kancelaria Świdnicka czarnym drukiem na kremowym tle, pod nim czerwony pasek z napisem Kancelaria prawna we Wrocławiu."
    />
    <meta name="twitter:card" content="summary_large_image" />
    {preloadedFonts.map(href => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />
    ))}
    <style set:html={css}></style>
    <noscript>
      <style>
        .menu-btn {
          display: none;
        }
        .sitenav ul {
          display: grid;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip" href="#main">
      Przejdź do treści
    </a>
    <header>
      <div class="masthead">
        <a
          class="brand mark"
          href={link('/kancelaria-swidnicka/')}
          aria-label="Kancelaria Świdnicka, strona główna">
          {firm.nameLines.map(line => (
            <span class="name-line">{line}</span>
          ))}
        </a>
        <p class="masthead-place">
          {firm.trade}
          <br />
          od {firm.foundedYear} roku
        </p>
      </div>
      <nav class="sitenav" id="site-nav" aria-label="Główna">
        <button
          type="button"
          class="menu-btn"
          id="menu-btn"
          aria-expanded="false"
          aria-controls="site-links">
          Menu
        </button>
        <ul id="site-links">
          {navItems.map(item => (
            <li>
              <a href={link(item.path)} aria-current={current === item.key ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import './scripts/chrome';
    </script>
  </body>
</html>
