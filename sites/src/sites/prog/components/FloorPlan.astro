---
import type { PlanFloor } from '../plan/types';
import { arrangePlan } from '../plan/arrange';
import { layoutPlan, planScale, type DoorMark, type Segment } from '../plan/layout';

interface Props {
  floor: PlanFloor;
  title: string;
  patternId: string;
}

const { floor, title, patternId } = Astro.props;
const layout = layoutPlan(floor, planScale);
const { bounds } = layout;
const line = (segment: Segment) => ({
  x1: segment.x1,
  y1: segment.y1,
  x2: segment.x2,
  y2: segment.y2,
});
const doorMarks: { mark: DoorMark; entrance: boolean }[] = [
  ...layout.doors.map(mark => ({ mark, entrance: false })),
  ...(layout.entrance ? [{ mark: layout.entrance, entrance: true }] : []),
];
const { rooms: labelledRooms, stairs } = arrangePlan(layout);
const entranceLabel = (() => {
  if (!layout.entrance) return null;
  const gap = layout.entrance.gap;
  const x = (gap.x1 + gap.x2) / 2;
  const y = (gap.y1 + gap.y2) / 2;
  const side = layout.entranceSide;
  if (side === 'bottom') return { x, y: y + 24, anchor: 'middle' };
  if (side === 'top') return { x, y: y - 14, anchor: 'middle' };
  if (side === 'left') return { x: x - 10, y: y + 4, anchor: 'end' };
  return { x: x + 10, y: y + 4, anchor: 'start' };
})();
---

<div class="plan-scroll" data-plan-scroll data-label={`${title}, przewijany poziomo`}>
  <svg
    class="plan"
    style={`min-width:${Math.round(bounds.w * 0.75)}px`}
    viewBox={`${bounds.x} ${bounds.y} ${bounds.w} ${bounds.h}`}
    role="img"
    aria-label={title}
    focusable="false">
    <defs>
      <pattern
        id={patternId}
        width="8"
        height="8"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="8" class="plan-hatch" />
      </pattern>
    </defs>
    {layout.balcony && (
      <rect
        class="plan-balcony"
        x={layout.balcony.x}
        y={layout.balcony.y}
        width={layout.balcony.w}
        height={layout.balcony.h}
      />
    )}
    {labelledRooms.map(room => (
      <rect
        class={`plan-room plan-room-${room.kind}`}
        x={room.x}
        y={room.y}
        width={room.w}
        height={room.h}
      />
    ))}
    {stairs && (
      <rect
        class="plan-stairs"
        x={stairs.x}
        y={stairs.y}
        width={stairs.w}
        height={stairs.h}
        fill={`url(#${patternId})`}
      />
    )}
    <rect class="plan-outer" x="0" y="0" width={layout.width} height={layout.height} />
    {doorMarks.map(({ mark, entrance }) => (
      <g class={entrance ? 'plan-door plan-door-entrance' : 'plan-door'}>
        <line class="plan-gap" {...line(mark.gap)} />
        <line class="plan-leaf" {...line(mark.leaf)} />
        <path class="plan-swing" d={mark.arc} />
      </g>
    ))}
    {layout.windows.map(mark => (
      <g class="plan-window">
        <line class="plan-gap" {...line(mark.gap)} />
        <line class="plan-glass" {...line(mark.gap)} />
      </g>
    ))}
    {labelledRooms.map(room => (
      <g
        class={`plan-label plan-label-${room.kind} ${room.tier.className}`}
        transform={room.upright ? `rotate(-90 ${room.centerX} ${room.centerY})` : undefined}>
        {room.showName && (
          <text
            class="plan-name"
            x={room.centerX}
            y={room.centerY + room.tier.nameBaseline}
            text-anchor="middle">
            {room.name}
          </text>
        )}
        <text
          class="plan-area"
          x={room.centerX}
          y={room.centerY + (room.showName ? room.tier.areaBaseline : room.tier.areaOnlyBaseline)}
          text-anchor="middle">
          {room.areaText}
        </text>
      </g>
    ))}
    {layout.balcony && (
      <text
        class="plan-label plan-area"
        x={layout.balcony.x + layout.balcony.w / 2}
        y={layout.balcony.y + layout.balcony.h / 2}
        text-anchor="middle"
        dominant-baseline="central">
        Balkon
      </text>
    )}
    {entranceLabel && (
      <text
        class="plan-entrance-label"
        x={entranceLabel.x}
        y={entranceLabel.y}
        text-anchor={entranceLabel.anchor}>
        Wejście
      </text>
    )}
  </svg>
</div>

<script>
  const regions = document.querySelectorAll<HTMLElement>('[data-plan-scroll]');
  const syncFocus = () => {
    regions.forEach(region => {
      if (region.scrollWidth > region.clientWidth + 1) {
        region.tabIndex = 0;
        region.setAttribute('role', 'region');
        region.setAttribute('aria-label', region.dataset.label ?? 'Rzut');
      } else {
        region.removeAttribute('tabindex');
        region.removeAttribute('role');
        region.removeAttribute('aria-label');
      }
    });
  };
  syncFocus();
  window.addEventListener('resize', syncFocus);
</script>
