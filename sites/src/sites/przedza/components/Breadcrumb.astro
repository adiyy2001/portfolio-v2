---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: readonly Crumb[];
}

const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Ścieżka">
  <ol>
    {items.map(item => (
      <li>
        {item.href ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
