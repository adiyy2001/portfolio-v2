---
import { formatMetres } from '../drawings';

const k = 110;
const x0 = 80;
const y0 = 100;
const w = 2.3 * k;
const h = 2.6 * k;
const transom = h * 0.22;
const third = w / 3;
---

<svg
  class="dr"
  viewBox="0 0 600 560"
  role="img"
  aria-label="Detal okna: trzy skrzydła z nadświetlem, szerokość 2,30 metra, wysokość 2,60 metra, nadproże z cegły i parapet."
  focusable="false">
  <path class="dr-lintel" d={`M${x0 - 22} ${y0 - 8}H${x0 + w + 22}V${y0 - 40}H${x0 - 22}Z`}></path>
  {Array.from({ length: 11 }, (_, index) => (
    <line
      class="dr-course"
      x1={x0 - 22 + index * ((w + 44) / 10)}
      y1={y0 - 40}
      x2={x0 - 22 + index * ((w + 44) / 10)}
      y2={y0 - 8}></line>
  ))}
  <rect class="dr-frame" x={x0 - 8} y={y0 - 8} width={w + 16} height={h + 16}></rect>
  <rect class="dr-glass-fill" x={x0} y={y0} width={w} height={h}></rect>
  <rect class="dr-sash" x={x0} y={y0} width={third} height={h - transom}></rect>
  <rect class="dr-sash" x={x0 + third} y={y0} width={third} height={h - transom}></rect>
  <rect class="dr-sash" x={x0 + 2 * third} y={y0} width={third} height={h - transom}></rect>
  <rect class="dr-sash" x={x0} y={y0 + h - transom} width={w} height={transom}></rect>
  <path
    class="dr-swing"
    d={`M${x0 + third} ${y0}L${x0} ${y0 + (h - transom) / 2}L${x0 + third} ${y0 + h - transom}`}></path>
  <path
    class="dr-swing"
    d={`M${x0 + 2 * third} ${y0}L${x0 + w} ${y0 + (h - transom) / 2}L${x0 + 2 * third} ${y0 + h - transom}`}></path>
  <rect class="dr-sill" x={x0 - 22} y={y0 + h + 8} width={w + 44} height="12"></rect>
  <rect class="dr-wall" x={x0 - 52} y={y0 - 8} width="30" height={h + 28}></rect>
  <rect class="dr-wall" x={x0 + w + 22} y={y0 - 8} width="30" height={h + 28}></rect>

  <g class="dr-dim">
    <line x1={x0} y1={y0 + h + 60} x2={x0 + w} y2={y0 + h + 60}></line>
    <line x1={x0} y1={y0 + h + 52} x2={x0} y2={y0 + h + 68}></line>
    <line x1={x0 + w} y1={y0 + h + 52} x2={x0 + w} y2={y0 + h + 68}></line>
    <text class="dr-text" x={x0 + w / 2} y={y0 + h + 94} text-anchor="middle">
      {formatMetres(2.3)}
    </text>

    <line x1={x0 + w + 78} y1={y0} x2={x0 + w + 78} y2={y0 + h}></line>
    <line x1={x0 + w + 70} y1={y0} x2={x0 + w + 86} y2={y0}></line>
    <line x1={x0 + w + 70} y1={y0 + h} x2={x0 + w + 86} y2={y0 + h}></line>
    <text class="dr-text" x={x0 + w + 96} y={y0 + h / 2 + 6}>
      {formatMetres(2.6)}
    </text>
  </g>

  <g class="dr-note">
    <text class="dr-text" x="20" y="40">
      nadproże: rząd cegieł na sztorc
    </text>
    <text class="dr-text" x={x0 + w + 96} y={y0 + h / 2 + 36}>
      parapet
    </text>
    <text class="dr-text" x={x0 + w + 96} y={y0 + h / 2 + 62}>
      0,5 m
    </text>
  </g>
</svg>
