---
import { tie } from '../logic/typography';

interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props;
---

<section class="end band band--tomato" aria-labelledby="end-title">
  <div class="band__inner end__inner">
    <div class="end__text">
      <h2 id="end-title">{tie(title)}</h2>
      <p>{tie(text)}</p>
    </div>
    <div class="end__actions">
      <slot />
    </div>
  </div>
</section>
