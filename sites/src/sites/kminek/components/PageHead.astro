---
import { tie } from '../logic/typography';

interface Props {
  title: string;
  lead: string;
}

const { title, lead } = Astro.props;
---

<section class="head band band--seeds" aria-labelledby="page-title">
  <div class="band__inner head__inner">
    <h1 id="page-title">{tie(title)}</h1>
    <p class="head__lead">{tie(lead)}</p>
    <slot />
  </div>
</section>
