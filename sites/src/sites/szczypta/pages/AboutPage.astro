---
import type { Lang } from '../data/lang';
import { team } from '../data/team';
import { footnotes } from '../data/suppliers';
import { paths } from '../data/routes';
import { aboutCopy } from '../copy/about';
import { link } from '../../../shared/link';
import { imageAlt } from '../logic/alt';
import { tie } from '../logic/typography';
import Layout from '../components/Layout.astro';
import Frame from '../components/Frame.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = aboutCopy[lang];
---

<Layout lang={lang} page="about" title={copy.title} description={copy.description}>
  <section class="page-head">
    <h1>{copy.h1}</h1>
    <p class="page-lead">{tie(copy.lead)}</p>
  </section>
  <div class="section section--grid">
    <div class="prose">
      {copy.story.map(text => (
        <p>{tie(text)}</p>
      ))}
    </div>
    <Frame id="sala" alt={imageAlt('sala', lang)} caption={copy.room.caption} />
  </div>
  <section class="section">
    <h2 class="section-title">{copy.team.title}</h2>
    <div class="team">
      {team.map(person => (
        <div class="person">
          <h3>{person.name}</h3>
          <p class="kicker">{person.role[lang]}</p>
          <p>{tie(person.bio[lang])}</p>
        </div>
      ))}
    </div>
  </section>
  <section class="section">
    <h2 class="section-title">{copy.suppliers.title}</h2>
    <table class="suppliers">
      <thead>
        <tr>
          {copy.suppliers.head.map(label => (
            <th scope="col">{label}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {footnotes.map(item => (
          <tr>
            <th scope="row">{item.product[lang]}</th>
            <td>{item.supplier[lang]}</td>
            <td>{item.when[lang]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
  <section class="section">
    <h2 class="section-title">{copy.room.title}</h2>
    <p class="prose">{tie(copy.room.text)}</p>
    <p class="page-links">
      <a class="cta" href={link(paths[lang].booking!)}>
        {copy.cta}
      </a>
    </p>
  </section>
</Layout>
