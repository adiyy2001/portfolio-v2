---
import { place } from '../data/place';
import { contactCopy } from '../copy/contact';
import { tie } from '../logic/typography';
import Layout from '../components/Layout.astro';
import Address from '../components/Address.astro';
import HoursTable from '../components/HoursTable.astro';
import ContactForm from '../islands/ContactForm';

const copy = contactCopy;
---

<Layout lang="pl" page="contact" title={copy.title} description={copy.description}>
  <section class="page-head">
    <h1>{copy.h1}</h1>
    <p class="page-lead">{tie(copy.lead)}</p>
  </section>
  <div class="contact-page">
    <div class="contact-info">
      <Address lang="pl" name note id="contact-address" />
      <HoursTable lang="pl" />
      <p class="page-note">{tie(copy.kitchenBreak)}</p>
      <p class="page-note">{copy.mapNote}</p>
    </div>
    <div class="contact-main">
      <ContactForm client:only="preact" />
      <noscript>
        <p>
          {copy.noscript} <a href={`mailto:${place.email}`}>{place.email}</a>.
        </p>
      </noscript>
    </div>
  </div>
</Layout>
