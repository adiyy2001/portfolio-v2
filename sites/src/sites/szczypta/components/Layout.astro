---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/shell.css';
import '../styles/hero.css';
import '../styles/menu.css';
import '../styles/booking.css';
import '../styles/pages.css';
import type { Lang } from '../data/lang';
import { langs } from '../data/lang';
import type { PageId, PagePair } from '../data/routes';
import { hasTranslation, paths, switchTarget } from '../data/routes';
import { fontFaces } from '../data/font-faces';
import { shellCopy } from '../copy/shell';
import { link } from '../../../shared/link';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';

interface Props {
  lang: Lang;
  page: PageId;
  title: string;
  description: string;
  variant?: 'hero' | 'sub';
  pair?: PagePair;
}

const { lang, page, title, description, variant = 'sub', pair } = Astro.props;
const copy = shellCopy[lang];
const absolute = (path: string) => new URL(link(path), Astro.site).href;
const own = pair ?? { pl: paths.pl[page], en: paths.en[page] };
const canonical = absolute(own[lang]!);
const translated = pair !== undefined || hasTranslation(page);
const alternates = translated ? langs.map(code => ({ code, href: absolute(own[code]!) })) : [];
const switchHref = link(switchTarget(lang, page, pair));
const ogImage = absolute(lang === 'pl' ? '/szczypta/og.png' : '/szczypta/og-en.png');
const locales = { pl: 'pl_PL', en: 'en_GB' } as const;
const alternateLocale = lang === 'pl' ? locales.en : locales.pl;
const preload = [
  'cormorant-garamond-latin-500-normal.woff2',
  'cormorant-garamond-latin-600-normal.woff2',
  'jost-latin-400-normal.woff2',
].map(file => link(`/szczypta/fonts/${file}`));
const inlineCss = fontFaces
  .map(
    face =>
      `@font-face{font-family:'${face.family}';font-style:${face.style};font-weight:${face.weight};font-display:swap;src:url(${link(`/szczypta/fonts/${face.file}`)}) format('woff2');unicode-range:${face.range}}`,
  )
  .join('');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3ead8" />
    <link rel="canonical" href={canonical} />
    {alternates.map(item => (
      <link rel="alternate" hreflang={item.code} href={item.href} />
    ))}
    {translated && <link rel="alternate" hreflang="x-default" href={absolute(own.pl!)} />}
    <link rel="icon" type="image/svg+xml" href={link('/szczypta/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Szczypta" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locales[lang]} />
    {translated && <meta property="og:locale:alternate" content={alternateLocale} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {preload.map(href => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <style set:html={inlineCss}></style>
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      {copy.skip}
    </a>
    {variant === 'sub' && (
      <header class="top">
        <SiteHeader lang={lang} page={page} variant="sub" switchHref={switchHref} />
      </header>
    )}
    <slot name="hero" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} page={page} />
    <script>
      import '../scripts/shell';
    </script>
  </body>
</html>
