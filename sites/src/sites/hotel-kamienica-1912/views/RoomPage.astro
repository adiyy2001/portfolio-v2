---
import { link } from '../../../shared/link';
import InkPanel from '../components/InkPanel.astro';
import Panel from '../components/Panel.astro';
import SectionHead from '../components/SectionHead.astro';
import { roomCopy, roomsText } from '../content/rooms';
import { roomTypeById, roomTypes, hotel, padNumber } from '../data/hotel';
import type { RoomId } from '../data/hotel';
import { pagePath } from '../i18n/lang';
import type { Lang } from '../i18n/lang';
import Layout from '../layouts/Layout.astro';
import { formatMoney, guestsLabel, numberList } from '../lib/format';

interface Props {
  lang: Lang;
  roomId: RoomId;
}

const { lang, roomId } = Astro.props;
const text = roomsText[lang];
const type = roomTypeById(roomId);
const copy = roomCopy[lang][roomId];
const others = roomTypes.filter(item => item.id !== roomId);
const photo = (id: string, small = false): string =>
  link(`/hotel-kamienica-1912/rooms/room-${id}${small ? '-s' : ''}.webp`);
---

<Layout
  lang={lang}
  pageKey="rooms"
  roomId={roomId}
  title={copy.metaTitle}
  description={copy.metaDescription}>
  <Panel labelledby="room-h" first>
    <SectionHead id="room-h" level="h1">
      {text.roomHeading(copy.name)}
    </SectionHead>
    <p class="lead">{copy.intro}</p>
    <div class="room-hero">
      <figure>
        <span class="pic">
          <img src={photo(roomId)} width="900" height="675" alt={copy.alt} />
        </span>
        <figcaption>{text.photoNote}</figcaption>
      </figure>
      <div>
        <dl class="leaders">
          <div>
            <dt>{text.leaders.numbers}</dt>
            <dd>{numberList(type.numbers, lang)}</dd>
          </div>
          <div>
            <dt>{text.leaders.floorCount}</dt>
            <dd>{type.numbers.length}</dd>
          </div>
          <div>
            <dt>{text.leaders.area}</dt>
            <dd>{type.area} m²</dd>
          </div>
          <div>
            <dt>{text.leaders.bed}</dt>
            <dd class="text">{copy.bed(type.bedWidth)}</dd>
          </div>
          <div>
            <dt>{text.leaders.guests}</dt>
            <dd>{guestsLabel(type.guests, lang)}</dd>
          </div>
          <div>
            <dt>{text.leaders.view}</dt>
            <dd class="text">{copy.view}</dd>
          </div>
          <div>
            <dt>{text.leaders.rate}</dt>
            <dd>{formatMoney(type.rate, lang)}</dd>
          </div>
        </dl>
        <div class="prose">
          {copy.paragraphs.map(paragraph => (
            <p>{paragraph}</p>
          ))}
        </div>
        <p class="actions">
          <a class="ticket" href={`${link(pagePath('booking', lang))}?room=${type.id}`}>
            {text.book}
          </a>
          <a class="ticket" href={hotel.phoneHref}>
            {hotel.phone}
          </a>
        </p>
      </div>
    </div>
    <h2 class="sub">{text.includedHeading}</h2>
    <ul class="bullets">
      {copy.features.map(feature => (
        <li>{feature}</li>
      ))}
    </ul>
    <p class="notice">{text.numbering}</p>
    <p class="notice">{text.includedBreakfast}</p>
  </Panel>
  <InkPanel labelledby="other-h">
    <SectionHead id="other-h">{text.otherRooms}</SectionHead>
    <ul class="other-rooms plates">
      {others.map(item => {
        const itemCopy = roomCopy[lang][item.id];
        return (
          <li class="rp">
            <a class="rp-face" href={link(pagePath('rooms', lang, item.slug[lang]))}>
              <span class="ov">
                <span class="sr">{text.leaders.numbers} </span>
                {padNumber(item.showcase)}
              </span>
              <span class="pic">
                <img
                  src={photo(item.id, true)}
                  width="480"
                  height="360"
                  alt={itemCopy.alt}
                  loading="lazy"
                />
              </span>
              <span class="rname">{itemCopy.name}</span>
              <span class="lr">
                <span class="lk">{text.leaders.area}</span>
                <i></i>
                <b>{item.area} m²</b>
              </span>
              <span class="lr">
                <span class="lk">{text.leaders.rate}</span>
                <i></i>
                <b>{formatMoney(item.rate, lang)}</b>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
    <p class="notice">{text.photoNote}</p>
    <p class="actions">
      <a class="ticket rev" href={link(pagePath('rooms', lang))}>
        {text.allRooms}
      </a>
    </p>
  </InkPanel>
</Layout>
