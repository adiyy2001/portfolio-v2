---
import { link } from '../../../shared/link';
import Panel from '../components/Panel.astro';
import SectionHead from '../components/SectionHead.astro';
import { roomCopy, roomsText } from '../content/rooms';
import { roomTypes, padNumber } from '../data/hotel';
import { pagePath } from '../i18n/lang';
import type { Lang } from '../i18n/lang';
import Layout from '../layouts/Layout.astro';
import { formatMoney, numberList } from '../lib/format';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const text = roomsText[lang];
const photo = (id: string, small = false): string =>
  link(`/hotel-kamienica-1912/rooms/room-${id}${small ? '-s' : ''}.webp`);
---

<Layout lang={lang} pageKey="rooms" title={text.metaTitle} description={text.metaDescription}>
  <Panel labelledby="rooms-h" first>
    <SectionHead id="rooms-h" level="h1">
      {text.heading}
    </SectionHead>
    <p class="lead">{text.lead}</p>
    <p class="notice">{text.numbering}</p>
    <ul class="room-list">
      {roomTypes.map(type => {
        const copy = roomCopy[lang][type.id];
        return (
          <li>
            <article class="room-row" aria-labelledby={`room-${type.id}-h`}>
              <div class="pic-wrap">
                <span class="ov">
                  <span class="sr">{text.leaders.numbers} </span>
                  {padNumber(type.showcase)}
                </span>
                <span class="pic">
                  <img
                    src={photo(type.id)}
                    width="900"
                    height="675"
                    alt={copy.alt}
                    loading="lazy"
                  />
                </span>
              </div>
              <div>
                <h2 id={`room-${type.id}-h`}>{copy.name}</h2>
                <p>{copy.intro}</p>
                <dl class="leaders">
                  <div>
                    <dt>{text.leaders.numbers}</dt>
                    <dd>{numberList(type.numbers, lang)}</dd>
                  </div>
                  <div>
                    <dt>{text.leaders.area}</dt>
                    <dd>{type.area} m²</dd>
                  </div>
                  <div>
                    <dt>{text.leaders.bed}</dt>
                    <dd class="text">{copy.bed(type.bedWidth)}</dd>
                  </div>
                  <div>
                    <dt>{text.leaders.rate}</dt>
                    <dd>{formatMoney(type.rate, lang)}</dd>
                  </div>
                </dl>
                <p class="actions">
                  <a class="ticket" href={link(pagePath('rooms', lang, type.slug[lang]))}>
                    {text.details}
                    <span class="sr">: {copy.name}</span>
                  </a>
                  <a class="ticket" href={`${link(pagePath('booking', lang))}?room=${type.id}`}>
                    {text.book}
                    <span class="sr">: {copy.name}</span>
                  </a>
                </p>
              </div>
            </article>
          </li>
        );
      })}
    </ul>
    <p class="notice">{text.includedBreakfast}</p>
    <p class="notice">{text.photoNote}</p>
  </Panel>
</Layout>
