---
import { link } from '../../shared/link';
import SampleNote from '../../shared/SampleNote.astro';
import { business, openingDays } from './data/business';
import { preloadedFonts } from './fonts';
import { navItems } from './nav';
import type { NavKey } from './nav';
import FavouritesLink from './islands/FavouritesLink';
import { styleBundles } from './styles';
import type { StyleBundle } from './styles';

interface Props {
  title: string;
  description: string;
  path: string;
  current?: NavKey;
  bundles?: StyleBundle[];
}

const { title, description, path, current, bundles = [] } = Astro.props;
const isHome = path === '/nieruchomosci-psie-pole/';
const canonical = new URL(link(path), Astro.site).href;
const ogImage = new URL(link('/nieruchomosci-psie-pole/og.png'), Astro.site).href;
const fullTitle = isHome ? title : `${title} | Nieruchomości Psie Pole`;
const css = ['core', ...bundles].map(name => styleBundles[name as StyleBundle]).join('');
const BrandTag = isHome ? 'h1' : 'p';
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f5" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={link('/nieruchomosci-psie-pole/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nieruchomości Psie Pole" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Okładka magazynu ofert Nieruchomości Psie Pole, numer 11, listopad 2026, na kremowym papierze."
    />
    <meta name="twitter:card" content="summary_large_image" />
    {preloadedFonts.map(href => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />
    ))}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <style set:html={css}></style>
  </head>
  <body>
    <a class="skip" href="#main">
      Przejdź do treści
    </a>
    <header class:list={['runhead', { 'runhead--compact': !isHome }]}>
      <BrandTag class="brand-title">
        <a
          class="brand"
          href={link('/nieruchomosci-psie-pole/')}
          aria-label={isHome ? undefined : 'Nieruchomości Psie Pole, strona główna'}>
          <span class="brand-trade">Nieruchomości</span> <span class="brand-place">Psie Pole</span>
        </a>
      </BrandTag>
      <p class="issue">
        <span class="issue-kind">{business.tagline}</span>
        <span class="issue-date">{business.issue.label}</span>
      </p>
      <a class="call" href={business.phoneHref}>
        {business.phone}
      </a>
    </header>
    <nav class="sitenav" id="site-nav" aria-label="Główna">
      <button
        type="button"
        class="menu-btn"
        id="menu-btn"
        aria-expanded="false"
        aria-controls="site-nav-list">
        Menu
      </button>
      <ul class="sitenav-list" id="site-nav-list">
        {navItems.map(item => (
          <li>
            {item.key === 'ulubione' ? (
              <FavouritesLink client:idle current={current === 'ulubione'} />
            ) : (
              <a href={link(item.path)} aria-current={current === item.key ? 'page' : undefined}>
                {item.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="foot">
      <div class="foot-grid">
        <div>
          <p class="foot-brand">
            <span class="brand-trade">Nieruchomości</span>{' '}
            <span class="brand-place">Psie Pole</span>
          </p>
          <p>{business.tagline}</p>
          <address>
            Biuro nieruchomości
            <br />
            {business.street}
            <br />
            {business.postcode} {business.city}, {business.district}
          </address>
        </div>
        <div>
          <h2>W serwisie</h2>
          <ul>
            {navItems.map(item => (
              <li>
                <a href={link(item.path)}>{item.label}</a>
              </li>
            ))}
            <li>
              <a href={link('/nieruchomosci-psie-pole/credits/')}>Źródła zdjęć i czcionek</a>
            </li>
          </ul>
        </div>
        <div class="contact">
          <h2>Biuro</h2>
          <p>
            {openingDays.map(day => (
              <span>
                {day.label}:{' '}
                {day.opens !== null ? `${day.opens}:00 do ${day.closes}:00` : 'zamknięte'}
                <br />
              </span>
            ))}
          </p>
          <p>
            <a href={business.phoneHref}>{business.phone}</a>
          </p>
          <p>
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </p>
        </div>
      </div>
      <div class="foot-tail">
        <SampleNote name="Nieruchomości Psie Pole" lang="pl" />
      </div>
    </footer>
    <script>
      import './scripts/chrome';
    </script>
  </body>
</html>
