---
import { imageSet } from '../lib/images';

interface Props {
  photoKey: string;
  widths: number[];
  width: number;
  height: number;
  alt: string;
  sizes: string;
  eager?: boolean;
}

const { photoKey, widths, width, height, alt, sizes, eager = false } = Astro.props;
const images = imageSet(photoKey, widths);
---

<img
  src={images.src}
  srcset={images.srcset}
  sizes={sizes}
  width={width}
  height={height}
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
/>
