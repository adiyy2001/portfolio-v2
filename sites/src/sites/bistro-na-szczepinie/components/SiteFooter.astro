---
import type { Lang } from '../data/lang';
import type { PageId } from '../data/routes';
import { paths } from '../data/routes';
import { openingRows } from '../data/hours';
import { shellCopy } from '../copy/shell';
import { link } from '../../../shared/link';
import SampleNote from '../../../shared/SampleNote.astro';
import Address from './Address.astro';

interface Props {
  lang: Lang;
  page: PageId;
}

const { lang, page } = Astro.props;
const copy = shellCopy[lang];
const route = paths[lang];
const rows = openingRows(lang);
type FooterId = Exclude<PageId, 'home'>;
const order: FooterId[] = ['menu', 'booking', 'events', 'about', 'contact', 'credits'];
const entries = order.filter(id => route[id] !== undefined).map(id => ({ id, href: route[id]! }));
---

<footer class="foot">
  <div class="foot-grid">
    <div>
      <p class="brand foot-brand">
        <span class="brand-main">Bistro</span>
        <span class="brand-sub">na Szczepinie</span>
      </p>
    </div>
    <nav aria-label={copy.footer.pagesLabel}>
      <p class="foot-title" aria-hidden="true">
        {copy.footer.pagesLabel}
      </p>
      <div class="foot-links">
        {entries.map(entry => (
          <>
            <a href={link(entry.href)} aria-current={page === entry.id ? 'page' : undefined}>
              {copy.footer.pages[entry.id]}
            </a>{' '}
          </>
        ))}
      </div>
    </nav>
    <div>
      <p class="foot-title">{copy.footer.contactTitle}</p>
      <Address lang={lang} class="foot-contact" id="footer-contact" />
    </div>
    <div class="foot-hours">
      <p class="foot-title">{copy.footer.hoursTitle}</p>
      <dl>
        {rows.map(row => (
          <>
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </>
        ))}
      </dl>
      <p class="foot-text">{copy.footer.kitchenNote}</p>
    </div>
    <div class="foot-note">
      <SampleNote name="Bistro na Szczepinie" lang={lang} />
    </div>
  </div>
</footer>
