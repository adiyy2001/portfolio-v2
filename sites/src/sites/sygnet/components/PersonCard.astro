---
import { link } from '../../../shared/link';
import type { Person } from '../data/people';

interface Props {
  person: Person;
  headingLevel?: 'h2' | 'h3';
  linked?: boolean;
}

const { person, headingLevel = 'h3', linked = true } = Astro.props;
const Heading = headingLevel;
---

<article class="person" id={person.slug}>
  <p class="person-mono" aria-hidden="true">
    {person.monogram}
  </p>
  <div class="person-body">
    <p class="person-role">{person.role}</p>
    <Heading>
      {linked ? <a href={link(`/sygnet/zespol/#${person.slug}`)}>{person.name}</a> : person.name}
    </Heading>
    <p>{person.short}</p>
    <p class="person-line">
      <a href={person.phone.href}>{person.phone.display}</a>
    </p>
    <p class="person-line">
      <a href={`mailto:${person.email}`}>{person.email}</a>
    </p>
  </div>
</article>
