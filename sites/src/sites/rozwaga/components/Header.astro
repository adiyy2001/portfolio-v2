---
import { navigation } from '../data/site';
import { siteHref } from '../lib/paths';
import Arrow from './Arrow.astro';

interface Props {
  current?: string;
  exact?: boolean;
}

const { current, exact = false } = Astro.props;
const markFor = (key: string): 'page' | 'true' | undefined =>
  key === current ? (exact ? 'page' : 'true') : undefined;
---

<header class="site-header">
  <div class="wrap site-header__bar">
    <a class="wordmark" href={siteHref('/')}>
      <span class="wordmark__name">Rozwaga</span>
      <span class="wordmark__trade">kancelaria radcy prawnego</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-toggle__label">Menu</span>
      <span class="menu-toggle__bars" aria-hidden="true"></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Główna">
      <ul class="site-nav__list">
        {navigation.map(item => {
          const key = item.href.split('/')[1] ?? '';
          return (
            <li>
              <a href={siteHref(item.href)} aria-current={markFor(key)}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
      <a class="button button--compact" href={siteHref('/kontakt/#formularz')}>
        Umów konsultację
        <Arrow />
      </a>
    </nav>
  </div>
</header>
