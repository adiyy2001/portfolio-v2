---
import { siteHref } from '../lib/paths';
import { tie } from '../lib/tie';
import Seal from './Seal.astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  crumbs: Crumb[];
  lead?: string;
  seal?: boolean;
  long?: boolean;
}

const { title, crumbs, lead, seal = true, long = false } = Astro.props;
---

<section class:list={['page-head', { 'page-head--long': long }]}>
  <div class="wrap">
    <div class="page-head__inner">
      <nav class="crumbs label" aria-label="Ścieżka">
        <ol>
          {crumbs.map((crumb, index) => (
            <li>
              {crumb.href ? (
                <a href={siteHref(crumb.href)}>{crumb.label}</a>
              ) : (
                <span aria-current="page">{crumb.label}</span>
              )}
              {index < crumbs.length - 1 && <span aria-hidden="true">/</span>}
            </li>
          ))}
        </ol>
      </nav>
      {seal && <Seal class="page-head__seal" />}
      <h1 class="display page-head__title">{tie(title)}</h1>
      {lead && <p class="lead page-head__lead">{tie(lead)}</p>}
      <slot />
    </div>
  </div>
</section>
