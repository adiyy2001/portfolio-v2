---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
const contractLines = [
  { y: 34, width: 380 },
  { y: 54, width: 340 },
  { y: 74, width: 392 },
  { y: 94, width: 300 },
  { y: 114, width: 360 },
];
const timelineNodes = [60, 230, 400, 580];
const planWalls = [
  'M40 20V130',
  'M40 20H600',
  'M600 20V130',
  'M40 130H600',
  'M240 20V90',
  'M240 90H340',
  'M420 20V130',
];
---

<figure class="specimen" aria-hidden="true">
  <svg
    class="specimen__svg"
    viewBox="0 0 640 150"
    preserveAspectRatio="xMidYMid slice"
    focusable="false">
    <defs>
      <pattern
        id="specimen-hatch"
        width="6"
        height="6"
        patternUnits="userSpaceOnUse"
        patternTransform="rotate(45)">
        <path d="M0 0v6" stroke="#121212" stroke-width="1"></path>
      </pattern>
      <pattern id="specimen-dots" width="7" height="7" patternUnits="userSpaceOnUse">
        <circle cx="3.5" cy="3.5" r="0.9" fill="#121212"></circle>
      </pattern>
    </defs>
    <rect width="640" height="150" fill="#fff"></rect>
    {slug === 'prawo-spolek' && (
      <g>
        <rect
          x="40"
          y="48"
          width="280"
          height="54"
          fill="url(#specimen-hatch)"
          stroke="#121212"
          stroke-width="1.5"></rect>
        <rect
          x="320"
          y="48"
          width="280"
          height="54"
          fill="url(#specimen-dots)"
          stroke="#121212"
          stroke-width="1.5"></rect>
        <rect x="140" y="62" width="80" height="26" fill="#fff"></rect>
        <rect x="420" y="62" width="80" height="26" fill="#fff"></rect>
        <text class="specimen__figure" x="180" y="86" text-anchor="middle">
          50
        </text>
        <text class="specimen__figure" x="460" y="86" text-anchor="middle">
          50
        </text>
        <path d="M320 24V126" stroke="#b3122a" stroke-width="3" stroke-dasharray="8 6"></path>
        <circle cx="180" cy="28" r="9" fill="none" stroke="#121212" stroke-width="1.5"></circle>
        <circle cx="460" cy="28" r="9" fill="none" stroke="#121212" stroke-width="1.5"></circle>
        <path d="M40 124H600" stroke="#121212" stroke-width="1"></path>
      </g>
    )}
    {slug === 'umowy' && (
      <g>
        <path d="M40 18H600M40 22H600" stroke="#121212" stroke-width="1"></path>
        {contractLines.map(line => (
          <path d={`M96 ${line.y + 6}h${line.width}`} stroke="#121212" stroke-width="1.5"></path>
        ))}
        <path d="M84 52V80M84 52h8M84 80h8" stroke="#b3122a" stroke-width="3" fill="none"></path>
        <text class="specimen__figure" x="48" y="82">
          §
        </text>
        <path d="M500 112h90M500 78h90" stroke="#121212" stroke-width="1.5"></path>
        <path d="M520 100l14-18M534 100l-14-18" stroke="#b3122a" stroke-width="2.5"></path>
        <path d="M40 132H600M40 128H600" stroke="#121212" stroke-width="1"></path>
      </g>
    )}
    {slug === 'spory-sadowe' && (
      <g>
        <path d="M40 92H600" stroke="#121212" stroke-width="2"></path>
        {Array.from({ length: 53 }, (_, index) => (
          <path
            d={`M${60 + index * 10} 92v${index % 5 === 0 ? 12 : 6}`}
            stroke="#121212"
            stroke-width="1"></path>
        ))}
        {timelineNodes.map((x, index) => (
          <g>
            <path d={`M${x} 92V${52 - index * 6}`} stroke="#121212" stroke-width="1.5"></path>
            <rect
              x={x - 22}
              y={22 - index * 3}
              width="44"
              height={32 + index * 3}
              fill="#fff"
              stroke="#121212"
              stroke-width="1.5"></rect>
            <path
              d={`M${x - 14} ${34 - index * 3}h28M${x - 14} ${42 - index * 3}h28M${x - 14} ${50 - index * 3}h18`}
              stroke="#121212"
              stroke-width="1"></path>
            <circle
              cx={x}
              cy="92"
              r="7"
              fill={index === 3 ? '#b3122a' : '#fff'}
              stroke="#121212"
              stroke-width="2"></circle>
          </g>
        ))}
        <path d="M230 124H400" stroke="#b3122a" stroke-width="3" stroke-dasharray="8 6"></path>
      </g>
    )}
    {slug === 'nieruchomosci' && (
      <g>
        {planWalls.map(wall => (
          <path
            d={wall}
            stroke="#121212"
            stroke-width="5"
            fill="none"
            stroke-linecap="square"></path>
        ))}
        <path d="M240 90A40 40 0 0 1 280 50" stroke="#121212" stroke-width="1" fill="none"></path>
        <path d="M420 100A30 30 0 0 0 450 130" stroke="#121212" stroke-width="1" fill="none"></path>
        <rect x="44" y="24" width="190" height="102" fill="url(#specimen-dots)"></rect>
        <rect
          x="470"
          y="40"
          width="100"
          height="60"
          fill="url(#specimen-hatch)"
          stroke="#121212"
          stroke-width="1"></rect>
        <circle cx="330" cy="62" r="9" fill="#b3122a" stroke="#fff" stroke-width="2"></circle>
        <path d="M40 142H600M40 136v12M600 136v12" stroke="#121212" stroke-width="1"></path>
      </g>
    )}
  </svg>
</figure>
