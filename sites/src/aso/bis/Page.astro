---
import { link, portfolio } from '../../shared/link';
import AbPair from '../shared/AbPair.astro';
import Downloads from '../shared/Downloads.astro';
import LangFiles from '../shared/LangFiles.astro';
import LangSwitch from '../shared/LangSwitch.tsx';
import SampleLine from '../shared/SampleLine.astro';
import SearchMock from '../shared/SearchMock.astro';
import Shell from '../shared/Shell.astro';
import StoreStrip from '../shared/StoreStrip.astro';
import {
  assetUrl,
  featureOf,
  fontFaceCss,
  preloadFonts,
  readManifest,
  shotsOf,
} from '../shared/manifest';
import type { AsoCopy } from '../shared/types';
import { glue } from '../shared/typography';
import Chrome from './Chrome.astro';
import { app } from './app';
import { content } from './content';
import en from './copy/en.json';
import pl from './copy/pl.json';
import { css } from './styles';
import { keepLast, sparkles, starPath, tilt } from './view';

const manifest = readManifest('bis');
const copies = { pl: pl as AsoCopy, en: en as AsoCopy };
const sets = {
  pl: {
    appstore: shotsOf(manifest, copies.pl, 'appstore'),
    play: shotsOf(manifest, copies.pl, 'play'),
  },
  en: {
    appstore: shotsOf(manifest, copies.en, 'appstore'),
    play: shotsOf(manifest, copies.en, 'play'),
  },
};
const variantA = sets.pl.appstore[0];
const variantB = shotsOf(manifest, copies.pl, 'appstore', { variant: 'b' })[0];
const variantPlayA = sets.pl.play[0];
const variantPlayB = shotsOf(manifest, copies.pl, 'play', { variant: 'b' })[0];
const features = [featureOf(manifest, copies.pl), featureOf(manifest, copies.en)];
const icon = assetUrl('bis', 'icons/icon-256.png');
const palette = manifest.palette;
const artists = Object.values(pl.ui.artists).map(item => item.name);
const venues = Object.values(pl.ui.venues).map(item => item.name);
const sections = [
  ['zadanie', 'Zadanie'],
  ['kierunek', 'Kierunek'],
  ['setlista', 'Setlista'],
  ['miniatury', 'Miniatury'],
  ['zestaw', 'PL i EN'],
  ['test', 'Test A/B'],
  ['grafiki', 'Grafiki'],
  ['pliki', 'Pliki'],
  ['jezyki', 'Języki'],
];
---

<Shell
  app={app}
  title={content.title}
  description={content.description}
  css={fontFaceCss(manifest) + css}
  preload={preloadFonts(manifest, [400, 600])}
  bodyClass="bis">
  <header class="top">
    <a href={link('/aso/')}>Wzornik, screenshoty</a>
    <a href={portfolio('/dla-klienta/#wzornik')}>Wróć do portfolio</a>
  </header>

  <main id="main" tabindex="-1" class="bz">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__sparks" aria-hidden="true">
        {sparkles.map(spark => (
          <svg
            viewBox="0 0 40 40"
            width={spark.r * 2}
            height={spark.r * 2}
            style={`left:${spark.x}%;top:${spark.y}%`}>
            <path d={starPath(20, 20, 19, 0.16)} fill="#fff" stroke="#111217" stroke-width="1.2" />
          </svg>
        ))}
      </div>
      <ul class="hero__tags">
        <li>{content.kicker}</li>
        <li>{manifest.app.style}</li>
      </ul>
      <h1 id="hero-title" class="hero__title">
        <span class="sr-only">Bis</span>
        <Chrome
          text="Bis"
          id="hero"
          size={300}
          width={620}
          advance={1.43}
          sparks={[[-0.12, -0.2, 0.08]]}
        />
      </h1>
      <p class="hero__lead">{content.lead}</p>
      <ul class="stickers" aria-label="Fakty o projekcie">
        {content.stickers.map(([value, label], i) => (
          <li style={`--r:${tilt(i)}deg`}>
            <b>{value}</b>
            <span>{label}</span>
          </li>
        ))}
      </ul>
    </section>

    <div class="stage">
      <p class="stage__cap">
        <b>App Store</b>
        <span>iPhone 6,9″, wersja polska, przewiń w bok</span>
      </p>
      <StoreStrip
        shots={sets.pl.appstore}
        label="Zestaw sześciu screenshotów do App Store, wersja polska"
        eager
      />
    </div>

    <nav aria-label="Spis treści" class="setnav">
      <ol>
        {sections.map(([id, label], i) => (
          <li>
            <a href={`#${id}`}>
              <span class="setnav__n">{i + 1}</span>
              {label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <section id="zadanie" class="panel" aria-labelledby="zadanie-title">
      <p class="cap">
        <span>1</span>
        {content.client.caption}
      </p>
      <h2 id="zadanie-title">{content.client.title}</h2>
      <div class="split">
        <div>
          {content.client.paragraphs.map(text => (
            <p class="body">{text}</p>
          ))}
        </div>
        <dl class="brief">
          {content.client.brief.map(([term, text]) => (
            <div>
              <dt>{term}</dt>
              <dd>{text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="kierunek" class="panel" aria-labelledby="kierunek-title">
      <p class="cap">
        <span>2</span>
        {content.direction.caption}
      </p>
      <h2 id="kierunek-title">{content.direction.title}</h2>
      <div class="cols">
        {content.direction.paragraphs.map(text => (
          <p class="body">{text}</p>
        ))}
      </div>
      <ul class="tools" aria-label="Elementy stylu">
        {content.direction.tools.map(([name, what], i) => (
          <li style={`--r:${tilt(i + 1) / 2}deg`}>
            <span class="tools__name">{name}</span>
            <span class="tools__what">{what}</span>
          </li>
        ))}
      </ul>
      <div class="kit">
        <ul class="swatches" aria-label="Paleta">
          {palette.map(color => (
            <li style={`--c:${color.hex}`}>
              <span class="swatches__chip"></span>
              <span class="swatches__name">{color.name}</span>
              <span class="swatches__hex">{color.hex}</span>
            </li>
          ))}
        </ul>
        <div class="type">
          <p class="sr-only">Zażółć, przykład chromowanego słowa w kroju Modak</p>
          <Chrome text="Zażółć" id="type" size={110} width={420} advance={3.09} />
          <p class="type__sans">Gęślą jaźń · sob 17 paź, 21:00</p>
          <p class="type__meta">{content.direction.type}</p>
        </div>
      </div>
      <ul class="chips" aria-label="Słowa kluczowe kierunku">
        {content.direction.keywords.map(word => (
          <li>{word}</li>
        ))}
      </ul>
      <div class="roster">
        <h3>{content.names.title}</h3>
        <p>{content.names.text}</p>
        <ul aria-label="Zmyśleni wykonawcy i kluby">
          {artists.map(name => (
            <li>{name}</li>
          ))}
          {venues.map(name => (
            <li class="venue">{name}</li>
          ))}
        </ul>
      </div>
    </section>

    <section id="setlista" class="panel" aria-labelledby="setlista-title">
      <p class="cap">
        <span>3</span>
        {content.sequence.caption}
      </p>
      <h2 id="setlista-title">{content.sequence.title}</h2>
      <p class="body body--wide">{content.sequence.intro}</p>
      <ol class="tracks">
        {sets.pl.appstore.map((shot, i) => (
          <li class:list={['track', { 'track--first': i < 3 }]}>
            <img
              class="track__img"
              src={shot.src}
              alt=""
              width={shot.width}
              height={shot.height}
              loading="lazy"
              decoding="async"
            />
            <div>
              <span class="track__n" aria-hidden="true">
                {i + 1}
              </span>
              <p class="track__head">
                <span class="sr-only">Kadr {i + 1}: </span>
                {keepLast(glue(shot.headline))}
              </p>
              {i < 3 ? <p class="track__flag">w wynikach wyszukiwania</p> : null}
            </div>
            <p class="track__role">{content.sequence.roles[i]}</p>
          </li>
        ))}
      </ol>
      <p class="quiet">{content.sequence.firstThree}</p>
    </section>

    <section id="miniatury" class="panel" aria-labelledby="miniatury-title">
      <p class="cap">
        <span>4</span>
        {content.search.caption}
      </p>
      <h2 id="miniatury-title">{content.search.title}</h2>
      <p class="body body--wide">{content.search.text}</p>
      <div class="searches">
        <SearchMock
          name="Bis"
          subtitle={content.search.subtitle}
          icon={icon}
          query={content.search.query}
          shots={sets.pl.appstore}
          store="Makieta wyników w sklepie z aplikacjami na iPhone'a"
          class="search--ios"
        />
        <SearchMock
          name="Bis"
          subtitle={content.search.subtitle}
          icon={icon}
          query={content.search.query}
          shots={sets.pl.play}
          store="Makieta wyników w sklepie z aplikacjami na Androida"
          class="search--android"
        />
      </div>
    </section>

    <section id="zestaw" class="switch-wrap" aria-labelledby="zestaw-title">
      <p class="cap">
        <span>5</span>Przełącz i porównaj
      </p>
      <h2 id="zestaw-title">Polski i angielski, oba sklepy</h2>
      <p class="body body--wide">{content.switchNote}</p>
      <LangSwitch
        client:load
        sets={sets}
        storeLabels={{ appstore: 'App Store', play: 'Google Play' }}
        langLabels={{ pl: 'Polski', en: 'English' }}
      />
    </section>

    <section id="test" class="panel" aria-labelledby="test-title">
      <p class="cap">
        <span>6</span>
        {content.ab.caption}
      </p>
      <h2 id="test-title">{content.ab.title}</h2>
      <p class="body body--wide">{content.ab.intro}</p>
      <div class="abs">
        <AbPair a={variantA} b={variantB} hypothesis={content.ab.hypothesis} />
        <div class="ab" aria-label="Wariant A i B w Google Play">
          <figure class="ab__item">
            <img
              src={variantPlayA.src}
              alt={variantPlayA.alt}
              width={variantPlayA.width}
              height={variantPlayA.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span class="ab__tag">A</span>Google Play
            </figcaption>
          </figure>
          <figure class="ab__item">
            <img
              src={variantPlayB.src}
              alt={variantPlayB.alt}
              width={variantPlayB.width}
              height={variantPlayB.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span class="ab__tag">B</span>Google Play
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="grafiki" class="panel" aria-labelledby="grafiki-title">
      <p class="cap">
        <span>7</span>
        {content.feature.caption}
      </p>
      <h2 id="grafiki-title">{content.feature.title}</h2>
      <div class="features">
        {features.map((feature, i) => (
          <figure class="feature">
            <img
              src={feature.src}
              alt={feature.alt}
              width={feature.width}
              height={feature.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{i === 0 ? 'Wersja polska' : 'Wersja angielska'}, 1024×500 px</figcaption>
          </figure>
        ))}
      </div>
      <p class="body body--wide">{content.feature.text}</p>
      <div class="icons">
        <figure class="icon">
          <img
            class="icon__img"
            src={icon}
            alt="Ikona Bis jako pełny kwadrat, tak jak trafia do sklepu"
            width="256"
            height="256"
            loading="lazy"
          />
          <figcaption>plik źródłowy</figcaption>
        </figure>
        <figure class="icon">
          <img
            class="icon__img icon__img--ios"
            src={icon}
            alt="Ikona Bis z zaokrągleniem, jakie nakłada iPhone"
            width="256"
            height="256"
            loading="lazy"
          />
          <figcaption>maska iPhone'a</figcaption>
        </figure>
        <figure class="icon">
          <img
            class="icon__img icon__img--play"
            src={icon}
            alt="Ikona Bis z zaokrągleniem, jakie nakłada Google Play"
            width="256"
            height="256"
            loading="lazy"
          />
          <figcaption>maska Google Play</figcaption>
        </figure>
      </div>
      <p class="body body--wide">{content.feature.icons}</p>
    </section>

    <section id="pliki" class="panel" aria-labelledby="pliki-title">
      <p class="cap">
        <span>8</span>
        {content.deliverables.caption}
      </p>
      <h2 id="pliki-title">{content.deliverables.title}</h2>
      <div class="deliver">
        <div>
          <p class="body">{content.deliverables.intro}</p>
          <p class="note">{content.deliverables.specs}</p>
        </div>
        <Downloads manifest={manifest} />
      </div>
    </section>

    <section id="jezyki" class="panel" aria-labelledby="jezyki-title">
      <p class="cap">
        <span>9</span>
        {content.language.caption}
      </p>
      <h2 id="jezyki-title">{content.language.title}</h2>
      <p class="body body--wide">{content.language.text}</p>
      <LangFiles
        files={[
          { name: 'copy/pl.json', copy: copies.pl },
          { name: 'copy/en.json', copy: copies.en },
        ]}
      />
    </section>

    <section class="cta" aria-labelledby="cta-title">
      <h2 id="cta-title">{content.cta.title}</h2>
      <p class="body">{content.cta.text}</p>
      <a class="cta__link" href={portfolio('/dla-klienta/#wzornik')}>
        {content.cta.link}
      </a>
    </section>
  </main>

  <footer class="foot">
    <SampleLine name="Bis" />
  </footer>
</Shell>
