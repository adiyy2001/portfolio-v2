---
import { asoApp } from '../apps';
import { readManifest, shotsOf } from '../shared/manifest';
import type { AsoCopy } from '../shared/types';
import pl from './copy/pl.json';

interface Props {
  href: string;
}

const { href } = Astro.props;
const meta = asoApp('szyld');
const shots = shotsOf(readManifest('szyld'), pl as AsoCopy, 'appstore').slice(0, 3);
---

<a class="szyld-tile" href={href}>
  <span class="szyld-tile__shots">
    {shots.map(shot => (
      <img
        src={shot.src}
        alt=""
        width={shot.width}
        height={shot.height}
        loading="lazy"
        decoding="async"
      />
    ))}
  </span>
  <span class="szyld-tile__style">{meta.style}</span>
  <span class="szyld-tile__name">{meta.name}</span>
  <span class="szyld-tile__trade">{meta.category}</span>
  <span class="szyld-tile__go">Zobacz zestaw</span>
</a>

<style is:global>
  .szyld-tile {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 16px 22px;
    border-radius: 22px;
    background: linear-gradient(165deg, #0b4a3d 0%, #0b4a3d 62%, #2f7a47 100%);
    color: #f7f4ea;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .szyld-tile:hover,
  .szyld-tile:focus-visible {
    transform: translateY(-3px) rotate(-0.6deg);
  }

  .szyld-tile__shots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    margin-bottom: 12px;
  }

  .szyld-tile__shots img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .szyld-tile__shots img:nth-child(2) {
    transform: translateY(8px);
  }

  .szyld-tile__style {
    align-self: flex-start;
    margin-top: 8px;
    padding: 3px 10px;
    border-radius: 999px;
    background: #d5f25c;
    color: #0e1e1a;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .szyld-tile__name {
    font-size: 30px;
    font-weight: 800;
    line-height: 1.1;
    color: #d5f25c;
  }

  .szyld-tile__trade {
    font-size: 15px;
    color: #dce3df;
  }

  .szyld-tile__go {
    margin-top: 8px;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .szyld-tile {
      transition: none;
    }
  }
</style>
