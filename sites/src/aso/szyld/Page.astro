---
import { link, portfolio } from '../../shared/link';
import AbPair from '../shared/AbPair.astro';
import Downloads from '../shared/Downloads.astro';
import LangFiles from '../shared/LangFiles.astro';
import LangSwitch from '../shared/LangSwitch.tsx';
import SampleLine from '../shared/SampleLine.astro';
import SearchMock from '../shared/SearchMock.astro';
import Shell from '../shared/Shell.astro';
import StoreStrip from '../shared/StoreStrip.astro';
import {
  assetUrl,
  featureOf,
  fontFaceCss,
  preloadFonts,
  readManifest,
  shotsOf,
} from '../shared/manifest';
import type { AsoCopy } from '../shared/types';
import { glue } from '../shared/typography';
import { app } from './app';
import { content } from './content';
import en from './copy/en.json';
import pl from './copy/pl.json';
import { css } from './styles';
import { slotNumber } from './view';

const manifest = readManifest('szyld');
const copies = { pl: pl as AsoCopy, en: en as AsoCopy };
const sets = {
  pl: {
    appstore: shotsOf(manifest, copies.pl, 'appstore'),
    play: shotsOf(manifest, copies.pl, 'play'),
  },
  en: {
    appstore: shotsOf(manifest, copies.en, 'appstore'),
    play: shotsOf(manifest, copies.en, 'play'),
  },
};
const variantA = sets.pl.appstore[0];
const variantB = shotsOf(manifest, copies.pl, 'appstore', { variant: 'b' })[0];
const variantPlayA = sets.pl.play[0];
const variantPlayB = shotsOf(manifest, copies.pl, 'play', { variant: 'b' })[0];
const features = [featureOf(manifest, copies.pl), featureOf(manifest, copies.en)];
const icon = assetUrl('szyld', 'icons/icon-256.png');
const palette = manifest.palette;
const navigation = [
  ['zadanie', 'Zadanie'],
  ['kierunek', 'Kierunek'],
  ['sekwencja', 'Sekwencja'],
  ['zestaw', 'PL i EN'],
  ['test', 'Test A/B'],
  ['pliki', 'Pliki'],
];
---

<Shell
  app={app}
  title={content.title}
  description={content.description}
  css={fontFaceCss(manifest) + css}
  preload={preloadFonts(manifest, [900])}
  bodyClass="szyld">
  <header class="top">
    <a href={link('/aso/')}>Wzornik, screenshoty</a>
    <a href={portfolio('/dla-klienta/#wzornik')}>Wróć do portfolio</a>
  </header>

  <main id="main" tabindex="-1">
    <section class="hero grain" aria-labelledby="hero-title">
      <div class="wrap hero__grid">
        <div class="hero__text">
          <p class="pill pill--lime">
            <span>{content.kicker}</span>
            <span class="pill__sep" aria-hidden="true">
              /
            </span>
            <span>{manifest.app.style}</span>
          </p>
          <h1 id="hero-title">Szyld</h1>
          <p class="hero__lead">{content.lead}</p>
        </div>
        <nav class="hero__nav" aria-label="Sekcje">
          {navigation.map(([id, label], i) => (
            <a href={`#${id}`}>
              <span class="hero__nav-n" aria-hidden="true">
                {slotNumber(i + 1)}
              </span>
              {label}
            </a>
          ))}
        </nav>
      </div>
      <p class="wrap hero__caption">App Store, iPhone 6,9″, wersja polska. Przewiń w bok.</p>
      <StoreStrip
        shots={sets.pl.appstore}
        label="Zestaw sześciu screenshotów do App Store, wersja polska"
        class="strip--hero"
        eager
      />
      <ul class="wrap facts">
        {content.facts.map(([term, text]) => (
          <li>
            <span class="facts__term">{term}</span>
            <span class="facts__text">{text}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="zadanie" class="section wrap" aria-labelledby="zadanie-title">
      <div class="brief">
        <div>
          <p class="tag">
            <span class="tag__n">01</span>
            <span>Klient i zadanie</span>
          </p>
          <h2 id="zadanie-title">{content.client.title}</h2>
          {content.client.paragraphs.map(text => (
            <p class="body">{text}</p>
          ))}
        </div>
        <dl class="ticket">
          {content.client.brief.map(([term, text]) => (
            <div class="ticket__row">
              <dt>{term}</dt>
              <dd>{text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="kierunek" class="section section--hot grain" aria-labelledby="kierunek-title">
      <div class="wrap">
        <p class="tag tag--ink">
          <span class="tag__n">02</span>
          <span>Kierunek</span>
        </p>
        <h2 id="kierunek-title">{content.direction.title}</h2>
        <div class="cols">
          {content.direction.paragraphs.map(text => (
            <p class="body">{text}</p>
          ))}
        </div>
        <ul class="duos" aria-label="Dwa gradienty zestawu">
          {content.direction.duotones.map(duo => (
            <li class="duo grain" style={`--from:${duo.from};--to:${duo.to}`}>
              <span class="duo__name">{duo.name}</span>
              <span class="duo__meta">
                {duo.from} w {duo.to}, {duo.frames}
              </span>
            </li>
          ))}
        </ul>
        <div class="kit">
          <ul class="swatches" aria-label="Paleta">
            {palette.map(color => (
              <li style={`--c:${color.hex}`}>
                <span class="swatches__chip"></span>
                <span class="swatches__name">{color.name}</span>
                <span class="swatches__hex">{color.hex}</span>
              </li>
            ))}
          </ul>
          <div class="type">
            <p class="type__sample">Żółty szyld</p>
            <p class="type__meta">{content.direction.type}</p>
          </div>
        </div>
        <ul class="chips" aria-label="Słowa kluczowe kierunku">
          {content.direction.keywords.map(word => (
            <li>{word}</li>
          ))}
        </ul>
      </div>
    </section>

    <section id="sekwencja" class="section wrap" aria-labelledby="sekwencja-title">
      <p class="tag">
        <span class="tag__n">03</span>
        <span>Historia sekwencji</span>
      </p>
      <h2 id="sekwencja-title">{content.sequence.title}</h2>
      <p class="body body--wide">{content.sequence.intro}</p>
      <ol class="story">
        {sets.pl.appstore.map((shot, i) => (
          <li class:list={['story__item', { 'story__item--first': i < 3 }]}>
            <span class="story__n" aria-hidden="true">
              {slotNumber(i + 1)}
            </span>
            <img
              class="story__img"
              src={shot.src}
              alt=""
              width={shot.width}
              height={shot.height}
              loading="lazy"
              decoding="async"
            />
            <div class="story__text">
              {i < 3 ? <p class="story__flag">widać w wynikach</p> : null}
              <p class="story__head">
                <span class="sr-only">Kadr {i + 1}: </span>
                {glue(shot.headline)}
              </p>
              <p class="story__role">{content.sequence.roles[i]}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="callout">{content.sequence.firstThree}</p>
    </section>

    <section id="wyszukiwanie" class="section wrap" aria-labelledby="wyszukiwanie-title">
      <p class="tag">
        <span class="tag__n">04</span>
        <span>W wynikach wyszukiwania</span>
      </p>
      <h2 id="wyszukiwanie-title">{content.search.title}</h2>
      <p class="body body--wide">{content.search.note}</p>
      <div class="searches">
        <SearchMock
          name="Szyld"
          subtitle={content.search.subtitle}
          icon={icon}
          query={content.search.query}
          shots={sets.pl.appstore}
          store="Makieta wyników w sklepie z aplikacjami na iPhone'a"
          class="search--ios"
        />
        <SearchMock
          name="Szyld"
          subtitle={content.search.subtitle}
          icon={icon}
          query={content.search.query}
          shots={sets.pl.play}
          store="Makieta wyników w sklepie z aplikacjami na Androida"
          class="search--android"
        />
      </div>
    </section>

    <section id="zestaw" class="section section--band grain" aria-labelledby="zestaw-title">
      <div class="wrap">
        <p class="tag tag--lime">
          <span class="tag__n">05</span>
          <span>Cały zestaw</span>
        </p>
        <h2 id="zestaw-title">Polski i angielski, oba sklepy</h2>
        <p class="body body--wide">{content.switchNote}</p>
      </div>
      <LangSwitch
        client:visible
        sets={sets}
        storeLabels={{ appstore: 'App Store', play: 'Google Play' }}
        langLabels={{ pl: 'Polski', en: 'English' }}
      />
    </section>

    <section id="test" class="section wrap" aria-labelledby="test-title">
      <p class="tag">
        <span class="tag__n">06</span>
        <span>Wariant A i B</span>
      </p>
      <h2 id="test-title">{content.ab.title}</h2>
      <p class="body body--wide">{content.ab.intro}</p>
      <div class="abs">
        <AbPair a={variantA} b={variantB} hypothesis={content.ab.hypothesis} class="ab--store" />
        <div class="ab ab--play" aria-label="Wariant A i B w Google Play">
          <figure class="ab__item">
            <img
              src={variantPlayA.src}
              alt={variantPlayA.alt}
              width={variantPlayA.width}
              height={variantPlayA.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span class="ab__tag">A</span>Google Play
            </figcaption>
          </figure>
          <figure class="ab__item">
            <img
              src={variantPlayB.src}
              alt={variantPlayB.alt}
              width={variantPlayB.width}
              height={variantPlayB.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span class="ab__tag">B</span>Google Play
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="grafiki" class="section wrap" aria-labelledby="grafiki-title">
      <p class="tag">
        <span class="tag__n">07</span>
        <span>Feature graphic i ikony</span>
      </p>
      <h2 id="grafiki-title">{content.feature.title}</h2>
      <div class="features">
        {features.map((feature, i) => (
          <figure class="feature">
            <img
              src={feature.src}
              alt={feature.alt}
              width={feature.width}
              height={feature.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{i === 0 ? 'Wersja polska' : 'Wersja angielska'}, 1024×500 px</figcaption>
          </figure>
        ))}
      </div>
      <p class="body body--wide">{content.feature.caption}</p>
      <div class="icons">
        <figure class="icon">
          <img
            class="icon__img"
            src={icon}
            alt="Ikona Szyld jako pełny kwadrat, tak jak trafia do sklepu"
            width="256"
            height="256"
            loading="lazy"
          />
          <figcaption>Plik źródłowy, pełny kwadrat</figcaption>
        </figure>
        <figure class="icon">
          <img
            class="icon__img icon__img--ios"
            src={icon}
            alt="Ikona Szyld z zaokrągleniem, jakie nakłada iPhone"
            width="256"
            height="256"
            loading="lazy"
          />
          <figcaption>Po masce na iPhonie</figcaption>
        </figure>
        <figure class="icon">
          <img
            class="icon__img icon__img--play"
            src={icon}
            alt="Ikona Szyld z zaokrągleniem, jakie nakłada Google Play"
            width="256"
            height="256"
            loading="lazy"
          />
          <figcaption>Po masce w Google Play</figcaption>
        </figure>
      </div>
      <p class="body body--wide">{content.feature.icons}</p>
    </section>

    <section id="pliki" class="section wrap" aria-labelledby="pliki-title">
      <div class="deliver">
        <div>
          <p class="tag">
            <span class="tag__n">08</span>
            <span>Co dostaje klient</span>
          </p>
          <h2 id="pliki-title">{content.deliverables.title}</h2>
          <p class="body">{content.deliverables.intro}</p>
          <p class="note">{content.deliverables.specs}</p>
        </div>
        <Downloads manifest={manifest} />
      </div>
    </section>

    <section id="jezyki" class="section wrap" aria-labelledby="jezyki-title">
      <p class="tag">
        <span class="tag__n">09</span>
        <span>Kolejne języki</span>
      </p>
      <h2 id="jezyki-title">{content.language.title}</h2>
      <p class="body body--wide">{content.language.text}</p>
      <LangFiles
        files={[
          { name: 'copy/pl.json', copy: copies.pl },
          { name: 'copy/en.json', copy: copies.en },
        ]}
      />
    </section>

    <section class="cta grain" aria-labelledby="cta-title">
      <div class="wrap">
        <h2 id="cta-title">{content.cta.title}</h2>
        <p class="body">{content.cta.text}</p>
        <a class="cta__link" href={portfolio('/dla-klienta/#wzornik')}>
          {content.cta.link}
        </a>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap">
      <SampleLine name="Szyld" />
    </div>
  </footer>
</Shell>
