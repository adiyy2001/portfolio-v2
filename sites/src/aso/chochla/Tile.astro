---
import { asoApp } from '../apps';
import { assetUrl, readManifest, shotsOf } from '../shared/manifest';
import type { AsoCopy } from '../shared/types';
import pl from './copy/pl.json';

interface Props {
  href: string;
}

const { href } = Astro.props;
const meta = asoApp('chochla');
const shots = shotsOf(readManifest('chochla'), pl as AsoCopy, 'appstore').slice(0, 3);
const face = `@font-face{font-family:'Bangers';src:url(${assetUrl('chochla', 'fonts/Bangers-400.woff2')}) format('woff2');font-weight:400;font-display:swap}`;
---

<style is:inline set:html={face}></style>
<a class="chochla-tile" href={href}>
  <span class="chochla-tile__shots">
    {shots.map(shot => (
      <img
        src={shot.src}
        alt=""
        width={shot.width}
        height={shot.height}
        loading="lazy"
        decoding="async"
      />
    ))}
  </span>
  <span class="chochla-tile__style">{meta.style}</span>
  <span class="chochla-tile__name">{meta.name}</span>
  <span class="chochla-tile__trade">{meta.category}</span>
  <span class="chochla-tile__go">Zobacz zestaw</span>
</a>

<style is:global>
  .chochla-tile {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 16px 20px;
    border: 4px solid #1a1714;
    background:
      radial-gradient(
          circle at center,
          rgba(26, 23, 20, 0.14) 0,
          rgba(26, 23, 20, 0.14) 1.6px,
          transparent 2.2px
        )
        0 0 / 11px 11px,
      #fff3dd;
    color: #1a1714;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .chochla-tile:hover {
    transform: rotate(-0.6deg);
  }

  .chochla-tile:focus-visible {
    outline: 4px solid #2547c8;
    outline-offset: 3px;
  }

  .chochla-tile__shots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-bottom: 10px;
  }

  .chochla-tile__shots img {
    display: block;
    width: 100%;
    height: auto;
    border: 3px solid #1a1714;
    border-radius: 8px;
  }

  .chochla-tile__style {
    align-self: flex-start;
    padding: 2px 10px;
    border: 3px solid #1a1714;
    background: #f6b400;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .chochla-tile__name {
    padding-top: 0.1em;
    font-family: 'Bangers', cursive;
    font-size: 46px;
    line-height: 1.1;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #ee4b2b;
  }

  .chochla-tile__trade {
    font-size: 15px;
  }

  .chochla-tile__go {
    margin-top: 6px;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: #ee4b2b;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
  }
</style>
