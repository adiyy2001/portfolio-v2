---
import { link, portfolio } from '../../shared/link';
import AbPair from '../shared/AbPair.astro';
import Downloads from '../shared/Downloads.astro';
import LangFiles from '../shared/LangFiles.astro';
import LangSwitch from '../shared/LangSwitch.tsx';
import SampleLine from '../shared/SampleLine.astro';
import SearchMock from '../shared/SearchMock.astro';
import Shell from '../shared/Shell.astro';
import StoreStrip from '../shared/StoreStrip.astro';
import {
  assetUrl,
  featureOf,
  fontFaceCss,
  preloadFonts,
  readManifest,
  shotsOf,
} from '../shared/manifest';
import type { AsoCopy } from '../shared/types';
import { glue } from '../shared/typography';
import { app } from './app';
import { content } from './content';
import en from './copy/en.json';
import pl from './copy/pl.json';
import { css } from './styles';
import { burstPoints, shapes } from './view';

const manifest = readManifest('chochla');
const copies = { pl: pl as AsoCopy, en: en as AsoCopy };
const sets = {
  pl: {
    appstore: shotsOf(manifest, copies.pl, 'appstore'),
    play: shotsOf(manifest, copies.pl, 'play'),
  },
  en: {
    appstore: shotsOf(manifest, copies.en, 'appstore'),
    play: shotsOf(manifest, copies.en, 'play'),
  },
};
const variantA = sets.pl.appstore[0];
const variantB = shotsOf(manifest, copies.pl, 'appstore', { variant: 'b' })[0];
const variantPlayA = sets.pl.play[0];
const variantPlayB = shotsOf(manifest, copies.pl, 'play', { variant: 'b' })[0];
const features = [featureOf(manifest, copies.pl), featureOf(manifest, copies.en)];
const icon = assetUrl('chochla', 'icons/icon-256.png');
const palette = manifest.palette;
const legendMarks = [shapes.bubble, shapes.halftone, shapes.confetti, shapes.panels];
const heroBurst = burstPoints(20, 50, 44, 4);
const numberFills = ['#F6B400', '#F7A8C9', '#19B3A3', '#FFFFFF', '#FFFFFF', '#FFFFFF'];
const sections = [
  ['zadanie', 'Zadanie'],
  ['kierunek', 'Kierunek'],
  ['sekwencja', 'Sekwencja'],
  ['wyszukiwanie', 'Miniatury'],
  ['zestaw', 'PL i EN'],
  ['test', 'Test A/B'],
  ['grafiki', 'Grafiki'],
  ['pliki', 'Pliki'],
];
---

<Shell
  app={app}
  title={content.title}
  description={content.description}
  css={fontFaceCss(manifest) + css}
  preload={preloadFonts(manifest, [400])}
  bodyClass="chochla">
  <header class="top">
    <a href={link('/aso/')}>Wzornik, screenshoty</a>
    <a href={portfolio('/dla-klienta/#wzornik')}>Wróć do portfolio</a>
  </header>

  <main id="main" tabindex="-1" class="cc">
    <section class="hero" aria-labelledby="hero-title">
      <div>
        <p class="hero__tags">
          <span class="hero__style">{content.kicker}</span>
          <span class="hero__style hero__style--sun">{manifest.app.style}</span>
        </p>
        <h1 id="hero-title" class="hero__title">
          <svg
            class="hero__burst"
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            aria-hidden="true">
            <polygon
              points={heroBurst}
              fill="#EE4B2B"
              stroke="#1A1714"
              stroke-width="1.2"
              stroke-linejoin="miter"></polygon>
          </svg>
          <span class="hero__name">Chochla</span>
        </h1>
        <p class="say">{content.lead}</p>
      </div>
      <dl class="facts">
        {content.facts.map(([term, text]) => (
          <div>
            <dt>{term}</dt>
            <dd>{text}</dd>
          </div>
        ))}
      </dl>
    </section>

    <div class="band">
      <p class="band__cap">
        <span>App Store, iPhone 6,9″</span>
        <span>wersja polska, przewiń w bok</span>
      </p>
      <StoreStrip
        shots={sets.pl.appstore}
        label="Zestaw sześciu screenshotów do App Store, wersja polska"
        eager
      />
    </div>

    <nav aria-label="Spis treści">
      <ol class="toc">
        {sections.map(([id, label], i) => (
          <li>
            <a href={`#${id}`}>
              <b>{i + 1}</b>
              {label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <section id="zadanie" class="panel" aria-labelledby="zadanie-title">
      <p class="cap">{content.client.caption}</p>
      <h2 id="zadanie-title">{content.client.title}</h2>
      <div class="split">
        <div>
          {content.client.paragraphs.map(text => (
            <p class="body">{text}</p>
          ))}
        </div>
        <dl class="brief">
          {content.client.brief.map(([term, text]) => (
            <div>
              <dt>{term}</dt>
              <dd>{text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="kierunek" class="panel panel--dots" aria-labelledby="kierunek-title">
      <p class="cap">{content.direction.caption}</p>
      <h2 id="kierunek-title">{content.direction.title}</h2>
      <div class="cols">
        {content.direction.paragraphs.map(text => (
          <p class="body">{text}</p>
        ))}
      </div>
      <ul class="legend" aria-label="Elementy stylu">
        {content.direction.tools.map(([name, what], i) => (
          <li>
            <span class="legend__mark" set:html={legendMarks[i]} />
            <span class="legend__name">{name}</span>
            <span class="legend__what">{what}</span>
          </li>
        ))}
      </ul>
      <div class="kit">
        <ul class="swatches" aria-label="Paleta">
          {palette.map(color => (
            <li style={`--c:${color.hex}`}>
              <span class="swatches__chip"></span>
              <span class="swatches__name">{color.name}</span>
              <span class="swatches__hex">{color.hex}</span>
            </li>
          ))}
        </ul>
        <div class="type">
          <p class="type__bang">Zażółć gęślą jaźń</p>
          <p class="type__sans">Zażółć gęślą jaźń</p>
          <p class="type__meta">{content.direction.type}</p>
        </div>
      </div>
      <ul class="chips" aria-label="Słowa kluczowe kierunku">
        {content.direction.keywords.map(word => (
          <li>{word}</li>
        ))}
      </ul>
    </section>

    <section id="sekwencja" class="panel panel--sun" aria-labelledby="sekwencja-title">
      <p class="cap">{content.sequence.caption}</p>
      <h2 id="sekwencja-title">{content.sequence.title}</h2>
      <p class="body body--wide">{content.sequence.intro}</p>
      <ol class="comic">
        {sets.pl.appstore.map((shot, i) => (
          <li class:list={['comic__item', { 'comic__item--first': i < 3 }]}>
            <span class="comic__n" aria-hidden="true">
              <svg viewBox="0 0 100 100">
                <polygon
                  points={burstPoints(12, 48, 34, 20 + i)}
                  fill={numberFills[i]}
                  stroke="#1A1714"
                  stroke-width="5"
                  stroke-linejoin="miter"></polygon>
              </svg>
              <span>{i + 1}</span>
            </span>
            <img
              class="comic__img"
              src={shot.src}
              alt=""
              width={shot.width}
              height={shot.height}
              loading="lazy"
              decoding="async"
            />
            <div>
              <p class="comic__head">
                <span class="sr-only">Kadr {i + 1}: </span>
                {glue(shot.headline)}
              </p>
              {i < 3 ? <p class="comic__flag">widać w wynikach wyszukiwania</p> : null}
              <p class="comic__role">{content.sequence.roles[i]}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="shout">{content.sequence.firstThree}</p>
    </section>

    <section id="wyszukiwanie" class="panel" aria-labelledby="wyszukiwanie-title">
      <p class="cap">{content.search.caption}</p>
      <h2 id="wyszukiwanie-title">{content.search.title}</h2>
      <p class="body body--wide">{content.search.text}</p>
      <div class="searches">
        <SearchMock
          name="Chochla"
          subtitle={content.search.subtitle}
          icon={icon}
          query={content.search.query}
          shots={sets.pl.appstore}
          store="Makieta wyników w sklepie z aplikacjami na iPhone'a"
          class="search--ios"
        />
        <SearchMock
          name="Chochla"
          subtitle={content.search.subtitle}
          icon={icon}
          query={content.search.query}
          shots={sets.pl.play}
          store="Makieta wyników w sklepie z aplikacjami na Androida"
          class="search--android"
        />
      </div>
    </section>

    <section id="zestaw" class="switch-wrap" aria-labelledby="zestaw-title">
      <div class="panel panel--pink">
        <p class="cap">Rozdział 5: przełącz i porównaj</p>
        <h2 id="zestaw-title">Polski i angielski, oba sklepy</h2>
        <p class="body body--wide">{content.switchNote}</p>
      </div>
      <LangSwitch
        client:visible
        sets={sets}
        storeLabels={{ appstore: 'App Store', play: 'Google Play' }}
        langLabels={{ pl: 'Polski', en: 'English' }}
      />
    </section>

    <section id="test" class="panel" aria-labelledby="test-title">
      <p class="cap">{content.ab.caption}</p>
      <h2 id="test-title">{content.ab.title}</h2>
      <p class="body body--wide">{content.ab.intro}</p>
      <div class="abs">
        <AbPair a={variantA} b={variantB} hypothesis={content.ab.hypothesis} />
        <div class="ab" aria-label="Wariant A i B w Google Play">
          <figure class="ab__item">
            <img
              src={variantPlayA.src}
              alt={variantPlayA.alt}
              width={variantPlayA.width}
              height={variantPlayA.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span class="ab__tag">A</span>Google Play
            </figcaption>
          </figure>
          <figure class="ab__item">
            <img
              src={variantPlayB.src}
              alt={variantPlayB.alt}
              width={variantPlayB.width}
              height={variantPlayB.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span class="ab__tag">B</span>Google Play
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="grafiki" class="panel panel--dots" aria-labelledby="grafiki-title">
      <p class="cap">{content.feature.caption}</p>
      <h2 id="grafiki-title">{content.feature.title}</h2>
      <div class="features">
        {features.map((feature, i) => (
          <figure class="feature">
            <img
              src={feature.src}
              alt={feature.alt}
              width={feature.width}
              height={feature.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{i === 0 ? 'Wersja polska' : 'Wersja angielska'}, 1024×500 px</figcaption>
          </figure>
        ))}
      </div>
      <p class="body body--wide">{content.feature.text}</p>
      <div class="icons">
        <figure class="icon">
          <img
            class="icon__img"
            src={icon}
            alt="Ikona Chochla jako pełny kwadrat, tak jak trafia do sklepu"
            width="256"
            height="256"
            loading="lazy"
          />
          <figcaption>plik źródłowy</figcaption>
        </figure>
        <figure class="icon">
          <img
            class="icon__img icon__img--ios"
            src={icon}
            alt="Ikona Chochla z zaokrągleniem, jakie nakłada iPhone"
            width="256"
            height="256"
            loading="lazy"
          />
          <figcaption>maska iPhone'a</figcaption>
        </figure>
        <figure class="icon">
          <img
            class="icon__img icon__img--play"
            src={icon}
            alt="Ikona Chochla z zaokrągleniem, jakie nakłada Google Play"
            width="256"
            height="256"
            loading="lazy"
          />
          <figcaption>maska Google Play</figcaption>
        </figure>
      </div>
      <p class="body body--wide">{content.feature.icons}</p>
    </section>

    <section id="pliki" class="panel" aria-labelledby="pliki-title">
      <p class="cap">{content.deliverables.caption}</p>
      <h2 id="pliki-title">{content.deliverables.title}</h2>
      <div class="deliver">
        <div>
          <p class="body">{content.deliverables.intro}</p>
          <p class="note">{content.deliverables.specs}</p>
        </div>
        <Downloads manifest={manifest} />
      </div>
    </section>

    <section id="jezyki" class="panel panel--sun" aria-labelledby="jezyki-title">
      <p class="cap">{content.language.caption}</p>
      <h2 id="jezyki-title">{content.language.title}</h2>
      <p class="body body--wide">{content.language.text}</p>
      <LangFiles
        files={[
          { name: 'copy/pl.json', copy: copies.pl },
          { name: 'copy/en.json', copy: copies.en },
        ]}
      />
    </section>

    <section class="cta" aria-labelledby="cta-title">
      <div class="cta__inner">
        <h2 id="cta-title">{content.cta.title}</h2>
        <p class="body">{content.cta.text}</p>
        <a class="cta__link" href={portfolio('/dla-klienta/#wzornik')}>
          {content.cta.link}
        </a>
      </div>
    </section>
  </main>

  <footer class="foot">
    <SampleLine name="Chochla" />
  </footer>
</Shell>
