---
import { asoApp } from '../apps';
import { assetUrl, readManifest, shotsOf } from '../shared/manifest';
import type { AsoCopy } from '../shared/types';
import pl from './copy/pl.json';
import { tileLine } from './view';

interface Props {
  href: string;
}

const { href } = Astro.props;
const meta = asoApp('kruszec');
const shots = shotsOf(readManifest('kruszec'), pl as AsoCopy, 'appstore').slice(0, 3);
const line = tileLine();
const face = `@font-face{font-family:'Instrument Serif';src:url(${assetUrl('kruszec', 'fonts/InstrumentSerif-400.woff2')}) format('woff2');font-weight:400;font-display:swap}`;
---

<style is:inline set:html={face}></style>
<a class="kruszec-tile" href={href}>
  <span class="kruszec-tile__shots">
    {shots.map(shot => (
      <img
        src={shot.src}
        alt=""
        width={shot.width}
        height={shot.height}
        loading="lazy"
        decoding="async"
      />
    ))}
  </span>
  <svg
    class="kruszec-tile__line"
    viewBox="0 0 400 80"
    preserveAspectRatio="none"
    aria-hidden="true">
    <path
      d={line.line}
      fill="none"
      stroke="#8FD4B6"
      stroke-width="2"
      vector-effect="non-scaling-stroke"></path>
  </svg>
  <span class="kruszec-tile__style">{meta.style}</span>
  <span class="kruszec-tile__name">{meta.name}</span>
  <span class="kruszec-tile__trade">{meta.category}</span>
  <span class="kruszec-tile__go">Zobacz zestaw</span>
</a>

<style is:global>
  .kruszec-tile {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px 22px;
    border-radius: 24px;
    background:
      radial-gradient(420px 220px at 80% 0, rgba(143, 212, 182, 0.14), transparent 70%),
      linear-gradient(180deg, #111a2e, #0a1020);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 30px 60px -40px rgba(10, 16, 32, 0.9);
    color: #edf1f7;
    text-decoration: none;
    transition: box-shadow 0.2s ease;
  }

  .kruszec-tile:hover {
    box-shadow:
      inset 0 0 0 1px rgba(143, 212, 182, 0.5),
      0 30px 60px -40px rgba(10, 16, 32, 0.9);
  }

  .kruszec-tile:focus-visible {
    outline: 3px solid #8fd4b6;
    outline-offset: 3px;
  }

  .kruszec-tile__shots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .kruszec-tile__shots img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12);
  }

  .kruszec-tile__line {
    display: block;
    width: 100%;
    height: 40px;
    margin: 8px 0 4px;
  }

  .kruszec-tile__style {
    align-self: flex-start;
    padding: 3px 11px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    color: #9aa7bb;
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .kruszec-tile__name {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: 48px;
    line-height: 1.05;
    color: #dce1e8;
  }

  .kruszec-tile__trade {
    color: #9aa7bb;
    font-size: 15px;
  }

  .kruszec-tile__go {
    margin-top: 6px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: #8fd4b6;
    text-underline-offset: 4px;
  }
</style>
