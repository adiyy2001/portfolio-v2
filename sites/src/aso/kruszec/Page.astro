---
import { link, portfolio } from '../../shared/link';
import AbPair from '../shared/AbPair.astro';
import Downloads from '../shared/Downloads.astro';
import LangFiles from '../shared/LangFiles.astro';
import LangSwitch from '../shared/LangSwitch.tsx';
import SampleLine from '../shared/SampleLine.astro';
import SearchMock from '../shared/SearchMock.astro';
import Shell from '../shared/Shell.astro';
import StoreStrip from '../shared/StoreStrip.astro';
import {
  assetUrl,
  featureOf,
  fontFaceCss,
  preloadFonts,
  readManifest,
  shotsOf,
} from '../shared/manifest';
import type { AsoCopy } from '../shared/types';
import { glue } from '../shared/typography';
import { app } from './app';
import { content } from './content';
import en from './copy/en.json';
import pl from './copy/pl.json';
import { css } from './styles';
import { heroLine } from './view';

const manifest = readManifest('kruszec');
const copies = { pl: pl as AsoCopy, en: en as AsoCopy };
const sets = {
  pl: {
    appstore: shotsOf(manifest, copies.pl, 'appstore'),
    play: shotsOf(manifest, copies.pl, 'play'),
  },
  en: {
    appstore: shotsOf(manifest, copies.en, 'appstore'),
    play: shotsOf(manifest, copies.en, 'play'),
  },
};
const ipad = {
  pl: shotsOf(manifest, copies.pl, 'ipad'),
  en: shotsOf(manifest, copies.en, 'ipad'),
};
const variantA = sets.pl.appstore[0];
const variantB = shotsOf(manifest, copies.pl, 'appstore', { variant: 'b' })[0];
const variantPlayA = sets.pl.play[0];
const variantPlayB = shotsOf(manifest, copies.pl, 'play', { variant: 'b' })[0];
const features = [featureOf(manifest, copies.pl), featureOf(manifest, copies.en)];
const icon = assetUrl('kruszec', 'icons/icon-256.png');
const palette = manifest.palette;
const hero = heroLine();
const accents = pl.slots.map(slot => slot.accent);
const marked = (headline: string, accent: string) => {
  const text = glue(headline);
  const mark = glue(accent);
  const at = text.indexOf(mark);
  return at < 0
    ? { before: text, accent: '', after: '' }
    : { before: text.slice(0, at), accent: mark, after: text.slice(at + mark.length) };
};
const sections = [
  ['zadanie', 'Zadanie'],
  ['kierunek', 'Kierunek'],
  ['sekwencja', 'Sekwencja'],
  ['wyszukiwanie', 'Miniatury'],
  ['zestaw', 'PL i EN'],
  ['ipad', 'iPad'],
  ['test', 'Test A/B'],
  ['grafiki', 'Grafiki'],
  ['pliki', 'Pliki'],
];
---

<Shell
  app={app}
  title={content.title}
  description={content.description}
  css={fontFaceCss(manifest) + css}
  preload={preloadFonts(manifest, [400])}
  bodyClass="kruszec">
  <header class="top">
    <a href={link('/aso/')}>Wzornik, screenshoty</a>
    <a href={portfolio('/dla-klienta/#wzornik')}>Wróć do portfolio</a>
  </header>

  <main id="main" tabindex="-1" class="kz">
    <section class="hero" aria-labelledby="hero-title">
      <svg class="hero__line" viewBox="0 0 1200 360" preserveAspectRatio="none" aria-hidden="true">
        <defs>
          <linearGradient id="hero-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#8FD4B6" stop-opacity=".16"></stop>
            <stop offset="1" stop-color="#8FD4B6" stop-opacity="0"></stop>
          </linearGradient>
          <linearGradient id="hero-stroke" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#8FD4B6" stop-opacity=".05"></stop>
            <stop offset=".5" stop-color="#8FD4B6" stop-opacity=".7"></stop>
            <stop offset="1" stop-color="#8FD4B6"></stop>
          </linearGradient>
        </defs>
        <path d={hero.area} fill="url(#hero-fill)"></path>
        <path
          class="hero__glow"
          d={hero.line}
          fill="none"
          stroke="url(#hero-stroke)"
          stroke-width="10"
          vector-effect="non-scaling-stroke"></path>
        <path
          d={hero.line}
          fill="none"
          stroke="url(#hero-stroke)"
          stroke-width="2.5"
          vector-effect="non-scaling-stroke"></path>
      </svg>
      <div class="hero__copy">
        <p class="hero__tags">
          <span>{content.kicker}</span>
          <span>{manifest.app.style}</span>
        </p>
        <h1 id="hero-title" class="hero__title">
          Kruszec
        </h1>
        <p class="hero__lead">{content.lead}</p>
      </div>
      <dl class="statement">
        {content.facts.map(([term, text]) => (
          <div>
            <dt>{term}</dt>
            <dd>{text}</dd>
          </div>
        ))}
      </dl>
    </section>

    <div class="band">
      <p class="band__cap">
        <span>App Store, iPhone 6,9″</span>
        <span>wersja polska, przewiń w bok</span>
      </p>
      <StoreStrip
        shots={sets.pl.appstore}
        label="Zestaw sześciu screenshotów do App Store, wersja polska"
        eager
      />
    </div>

    <nav aria-label="Spis treści" class="seg">
      <ol>
        {sections.map(([id, label], i) => (
          <li>
            <a href={`#${id}`}>
              <span class="seg__n">{String(i + 1).padStart(2, '0')}</span>
              {label}
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <section id="zadanie" class="glass" aria-labelledby="zadanie-title">
      <p class="cap">
        <span>01</span>
        {content.client.caption}
      </p>
      <h2 id="zadanie-title">{content.client.title}</h2>
      <div class="split">
        <div>
          {content.client.paragraphs.map(text => (
            <p class="body">{text}</p>
          ))}
        </div>
        <dl class="brief">
          {content.client.brief.map(([term, text]) => (
            <div>
              <dt>{term}</dt>
              <dd>{text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="kierunek" class="glass" aria-labelledby="kierunek-title">
      <p class="cap">
        <span>02</span>
        {content.direction.caption}
      </p>
      <h2 id="kierunek-title">{content.direction.title}</h2>
      <div class="cols">
        {content.direction.paragraphs.map(text => (
          <p class="body">{text}</p>
        ))}
      </div>
      <ul class="tools" aria-label="Elementy stylu">
        {content.direction.tools.map(([name, what]) => (
          <li>
            <span class="tools__name">{name}</span>
            <span class="tools__what">{what}</span>
          </li>
        ))}
      </ul>
      <div class="kit">
        <ul class="swatches" aria-label="Paleta">
          {palette.map(color => (
            <li style={`--c:${color.hex}`}>
              <span class="swatches__chip"></span>
              <span class="swatches__name">{color.name}</span>
              <span class="swatches__hex">{color.hex}</span>
            </li>
          ))}
        </ul>
        <div class="type">
          <p class="type__serif">
            Zażółć <em>gęślą</em> jaźń
          </p>
          <p class="type__sans">186 420 zł · 5,2 miesiąca</p>
          <p class="type__meta">{content.direction.type}</p>
        </div>
      </div>
      <ul class="chips" aria-label="Słowa kluczowe kierunku">
        {content.direction.keywords.map(word => (
          <li>{word}</li>
        ))}
      </ul>
    </section>

    <section id="sekwencja" class="glass" aria-labelledby="sekwencja-title">
      <p class="cap">
        <span>03</span>
        {content.sequence.caption}
      </p>
      <h2 id="sekwencja-title">{content.sequence.title}</h2>
      <p class="body body--wide">{content.sequence.intro}</p>
      <ol class="ledger">
        {sets.pl.appstore.map((shot, i) => {
          const parts = marked(shot.headline, accents[i]);
          return (
            <li class:list={['ledger__item', { 'ledger__item--first': i < 3 }]}>
              <span class="ledger__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <img
                class="ledger__img"
                src={shot.src}
                alt=""
                width={shot.width}
                height={shot.height}
                loading="lazy"
                decoding="async"
              />
              <div class="ledger__text">
                <p class="ledger__head">
                  <span class="sr-only">Kadr {i + 1}: </span>
                  {parts.before}
                  <em>{parts.accent}</em>
                  {parts.after}
                </p>
                {i < 3 ? <p class="ledger__flag">widać w wynikach wyszukiwania</p> : null}
                <p class="ledger__role">{content.sequence.roles[i]}</p>
              </div>
            </li>
          );
        })}
      </ol>
      <p class="quiet">{content.sequence.firstThree}</p>
    </section>

    <section id="wyszukiwanie" class="glass" aria-labelledby="wyszukiwanie-title">
      <p class="cap">
        <span>04</span>
        {content.search.caption}
      </p>
      <h2 id="wyszukiwanie-title">{content.search.title}</h2>
      <p class="body body--wide">{content.search.text}</p>
      <div class="searches">
        <SearchMock
          name="Kruszec"
          subtitle={content.search.subtitle}
          icon={icon}
          query={content.search.query}
          shots={sets.pl.appstore}
          store="Makieta wyników w sklepie z aplikacjami na iPhone'a"
          class="search--ios"
        />
        <SearchMock
          name="Kruszec"
          subtitle={content.search.subtitle}
          icon={icon}
          query={content.search.query}
          shots={sets.pl.play}
          store="Makieta wyników w sklepie z aplikacjami na Androida"
          class="search--android"
        />
      </div>
    </section>

    <section id="zestaw" class="switch-wrap" aria-labelledby="zestaw-title">
      <div class="switch-head">
        <p class="cap">
          <span>05</span>Przełącz i porównaj
        </p>
        <h2 id="zestaw-title">Polski i angielski, oba sklepy</h2>
        <p class="body body--wide">{content.switchNote}</p>
      </div>
      <LangSwitch
        client:visible
        sets={sets}
        storeLabels={{ appstore: 'App Store', play: 'Google Play' }}
        langLabels={{ pl: 'Polski', en: 'English' }}
      />
    </section>

    <section id="ipad" class="glass glass--wide" aria-labelledby="ipad-title">
      <p class="cap">
        <span>06</span>
        {content.ipad.caption}
      </p>
      <h2 id="ipad-title">{content.ipad.title}</h2>
      <p class="body body--wide">{content.ipad.text}</p>
      <p class="sub">{content.ipad.pl}</p>
      <StoreStrip
        shots={ipad.pl}
        label="Zestaw sześciu screenshotów na iPada, wersja polska"
        class="strip--ipad"
      />
      <p class="sub">{content.ipad.en}</p>
      <StoreStrip
        shots={ipad.en}
        label="Zestaw sześciu screenshotów na iPada, wersja angielska"
        class="strip--ipad"
      />
    </section>

    <section id="test" class="glass" aria-labelledby="test-title">
      <p class="cap">
        <span>07</span>
        {content.ab.caption}
      </p>
      <h2 id="test-title">{content.ab.title}</h2>
      <p class="body body--wide">{content.ab.intro}</p>
      <div class="abs">
        <AbPair a={variantA} b={variantB} hypothesis={content.ab.hypothesis} />
        <div class="ab" aria-label="Wariant A i B w Google Play">
          <figure class="ab__item">
            <img
              src={variantPlayA.src}
              alt={variantPlayA.alt}
              width={variantPlayA.width}
              height={variantPlayA.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span class="ab__tag">A</span>Google Play
            </figcaption>
          </figure>
          <figure class="ab__item">
            <img
              src={variantPlayB.src}
              alt={variantPlayB.alt}
              width={variantPlayB.width}
              height={variantPlayB.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span class="ab__tag">B</span>Google Play
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="grafiki" class="glass" aria-labelledby="grafiki-title">
      <p class="cap">
        <span>08</span>
        {content.feature.caption}
      </p>
      <h2 id="grafiki-title">{content.feature.title}</h2>
      <div class="features">
        {features.map((feature, i) => (
          <figure class="feature">
            <img
              src={feature.src}
              alt={feature.alt}
              width={feature.width}
              height={feature.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>{i === 0 ? 'Wersja polska' : 'Wersja angielska'}, 1024×500 px</figcaption>
          </figure>
        ))}
      </div>
      <p class="body body--wide">{content.feature.text}</p>
      <div class="icons">
        <figure class="icon">
          <img
            class="icon__img"
            src={icon}
            alt="Ikona Kruszec jako pełny kwadrat, tak jak trafia do sklepu"
            width="256"
            height="256"
            loading="lazy"
          />
          <figcaption>plik źródłowy</figcaption>
        </figure>
        <figure class="icon">
          <img
            class="icon__img icon__img--ios"
            src={icon}
            alt="Ikona Kruszec z zaokrągleniem, jakie nakłada iPhone"
            width="256"
            height="256"
            loading="lazy"
          />
          <figcaption>maska iPhone'a</figcaption>
        </figure>
        <figure class="icon">
          <img
            class="icon__img icon__img--play"
            src={icon}
            alt="Ikona Kruszec z zaokrągleniem, jakie nakłada Google Play"
            width="256"
            height="256"
            loading="lazy"
          />
          <figcaption>maska Google Play</figcaption>
        </figure>
      </div>
      <p class="body body--wide">{content.feature.icons}</p>
    </section>

    <section id="pliki" class="glass" aria-labelledby="pliki-title">
      <p class="cap">
        <span>09</span>
        {content.deliverables.caption}
      </p>
      <h2 id="pliki-title">{content.deliverables.title}</h2>
      <div class="deliver">
        <div>
          <p class="body">{content.deliverables.intro}</p>
          <p class="note">{content.deliverables.specs}</p>
        </div>
        <Downloads manifest={manifest} />
      </div>
    </section>

    <section id="jezyki" class="glass" aria-labelledby="jezyki-title">
      <p class="cap">
        <span>10</span>
        {content.language.caption}
      </p>
      <h2 id="jezyki-title">{content.language.title}</h2>
      <p class="body body--wide">{content.language.text}</p>
      <LangFiles
        files={[
          { name: 'copy/pl.json', copy: copies.pl },
          { name: 'copy/en.json', copy: copies.en },
        ]}
      />
    </section>

    <section class="cta" aria-labelledby="cta-title">
      <h2 id="cta-title">{content.cta.title}</h2>
      <p class="body">{content.cta.text}</p>
      <a class="cta__link" href={portfolio('/dla-klienta/#wzornik')}>
        {content.cta.link}
      </a>
    </section>
  </main>

  <footer class="foot">
    <SampleLine name="Kruszec" />
  </footer>
</Shell>
