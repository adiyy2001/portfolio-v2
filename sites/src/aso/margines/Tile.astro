---
import { asoApp } from '../apps';
import { assetUrl, readManifest, shotsOf } from '../shared/manifest';
import type { AsoCopy } from '../shared/types';
import pl from './copy/pl.json';

interface Props {
  href: string;
}

const { href } = Astro.props;
const meta = asoApp('margines');
const shots = shotsOf(readManifest('margines'), pl as AsoCopy, 'appstore').slice(0, 3);
const face = `@font-face{font-family:'Caveat';src:url(${assetUrl('margines', 'fonts/Caveat-700.woff2')}) format('woff2');font-weight:700;font-display:swap}`;
---

<style is:inline set:html={face}></style>
<a class="margines-tile" href={href}>
  <span class="margines-tile__shots">
    {shots.map(shot => (
      <img
        src={shot.src}
        alt=""
        width={shot.width}
        height={shot.height}
        loading="lazy"
        decoding="async"
      />
    ))}
  </span>
  <span class="margines-tile__style">{meta.style}</span>
  <span class="margines-tile__name">{meta.name}</span>
  <span class="margines-tile__trade">{meta.category}</span>
  <span class="margines-tile__go">Zobacz zestaw</span>
</a>

<style is:global>
  .margines-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 16px 20px 44px;
    border-radius: 6px;
    background-color: #fbf8f0;
    background-image:
      linear-gradient(
        to right,
        rgba(207, 224, 238, 0.8) 0,
        rgba(207, 224, 238, 0.8) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        rgba(207, 224, 238, 0.8) 0,
        rgba(207, 224, 238, 0.8) 1px,
        transparent 1px
      );
    background-size: 20px 20px;
    box-shadow:
      0 0 0 1px #e1dacb,
      0 14px 26px -22px rgba(30, 42, 94, 0.7);
    color: #1e2a5e;
    text-decoration: none;
    transition: transform 0.15s ease;
  }

  .margines-tile::before {
    content: '';
    position: absolute;
    left: 26px;
    top: 0;
    bottom: 0;
    width: 6px;
    border-left: 1.5px solid rgba(226, 67, 59, 0.6);
    border-right: 1.5px solid rgba(226, 67, 59, 0.6);
  }

  .margines-tile:hover,
  .margines-tile:focus-visible {
    transform: rotate(-0.6deg);
  }

  .margines-tile__shots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-bottom: 12px;
  }

  .margines-tile__shots img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 0 0 1px #e1dacb;
  }

  .margines-tile__shots img:nth-child(1) {
    transform: rotate(-1.5deg);
  }

  .margines-tile__shots img:nth-child(3) {
    transform: rotate(1.5deg);
  }

  .margines-tile__style {
    align-self: flex-start;
    margin-top: 6px;
    padding: 0 6px;
    background: linear-gradient(to top, #ffe45e 0, #ffe45e 55%, transparent 55%);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .margines-tile__name {
    font-family: 'Caveat', cursive;
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
  }

  .margines-tile__trade {
    font-size: 15px;
    color: #3a4466;
  }

  .margines-tile__go {
    margin-top: 8px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: #e2433b;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .margines-tile {
      transition: none;
    }
  }
</style>
