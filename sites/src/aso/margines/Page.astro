---
import { link, portfolio } from '../../shared/link';
import AbPair from '../shared/AbPair.astro';
import Downloads from '../shared/Downloads.astro';
import LangFiles from '../shared/LangFiles.astro';
import LangSwitch from '../shared/LangSwitch.tsx';
import SampleLine from '../shared/SampleLine.astro';
import SearchMock from '../shared/SearchMock.astro';
import Shell from '../shared/Shell.astro';
import StoreStrip from '../shared/StoreStrip.astro';
import {
  assetUrl,
  featureOf,
  fontFaceCss,
  preloadFonts,
  readManifest,
  shotsOf,
} from '../shared/manifest';
import type { AsoCopy } from '../shared/types';
import { glue } from '../shared/typography';
import { app } from './app';
import { content } from './content';
import en from './copy/en.json';
import pl from './copy/pl.json';
import { css } from './styles';
import { arrowPath, circlePath, slotNumber, underlinePath } from './view';

const manifest = readManifest('margines');
const copies = { pl: pl as AsoCopy, en: en as AsoCopy };
const sets = {
  pl: {
    appstore: shotsOf(manifest, copies.pl, 'appstore'),
    play: shotsOf(manifest, copies.pl, 'play'),
  },
  en: {
    appstore: shotsOf(manifest, copies.en, 'appstore'),
    play: shotsOf(manifest, copies.en, 'play'),
  },
};
const variantA = sets.pl.appstore[0];
const variantB = shotsOf(manifest, copies.pl, 'appstore', { variant: 'b' })[0];
const variantPlayA = sets.pl.play[0];
const variantPlayB = shotsOf(manifest, copies.pl, 'play', { variant: 'b' })[0];
const features = [featureOf(manifest, copies.pl), featureOf(manifest, copies.en)];
const icon = assetUrl('margines', 'icons/icon-256.png');
const palette = manifest.palette;
const arrow = arrowPath(90, 3);
const legendMarks = [
  `<svg viewBox="0 0 120 56" aria-hidden="true"><path d="${circlePath(112, 50, 4)}" transform="translate(4 3)" fill="none" stroke="#E2433B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  `<svg viewBox="0 0 120 56" aria-hidden="true"><path d="M8 20 L112 16 L110 40 L10 42 Z" fill="#FFE45E" opacity=".9"/></svg>`,
  `<svg viewBox="0 0 120 56" aria-hidden="true"><path d="${underlinePath(112, 5)}" transform="translate(4 18)" fill="none" stroke="#E2433B" stroke-width="3" stroke-linecap="round"/><path d="${underlinePath(100, 6)}" transform="translate(10 27)" fill="none" stroke="#E2433B" stroke-width="3" stroke-linecap="round"/></svg>`,
  `<svg viewBox="0 0 120 56" aria-hidden="true"><path d="M10 14 L16 10 L22 14 L28 10 L100 12 L106 10 L112 14 L110 42 L104 46 L98 42 L22 44 L16 46 L10 42 Z" fill="#B8EBD0" opacity=".9"/></svg>`,
];
const sections = [
  ['zadanie', 'klient i zadanie'],
  ['kierunek', 'kierunek'],
  ['sekwencja', 'sekwencja'],
  ['wyszukiwanie', 'miniatury'],
  ['zestaw', 'PL i EN'],
  ['test', 'test A/B'],
  ['grafiki', 'grafiki'],
  ['pliki', 'pliki'],
];
---

<Shell
  app={app}
  title={content.title}
  description={content.description}
  css={fontFaceCss(manifest) + css}
  preload={preloadFonts(manifest, [700])}
  bodyClass="margines">
  <header class="top">
    <a href={link('/aso/')}>Wzornik, screenshoty</a>
    <a href={portfolio('/dla-klienta/#wzornik')}>Wróć do portfolio</a>
  </header>

  <main id="main" tabindex="-1" class="nb">
    <section class="hero row" aria-labelledby="hero-title">
      <div class="margin">
        <p class="margin__note margin__note--red">{content.kicker}</p>
      </div>
      <div class="page hero__page">
        <div class="hero__text">
          <p class="hero__style">{manifest.app.style}</p>
          <h1 id="hero-title">
            <span class="hero__name">Margines</span>
            <svg
              class="hero__line"
              viewBox="0 0 320 16"
              preserveAspectRatio="none"
              aria-hidden="true">
              <path
                d={underlinePath(320, 2, 16)}
                fill="none"
                stroke="#E2433B"
                stroke-width="5"
                stroke-linecap="round"></path>
            </svg>
          </h1>
          <p class="hero__lead">{content.lead}</p>
        </div>
        <aside class="index hero__card" aria-label="W skrócie">
          <span class="tape tape--sun" aria-hidden="true"></span>
          <dl>
            {content.facts.map(([term, text]) => (
              <div class="index__row">
                <dt>{term}</dt>
                <dd>{text}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </section>

    <div class="hero__strip">
      <p class="strip-caption">
        <span>App Store, iPhone 6,9″, wersja polska</span>
        <span class="hand">przewiń w bok</span>
      </p>
      <StoreStrip
        shots={sets.pl.appstore}
        label="Zestaw sześciu screenshotów do App Store, wersja polska"
        class="strip--hero"
        eager
      />
    </div>

    <nav class="row toc" aria-label="Spis treści">
      <div class="margin">
        <p class="margin__note">spis treści</p>
      </div>
      <ol class="page toc__list">
        {sections.map(([id, label], i) => (
          <li>
            <a href={`#${id}`}>
              <span class="toc__n">{slotNumber(i + 1)}</span>
              <span>{label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <section id="zadanie" class="row section" aria-labelledby="zadanie-title">
      <div class="margin">
        <p class="margin__n">01</p>
        <p class="margin__note">{content.client.note}</p>
      </div>
      <div class="page">
        <h2 id="zadanie-title">{content.client.title}</h2>
        <div class="split">
          <div>
            {content.client.paragraphs.map(text => (
              <p class="body">{text}</p>
            ))}
          </div>
          <dl class="index brief">
            {content.client.brief.map(([term, text]) => (
              <div class="index__row">
                <dt>{term}</dt>
                <dd>{text}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <section id="kierunek" class="row section" aria-labelledby="kierunek-title">
      <div class="margin">
        <p class="margin__n">02</p>
        <p class="margin__note">{content.direction.note}</p>
      </div>
      <div class="page">
        <h2 id="kierunek-title">{content.direction.title}</h2>
        <div class="cols">
          {content.direction.paragraphs.map(text => (
            <p class="body">{text}</p>
          ))}
        </div>
        <h3 class="hand-title">Legenda flamastrów</h3>
        <ul class="legend">
          {content.direction.tools.map(([name, what], i) => (
            <li>
              <span class="legend__mark" set:html={legendMarks[i]} />
              <span class="legend__name">{name}</span>
              <span class="legend__what">{what}</span>
            </li>
          ))}
        </ul>
        <div class="kit">
          <ul class="swatches" aria-label="Paleta">
            {palette.map((color, i) => (
              <li style={`--c:${color.hex};--r:${i % 2 ? 1.5 : -1.5}deg`}>
                <span class="swatches__chip"></span>
                <span class="swatches__name">{color.name}</span>
                <span class="swatches__hex">{color.hex}</span>
              </li>
            ))}
          </ul>
          <div class="type index">
            <p class="type__hand">Zażółć gęślą jaźń</p>
            <p class="type__sans">Zażółć gęślą jaźń</p>
            <p class="type__meta">{content.direction.type}</p>
          </div>
        </div>
        <ul class="chips" aria-label="Słowa kluczowe kierunku">
          {content.direction.keywords.map(word => (
            <li>{word}</li>
          ))}
        </ul>
      </div>
    </section>

    <section id="sekwencja" class="row section" aria-labelledby="sekwencja-title">
      <div class="margin">
        <p class="margin__n">03</p>
        <p class="margin__note">{content.sequence.note}</p>
      </div>
      <div class="page">
        <h2 id="sekwencja-title">{content.sequence.title}</h2>
        <p class="body body--wide">{content.sequence.intro}</p>
        <ol class="lesson">
          {sets.pl.appstore.map((shot, i) => (
            <li class:list={['lesson__item', { 'lesson__item--first': i < 3 }]}>
              <span class="lesson__n" aria-hidden="true">
                <svg viewBox="0 0 64 56">
                  <path
                    d={circlePath(60, 52, 10 + i)}
                    transform="translate(2 2)"
                    fill="none"
                    stroke={i < 3 ? '#E2433B' : '#6B7080'}
                    stroke-width="2.6"
                    stroke-linecap="round"></path>
                </svg>
                <span>{i + 1}</span>
              </span>
              <img
                class="lesson__img"
                src={shot.src}
                alt=""
                width={shot.width}
                height={shot.height}
                loading="lazy"
                decoding="async"
              />
              <div class="lesson__text">
                <p class="lesson__head">
                  <span class="sr-only">Kadr {i + 1}: </span>
                  <span class="lesson__mark">{glue(shot.headline)}</span>
                </p>
                {i < 3 ? <p class="lesson__flag">widać w wynikach wyszukiwania</p> : null}
                <p class="lesson__role">{content.sequence.roles[i]}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="sticky">{content.sequence.firstThree}</p>
      </div>
    </section>

    <section id="wyszukiwanie" class="row section" aria-labelledby="wyszukiwanie-title">
      <div class="margin">
        <p class="margin__n">04</p>
        <p class="margin__note">{content.search.note}</p>
      </div>
      <div class="page">
        <h2 id="wyszukiwanie-title">{content.search.title}</h2>
        <p class="body body--wide">{content.search.text}</p>
        <div class="searches">
          <SearchMock
            name="Margines"
            subtitle={content.search.subtitle}
            icon={icon}
            query={content.search.query}
            shots={sets.pl.appstore}
            store="Makieta wyników w sklepie z aplikacjami na iPhone'a"
            class="search--ios"
          />
          <SearchMock
            name="Margines"
            subtitle={content.search.subtitle}
            icon={icon}
            query={content.search.query}
            shots={sets.pl.play}
            store="Makieta wyników w sklepie z aplikacjami na Androida"
            class="search--android"
          />
        </div>
      </div>
    </section>

    <section id="zestaw" class="section section--full" aria-labelledby="zestaw-title">
      <div class="row">
        <div class="margin">
          <p class="margin__n">05</p>
          <p class="margin__note">przełącz i porównaj</p>
        </div>
        <div class="page">
          <h2 id="zestaw-title">Polski i angielski, oba sklepy</h2>
          <p class="body body--wide">{content.switchNote}</p>
        </div>
      </div>
      <LangSwitch
        client:visible
        sets={sets}
        storeLabels={{ appstore: 'App Store', play: 'Google Play' }}
        langLabels={{ pl: 'Polski', en: 'English' }}
      />
    </section>

    <section id="test" class="row section" aria-labelledby="test-title">
      <div class="margin">
        <p class="margin__n">06</p>
        <p class="margin__note">{content.ab.note}</p>
      </div>
      <div class="page">
        <h2 id="test-title">{content.ab.title}</h2>
        <p class="body body--wide">{content.ab.intro}</p>
        <div class="abs">
          <AbPair a={variantA} b={variantB} hypothesis={content.ab.hypothesis} class="ab--store" />
          <div class="ab ab--play" aria-label="Wariant A i B w Google Play">
            <figure class="ab__item">
              <img
                src={variantPlayA.src}
                alt={variantPlayA.alt}
                width={variantPlayA.width}
                height={variantPlayA.height}
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                <span class="ab__tag">A</span>Google Play
              </figcaption>
            </figure>
            <figure class="ab__item">
              <img
                src={variantPlayB.src}
                alt={variantPlayB.alt}
                width={variantPlayB.width}
                height={variantPlayB.height}
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                <span class="ab__tag">B</span>Google Play
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section id="grafiki" class="row section" aria-labelledby="grafiki-title">
      <div class="margin">
        <p class="margin__n">07</p>
        <p class="margin__note">{content.feature.note}</p>
      </div>
      <div class="page">
        <h2 id="grafiki-title">{content.feature.title}</h2>
        <div class="features">
          {features.map((feature, i) => (
            <figure class="feature">
              <img
                src={feature.src}
                alt={feature.alt}
                width={feature.width}
                height={feature.height}
                loading="lazy"
                decoding="async"
              />
              <figcaption>{i === 0 ? 'Wersja polska' : 'Wersja angielska'}, 1024×500 px</figcaption>
            </figure>
          ))}
        </div>
        <p class="body body--wide">{content.feature.caption}</p>
        <div class="icons">
          <figure class="icon">
            <img
              class="icon__img"
              src={icon}
              alt="Ikona Margines jako pełny kwadrat, tak jak trafia do sklepu"
              width="256"
              height="256"
              loading="lazy"
            />
            <figcaption>plik źródłowy</figcaption>
          </figure>
          <figure class="icon">
            <img
              class="icon__img icon__img--ios"
              src={icon}
              alt="Ikona Margines z zaokrągleniem, jakie nakłada iPhone"
              width="256"
              height="256"
              loading="lazy"
            />
            <figcaption>maska iPhone'a</figcaption>
          </figure>
          <figure class="icon">
            <img
              class="icon__img icon__img--play"
              src={icon}
              alt="Ikona Margines z zaokrągleniem, jakie nakłada Google Play"
              width="256"
              height="256"
              loading="lazy"
            />
            <figcaption>maska Google Play</figcaption>
          </figure>
        </div>
        <p class="body body--wide">{content.feature.icons}</p>
      </div>
    </section>

    <section id="pliki" class="row section" aria-labelledby="pliki-title">
      <div class="margin">
        <p class="margin__n">08</p>
        <p class="margin__note">{content.deliverables.note}</p>
      </div>
      <div class="page">
        <h2 id="pliki-title">{content.deliverables.title}</h2>
        <div class="deliver">
          <div>
            <p class="body">{content.deliverables.intro}</p>
            <p class="note">{content.deliverables.specs}</p>
          </div>
          <Downloads manifest={manifest} class="index" />
        </div>
      </div>
    </section>

    <section id="jezyki" class="row section" aria-labelledby="jezyki-title">
      <div class="margin">
        <p class="margin__n">09</p>
        <p class="margin__note">{content.language.note}</p>
      </div>
      <div class="page">
        <h2 id="jezyki-title">{content.language.title}</h2>
        <p class="body body--wide">{content.language.text}</p>
        <LangFiles
          files={[
            { name: 'copy/pl.json', copy: copies.pl },
            { name: 'copy/en.json', copy: copies.en },
          ]}
        />
      </div>
    </section>

    <section class="row cta" aria-labelledby="cta-title">
      <div class="margin">
        <svg class="cta__arrow" viewBox="0 0 90 40" aria-hidden="true">
          <path
            d={arrow.shaft}
            fill="none"
            stroke="#E2433B"
            stroke-width="3"
            stroke-linecap="round"></path>
          <path
            d={arrow.head}
            fill="none"
            stroke="#E2433B"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </div>
      <div class="page">
        <h2 id="cta-title">{content.cta.title}</h2>
        <p class="body">{content.cta.text}</p>
        <a class="cta__link" href={portfolio('/dla-klienta/#wzornik')}>
          {content.cta.link}
        </a>
      </div>
    </section>
  </main>

  <footer class="foot">
    <SampleLine name="Margines" />
  </footer>
</Shell>
